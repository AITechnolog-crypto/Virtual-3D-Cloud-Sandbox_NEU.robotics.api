+    let base = 10_000_000_000; let dir = 1;
+    function step(){ base += dir * (Math.random()*8_000_000); if(base>10.3e9){dir=-1;} if(base<9.9e9){dir=1;} el.textContent = (base/1e9).toFixed(1)+'B'; requestAnimationFrame(step); }
+    step();
+  }
+  async function loadJavaCounts(){
+    try{ const j = await fetch(API+'/meta/java-counts').then(r=>r.json()); if(j){
+      document.getElementById('jc-ctrl').textContent = j.controllers;
+      document.getElementById('jc-svc').textContent  = j.services;
+      document.getElementById('jc-repo').textContent = j.repositories;
+      document.getElementById('jc-model').textContent= j.models;
