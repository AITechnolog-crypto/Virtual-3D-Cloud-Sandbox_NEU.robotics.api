+
+  // 2) Infrastruktur Kapazität & Auslastung (steuerbar)
+  function mountInfra(){
+    const inner = [
+      '<div class="small muted">Setze Ziel‑Kapazitäten (Mengen) und beobachte die Auslastung in Echtzeit.</div>',
