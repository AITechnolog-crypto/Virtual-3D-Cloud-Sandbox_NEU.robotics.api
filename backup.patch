+<a name="l4"><span class="ln">4    </span></a>
+<a name="l5"><span class="ln">5    </span></a><span class="s2">/**</span>
+<a name="l6"><span class="ln">6    </span></a> <span class="s2">* Schnittstelle für eine autonome Maschine mit positiver/nicht-negativer Ausrichtung.</span>
+<a name="l7"><span class="ln">7    </span></a> <span class="s2">*/</span>
+<a name="l8"><span class="ln">8    </span></a><span class="s0">public interface </span><span class="s1">IAutonomousMachine {</span>
+<a name="l9"><span class="ln">9    </span></a>    <span class="s2">/** Führt positive Aktionen aus (z. B. Hilfs- oder Schutzfunktionen). */</span>
+<a name="l10"><span class="ln">10   </span></a>    <span class="s0">void </span><span class="s1">performPositiveActions();</span>
+<a name="l11"><span class="ln">11   </span></a>
+<a name="l12"><span class="ln">12   </span></a>    <span class="s2">/** Verhindert negative Aktionen (z. B. Schadensvermeidung, Safeguards). */</span>
+<a name="l13"><span class="ln">13   </span></a>    <span class="s0">void </span><span class="s1">preventNegativeActions();</span>
+<a name="l14"><span class="ln">14   </span></a>
+<a name="l15"><span class="ln">15   </span></a>    <span class="s2">/**</span>
+<a name="l16"><span class="ln">16   </span></a>     <span class="s2">* Setzt den Aggressivitätsgrad im Bereich [0, 1].</span>
+<a name="l17"><span class="ln">17   </span></a>     <span class="s2">* 0 = defensiv/risikoarm, 1 = sehr aggressiv/risikoreich.</span>
+<a name="l18"><span class="ln">18   </span></a>     <span class="s2">*/</span>
+<a name="l19"><span class="ln">19   </span></a>    <span class="s0">void </span><span class="s1">setAggressiveness(</span><span class="s0">double </span><span class="s1">aggressiveness);</span>
+<a name="l20"><span class="ln">20   </span></a>
+<a name="l21"><span class="ln">21   </span></a>    <span class="s2">/**</span>
+<a name="l22"><span class="ln">22   </span></a>     <span class="s2">* Neue überladene Variante: Führt genau eine Aktion aus, sofern sie nicht negativ ist.</span>
+<a name="l23"><span class="ln">23   </span></a>     <span class="s2">* Default-Implementierung ruft bei nicht-negativer Aktion die Alt-API performPositiveActions() auf,</span>
+<a name="l24"><span class="ln">24   </span></a>     <span class="s2">* um Rückwärtskompatibilität zu gewährleisten.</span>
+<a name="l25"><span class="ln">25   </span></a>     <span class="s2">*/</span>
+<a name="l26"><span class="ln">26   </span></a>    <span class="s0">default void </span><span class="s1">performPositiveActions(<a href="../../../com/june/autonomy/action/IAction.java.html">IAction</a> action) {</span>
+<a name="l27"><span class="ln">27   </span></a>        <span class="s0">if </span><span class="s1">(action == </span><span class="s0">null </span><span class="s1">|| action.isNegative()) {</span>
+<a name="l28"><span class="ln">28   </span></a>            <span class="s0">return</span><span class="s1">; </span><span class="s2">// NOP bei fehlender oder negativer Aktion</span>
+<a name="l29"><span class="ln">29   </span></a>        <span class="s1">}</span>
+<a name="l30"><span class="ln">30   </span></a>        <span class="s1">performPositiveActions();</span>
+<a name="l31"><span class="ln">31   </span></a>    <span class="s1">}</span>
+<a name="l32"><span class="ln">32   </span></a><span class="s1">}</span></pre>
