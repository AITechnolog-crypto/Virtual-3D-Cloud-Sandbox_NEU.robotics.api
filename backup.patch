+</head>
+<body bgcolor="#1a2426">
+<table CELLSPACING=0 CELLPADDING=5 COLS=1 WIDTH="100%" BGCOLOR="#606060" >
+<tr><td><center>
+<font face="Arial, Helvetica" color="#000000">
+ActionsController.java</font>
+</center></td></tr></table>
+<pre><a name="l1"><span class="ln">1    </span></a><span class="s0">package </span><span class="s1">com.june.controller.api;</span>
+<a name="l2"><span class="ln">2    </span></a>
+<a name="l3"><span class="ln">3    </span></a><span class="s0">import </span><span class="s1">org.springframework.http.ResponseEntity;</span>
+<a name="l4"><span class="ln">4    </span></a><span class="s0">import </span><span class="s1">org.springframework.web.bind.annotation.*;</span>
+<a name="l5"><span class="ln">5    </span></a>
+<a name="l6"><span class="ln">6    </span></a><span class="s0">import </span><span class="s1">java.util.*;</span>
+<a name="l7"><span class="ln">7    </span></a>
+<a name="l8"><span class="ln">8    </span></a><span class="s2">/**</span>
+<a name="l9"><span class="ln">9    </span></a> <span class="s2">* ActionsController – kleine Simulations-Endpoints für die UI-Buttons.</span>
+<a name="l10"><span class="ln">10   </span></a> <span class="s2">* Ziel: Keine 404 mehr, sichtbare Live-Aktualisierung via TelemetryController.</span>
+<a name="l11"><span class="ln">11   </span></a> <span class="s2">*</span>
+<a name="l12"><span class="ln">12   </span></a> <span class="s2">* Endpunkte (POST):</span>
+<a name="l13"><span class="ln">13   </span></a> <span class="s2">*  - /api/robots/deploy</span>
+<a name="l14"><span class="ln">14   </span></a> <span class="s2">*  - /api/energy/collect</span>
+<a name="l15"><span class="ln">15   </span></a> <span class="s2">*  - /api/threats/simulate</span>
+<a name="l16"><span class="ln">16   </span></a> <span class="s2">*  - /api/seed</span>
+<a name="l17"><span class="ln">17   </span></a> <span class="s2">*/</span>
+<a name="l18"><span class="ln">18   </span></a><span class="s1">@RestController</span>
+<a name="l19"><span class="ln">19   </span></a><span class="s1">@RequestMapping(</span><span class="s3">&quot;/api&quot;</span><span class="s1">)</span>
+<a name="l20"><span class="ln">20   </span></a><span class="s1">@CrossOrigin(origins = </span><span class="s3">&quot;*&quot;</span><span class="s1">)</span>
+<a name="l21"><span class="ln">21   </span></a><span class="s0">public class </span><span class="s1">ActionsController {</span>
+<a name="l22"><span class="ln">22   </span></a>
+<a name="l23"><span class="ln">23   </span></a>    <span class="s0">private final <a href="TelemetryController.java.html">TelemetryController</a> </span><span class="s1">telemetry;</span>
+<a name="l24"><span class="ln">24   </span></a>
+<a name="l25"><span class="ln">25   </span></a>    <span class="s0">public </span><span class="s1">ActionsController(<a href="TelemetryController.java.html">TelemetryController</a> telemetry) {</span>
+<a name="l26"><span class="ln">26   </span></a>        <span class="s0">this</span><span class="s1">.telemetry = telemetry;</span>
+<a name="l27"><span class="ln">27   </span></a>    <span class="s1">}</span>
+<a name="l28"><span class="ln">28   </span></a>
+<a name="l29"><span class="ln">29   </span></a>    <span class="s1">@PostMapping(</span><span class="s3">&quot;/robots/deploy&quot;</span><span class="s1">)</span>
+<a name="l30"><span class="ln">30   </span></a>    <span class="s0">public </span><span class="s1">Map&lt;String, Object&gt; deployRobots() {</span>
+<a name="l31"><span class="ln">31   </span></a>        <span class="s1">Map&lt;String, Object&gt; metrics = currentMetrics();</span>
+<a name="l32"><span class="ln">32   </span></a>        <span class="s2">// kleiner positiver Effekt auf die Energie</span>
+<a name="l33"><span class="ln">33   </span></a>        <span class="s0">double </span><span class="s1">energy = asDouble(metrics.get(</span><span class="s3">&quot;energy&quot;</span><span class="s1">));</span>
+<a name="l34"><span class="ln">34   </span></a>        <span class="s1">metrics.put(</span><span class="s3">&quot;energy&quot;</span><span class="s1">, Math.max(</span><span class="s4">0</span><span class="s1">, energy + </span><span class="s4">50</span><span class="s1">));</span>
+<a name="l35"><span class="ln">35   </span></a>        <span class="s1">pushTelemetry(</span><span class="s3">&quot;action:robots/deploy&quot;</span><span class="s1">, metrics);</span>
+<a name="l36"><span class="ln">36   </span></a>        <span class="s0">return </span><span class="s1">Map.of(</span><span class="s3">&quot;ok&quot;</span><span class="s1">, </span><span class="s0">true</span><span class="s1">, </span><span class="s3">&quot;deployed&quot;</span><span class="s1">, </span><span class="s4">100</span><span class="s1">);</span>
+<a name="l37"><span class="ln">37   </span></a>    <span class="s1">}</span>
+<a name="l38"><span class="ln">38   </span></a>
+<a name="l39"><span class="ln">39   </span></a>    <span class="s1">@PostMapping(</span><span class="s3">&quot;/energy/collect&quot;</span><span class="s1">)</span>
+<a name="l40"><span class="ln">40   </span></a>    <span class="s0">public </span><span class="s1">Map&lt;String, Object&gt; collectEnergy() {</span>
+<a name="l41"><span class="ln">41   </span></a>        <span class="s1">Map&lt;String, Object&gt; metrics = currentMetrics();</span>
+<a name="l42"><span class="ln">42   </span></a>        <span class="s2">// deutlichere Energie-Erhöhung (simulativ)</span>
+<a name="l43"><span class="ln">43   </span></a>        <span class="s0">double </span><span class="s1">energy = asDouble(metrics.get(</span><span class="s3">&quot;energy&quot;</span><span class="s1">));</span>
+<a name="l44"><span class="ln">44   </span></a>        <span class="s0">double </span><span class="s1">delta = </span><span class="s4">200 </span><span class="s1">+ Math.random() * </span><span class="s4">300</span><span class="s1">; </span><span class="s2">// 200..500</span>
+<a name="l45"><span class="ln">45   </span></a>        <span class="s1">metrics.put(</span><span class="s3">&quot;energy&quot;</span><span class="s1">, Math.max(</span><span class="s4">0</span><span class="s1">, energy + Math.round(delta)));</span>
+<a name="l46"><span class="ln">46   </span></a>        <span class="s1">pushTelemetry(</span><span class="s3">&quot;action:energy/collect&quot;</span><span class="s1">, metrics);</span>
+<a name="l47"><span class="ln">47   </span></a>        <span class="s0">return </span><span class="s1">Map.of(</span><span class="s3">&quot;ok&quot;</span><span class="s1">, </span><span class="s0">true</span><span class="s1">, </span><span class="s3">&quot;delta&quot;</span><span class="s1">, Math.round(delta));</span>
+<a name="l48"><span class="ln">48   </span></a>    <span class="s1">}</span>
+<a name="l49"><span class="ln">49   </span></a>
+<a name="l50"><span class="ln">50   </span></a>    <span class="s1">@PostMapping(</span><span class="s3">&quot;/threats/simulate&quot;</span><span class="s1">)</span>
+<a name="l51"><span class="ln">51   </span></a>    <span class="s0">public </span><span class="s1">Map&lt;String, Object&gt; simulateThreat() {</span>
+<a name="l52"><span class="ln">52   </span></a>        <span class="s1">Map&lt;String, Object&gt; metrics = currentMetrics();</span>
+<a name="l53"><span class="ln">53   </span></a>        <span class="s0">long </span><span class="s1">threats = asLong(metrics.get(</span><span class="s3">&quot;threats&quot;</span><span class="s1">));</span>
+<a name="l54"><span class="ln">54   </span></a>        <span class="s1">metrics.put(</span><span class="s3">&quot;threats&quot;</span><span class="s1">, threats + </span><span class="s4">1</span><span class="s1">);</span>
+<a name="l55"><span class="ln">55   </span></a>        <span class="s2">// leichte Temperaturänderung für Sichtbarkeit</span>
+<a name="l56"><span class="ln">56   </span></a>        <span class="s0">double </span><span class="s1">temp = asDouble(metrics.get(</span><span class="s3">&quot;temperature&quot;</span><span class="s1">));</span>
+<a name="l57"><span class="ln">57   </span></a>        <span class="s1">metrics.put(</span><span class="s3">&quot;temperature&quot;</span><span class="s1">, Math.max(</span><span class="s4">0</span><span class="s1">, Math.round((temp + (Math.random() &gt; </span><span class="s4">0.5 </span><span class="s1">? </span><span class="s4">0.2 </span><span class="s1">: -</span><span class="s4">0.2</span><span class="s1">)) * </span><span class="s4">10.0</span><span class="s1">) / </span><span class="s4">10.0</span><span class="s1">));</span>
+<a name="l58"><span class="ln">58   </span></a>        <span class="s1">pushTelemetry(</span><span class="s3">&quot;action:threats/simulate&quot;</span><span class="s1">, metrics);</span>
+<a name="l59"><span class="ln">59   </span></a>        <span class="s0">return </span><span class="s1">Map.of(</span><span class="s3">&quot;ok&quot;</span><span class="s1">, </span><span class="s0">true</span><span class="s1">, </span><span class="s3">&quot;threats&quot;</span><span class="s1">, threats + </span><span class="s4">1</span><span class="s1">);</span>
+<a name="l60"><span class="ln">60   </span></a>    <span class="s1">}</span>
+<a name="l61"><span class="ln">61   </span></a>
+<a name="l62"><span class="ln">62   </span></a>    <span class="s1">@PostMapping(</span><span class="s3">&quot;/seed&quot;</span><span class="s1">)</span>
+<a name="l63"><span class="ln">63   </span></a>    <span class="s0">public </span><span class="s1">Map&lt;String, Object&gt; seed() {</span>
+<a name="l64"><span class="ln">64   </span></a>        <span class="s2">// Nur Bestätigung + kleiner Impuls für Telemetrie</span>
+<a name="l65"><span class="ln">65   </span></a>        <span class="s1">Map&lt;String, Object&gt; metrics = currentMetrics();</span>
+<a name="l66"><span class="ln">66   </span></a>        <span class="s0">double </span><span class="s1">energy = asDouble(metrics.get(</span><span class="s3">&quot;energy&quot;</span><span class="s1">));</span>
+<a name="l67"><span class="ln">67   </span></a>        <span class="s1">metrics.put(</span><span class="s3">&quot;energy&quot;</span><span class="s1">, Math.max(</span><span class="s4">0</span><span class="s1">, energy + </span><span class="s4">10</span><span class="s1">));</span>
+<a name="l68"><span class="ln">68   </span></a>        <span class="s1">pushTelemetry(</span><span class="s3">&quot;action:seed&quot;</span><span class="s1">, metrics);</span>
+<a name="l69"><span class="ln">69   </span></a>        <span class="s0">return </span><span class="s1">Map.of(</span><span class="s3">&quot;ok&quot;</span><span class="s1">, </span><span class="s0">true</span><span class="s1">);</span>
+<a name="l70"><span class="ln">70   </span></a>    <span class="s1">}</span>
+<a name="l71"><span class="ln">71   </span></a>
+<a name="l72"><span class="ln">72   </span></a>    <span class="s2">// === helpers ===</span>
+<a name="l73"><span class="ln">73   </span></a>    <span class="s1">@SuppressWarnings(</span><span class="s3">&quot;unchecked&quot;</span><span class="s1">)</span>
+<a name="l74"><span class="ln">74   </span></a>    <span class="s0">private </span><span class="s1">Map&lt;String, Object&gt; currentMetrics() {</span>
+<a name="l75"><span class="ln">75   </span></a>        <span class="s0">try </span><span class="s1">{</span>
+<a name="l76"><span class="ln">76   </span></a>            <span class="s1">ResponseEntity&lt;Map&lt;String, Object&gt;&gt; res = telemetry.status();</span>
+<a name="l77"><span class="ln">77   </span></a>            <span class="s1">Map&lt;String, Object&gt; snap = res.getBody();</span>
+<a name="l78"><span class="ln">78   </span></a>            <span class="s0">if </span><span class="s1">(snap == </span><span class="s0">null</span><span class="s1">) snap = </span><span class="s0">new </span><span class="s1">LinkedHashMap&lt;&gt;();</span>
+<a name="l79"><span class="ln">79   </span></a>            <span class="s1">Object m = snap.get(</span><span class="s3">&quot;metrics&quot;</span><span class="s1">);</span>
+<a name="l80"><span class="ln">80   </span></a>            <span class="s0">if </span><span class="s1">(m </span><span class="s0">instanceof </span><span class="s1">Map&lt;?, ?&gt;) {</span>
+<a name="l81"><span class="ln">81   </span></a>                <span class="s0">return new </span><span class="s1">LinkedHashMap&lt;&gt;((Map&lt;String, Object&gt;) m);</span>
+<a name="l82"><span class="ln">82   </span></a>            <span class="s1">}</span>
+<a name="l83"><span class="ln">83   </span></a>        <span class="s1">} </span><span class="s0">catch </span><span class="s1">(Exception ignored) {}</span>
+<a name="l84"><span class="ln">84   </span></a>        <span class="s2">// Fallback-Basiswerte</span>
+<a name="l85"><span class="ln">85   </span></a>        <span class="s1">Map&lt;String, Object&gt; base = </span><span class="s0">new </span><span class="s1">LinkedHashMap&lt;&gt;();</span>
+<a name="l86"><span class="ln">86   </span></a>        <span class="s1">base.put(</span><span class="s3">&quot;energy&quot;</span><span class="s1">, </span><span class="s4">3000</span><span class="s1">);</span>
+<a name="l87"><span class="ln">87   </span></a>        <span class="s1">base.put(</span><span class="s3">&quot;threats&quot;</span><span class="s1">, </span><span class="s4">0</span><span class="s1">);</span>
+<a name="l88"><span class="ln">88   </span></a>        <span class="s1">base.put(</span><span class="s3">&quot;temperature&quot;</span><span class="s1">, </span><span class="s4">23</span><span class="s1">);</span>
+<a name="l89"><span class="ln">89   </span></a>        <span class="s0">return </span><span class="s1">base;</span>
+<a name="l90"><span class="ln">90   </span></a>    <span class="s1">}</span>
