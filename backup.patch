+<a name="l147"><span class="ln">147  </span></a>    <span class="s8">if </span><span class="s0">(ev.absolute === </span><span class="s8">null </span><span class="s0">&amp;&amp; ev.alpha === </span><span class="s8">null</span><span class="s0">) </span><span class="s8">return</span>
+<a name="l148"><span class="ln">148  </span></a>    <span class="s8">const </span><span class="s0">q = eulerToQuat(ev.alpha||</span><span class="s4">0</span><span class="s0">, ev.beta||</span><span class="s4">0</span><span class="s0">, ev.gamma||</span><span class="s4">0</span><span class="s0">)</span>
+<a name="l149"><span class="ln">149  </span></a>    <span class="s0">currentQuat.copy(q).premultiply(baseQuat)</span>
