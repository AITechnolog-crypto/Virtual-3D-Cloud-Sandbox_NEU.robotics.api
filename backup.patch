+    function purgeOlderThanDays(key, days){ try{ const arr=JSON.parse(localStorage.getItem(key)||'[]'); const cutoff=Date.now()-days*24*3600*1000; const keep=arr.filter(x=> (x._ts||0) > cutoff); localStorage.setItem(key, JSON.stringify(keep)); }catch(_){} }
+    setInterval(()=> purgeOlderThanDays('telemetry', 7), 6*3600*1000);
+    // Export helpers (optional)
+    window.pushLocalEvent = pushLocalEvent;
+  })();
