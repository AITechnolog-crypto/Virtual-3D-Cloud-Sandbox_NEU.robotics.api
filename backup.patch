+<!-- Physik/Mathe/Chemie Modell: realistische Energie & Chemie -->
+<script>
+/*
+  Physik/Mathe/Chemie – Realistisches Energie-Modell
+  - Solar: I ≈ 1000·sin(α)·(1-0.6·Bewölkung), α via Deklination+Stundenwinkel
+  - Wind: P = 0.5·ρ·A·Cp·v^3
+  - Chemie: CO₂→Methanol‑Äquivalent (LHV ~19.9 MJ/kg) als Energiepuffer
+  - Ergebnisse werden in die Telemetrie gepusht und ins Diagramm geschrieben
+*/
+(function(){
+  const API = window.location.origin + '/api';
+  const params = {
+    lat: 48.2082, lon: 16.3738,
+    areaSolar: 2000,   // m² kollektive Fläche
+    eta: 0.22,         // Wirkungsgrad
+    cloud: 0.2,        // 0..1
+    rho: 1.225,        // kg/m³
+    rotorArea: 120,    // m²
+    Cp: 0.4,
+    wind: 6.0,         // m/s
+    scale: 1000,       // Schwarm‑Skalierung
+    co2kgPerHour: 35   // CO₂‑Bindung (kg/h)
+  };
+
+  function mountCard(){
+    const grid = document.querySelector('.dashboard-grid'); if(!grid) return;
+    const card = document.createElement('div'); card.className='card';
+    card.innerHTML = `<div class="card-title">🔬 Physik/Mathe/Chemie – Realismus</div>
+      <div class="small muted">Deterministisches Solar/Wind/CO₂‑Modell. Werte speisen Live‑Telemetrie.</div>
+      <div style="display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:8px;margin-top:8px">
+        <label>Breite φ [°] <input id="p_lat" type="number" step="0.0001" value="${params.lat}"></label>
+        <label>Länge λ [°] <input id="p_lon" type="number" step="0.0001" value="${params.lon}"></label>
+        <label>Solarfläche A [m²] <input id="p_area" type="number" step="1" value="${params.areaSolar}"></label>
+        <label>Wirkungsgrad η [%] <input id="p_eta" type="number" step="0.1" value="${(params.eta*100).toFixed(1)}"></label>
+        <label>Bewölkung 0..1 <input id="p_cloud" type="number" min="0" max="1" step="0.05" value="${params.cloud}"></label>
+        <label>Wind v [m/s] <input id="p_wind" type="number" step="0.1" value="${params.wind}"></label>
+        <label>Rotorfläche [m²] <input id="p_rotor" type="number" step="1" value="${params.rotorArea}"></label>
+        <label>Cp <input id="p_cp" type="number" step="0.05" value="${params.Cp}"></label>
+        <label>Skalierung xN <input id="p_scale" type="number" step="1" value="${params.scale}"></label>
+        <label>CO₂‑Bindung [kg/h] <input id="p_co2" type="number" step="1" value="${params.co2kgPerHour}"></label>
+      </div>
+      <div class="small muted" id="p_out" style="margin-top:8px">bereit…</div>
+      <div style="margin-top:8px;display:flex;gap:8px;flex-wrap:wrap">
+        <button class="btn" id="p_apply">Übernehmen</button>
+        <button class="btn" id="p_usemap">Von Karte übernehmen (Mitte)</button>
+      </div>`;
+    grid.appendChild(card);
+
+    function apply(){
+      params.lat = parseFloat(card.querySelector('#p_lat').value)||params.lat;
+      params.lon = parseFloat(card.querySelector('#p_lon').value)||params.lon;
+      params.areaSolar = Math.max(0, parseFloat(card.querySelector('#p_area').value)||params.areaSolar);
+      params.eta = Math.max(0, Math.min(1,(parseFloat(card.querySelector('#p_eta').value)|| (params.eta*100))/100));
+      params.cloud = Math.max(0, Math.min(1, parseFloat(card.querySelector('#p_cloud').value)||params.cloud));
+      params.wind = Math.max(0, parseFloat(card.querySelector('#p_wind').value)||params.wind);
+      params.rotorArea = Math.max(0, parseFloat(card.querySelector('#p_rotor').value)||params.rotorArea);
+      params.Cp = Math.max(0, Math.min(0.59, parseFloat(card.querySelector('#p_cp').value)||params.Cp));
+      params.scale = Math.max(1, parseInt(card.querySelector('#p_scale').value)||params.scale);
+      params.co2kgPerHour = Math.max(0, parseFloat(card.querySelector('#p_co2').value)||params.co2kgPerHour);
+      if (typeof toast==='function') toast('✅ Parameter aktualisiert');
+    }
+    card.querySelector('#p_apply').addEventListener('click', apply);
+    card.querySelector('#p_usemap').addEventListener('click', ()=>{
+      try{
+        if (window.__leafletMap){ const c = window.__leafletMap.getCenter(); card.querySelector('#p_lat').value=c.lat.toFixed(6); card.querySelector('#p_lon').value=c.lng.toFixed(6); apply(); return; }
+        if (window.__gmap){ const c = window.__gmap.getCenter(); card.querySelector('#p_lat').value=c.lat().toFixed(6); card.querySelector('#p_lon').value=c.lng().toFixed(6); apply(); return; }
+        if (typeof toast==='function') toast('Karte nicht initialisiert');
+      }catch(e){ if (typeof toast==='function') toast('Fehler Kartenmitte'); }
+    });
+  }
+
+  function deg2rad(d){ return d*Math.PI/180; }
+  function dayOfYear(d){ const start = new Date(d.getFullYear(),0,0); return Math.floor((d - start)/86400000); }
+  function solarElevation(lat, lon, date){
+    const n = dayOfYear(date);
+    const delta = deg2rad(23.45*Math.sin(deg2rad(360*(284+n)/365))); // Deklination
+    const phi = deg2rad(lat);
+    const hours = date.getUTCHours() + date.getUTCMinutes()/60 + (lon/15); // sehr einfache Solartime‑Annäherung
+    const H = deg2rad(15*(hours-12)); // Stundenwinkel
+    const sinAlpha = Math.sin(phi)*Math.sin(delta) + Math.cos(phi)*Math.cos(delta)*Math.cos(H);
+    return Math.asin(Math.max(-1, Math.min(1, sinAlpha)));
+  }
+
+  let energyKWh = 0; let lastTs = Date.now();
+  function loop(){
+    const now = new Date();
+    const dt = Math.max(0, (Date.now()-lastTs)/1000); lastTs = Date.now();
+    const alpha = solarElevation(params.lat, params.lon, now);
+    const I0 = 1000; // W/m²
+    const I = Math.max(0, I0 * Math.sin(alpha) * (1 - params.cloud*0.6));
+    const Psolar = I * params.areaSolar * params.eta;          // W
+    const Pwind  = 0.5 * params.rho * params.rotorArea * params.Cp * Math.pow(Math.max(0, params.wind), 3);
+    const PtotW  = (Psolar + Pwind) * params.scale;
+    energyKWh += PtotW * dt / 3600.0;
+
+    // Chemie: Methanol‑Äquivalent aus CO₂ Bindung
+    const co2kgps = params.co2kgPerHour / 3600.0;
+    const co2This = co2kgps * dt; // kg
+    const methanolKg = co2This * (32.04/44.01);
+    const LHV_MeOH = 19.9e6; // J/kg
+    const chemKWh = (methanolKg * LHV_MeOH) / 3.6e6;
+
+    const metrics = { energy: Math.round(energyKWh), threats: 0, temperature: 22 };
+    try { fetch(API + '/telemetry/push', { method:'POST', headers:{'Content-Type':'application/json'}, body: JSON.stringify({ source:'physik-model', metrics:{ ...metrics, chemBuffer_kWh:+chemKWh.toFixed(3), co2Bound_kg:+co2This.toFixed(3) } }) }).catch(()=>{}); } catch(_){ }
+    try { if (window.updateEnergyChart) window.updateEnergyChart(metrics.energy); } catch(_){ }
+    const out = document.getElementById('p_out');
+    if (out){
+      out.innerHTML = `P_solar=${(Psolar*params.scale/1000).toFixed(0)} kW, P_wind=${(Pwind*params.scale/1000).toFixed(0)} kW, E=${Math.round(energyKWh)} kWh`+
+                      `<br/>CO₂ gebunden: ${co2This.toFixed(2)} kg, chemischer Puffer: ${chemKWh.toFixed(3)} kWh`;
+    }
+    requestAnimationFrame(loop);
+  }
+
+  window.addEventListener('DOMContentLoaded', ()=>{
+    try{ mountCard(); }catch(e){ console.warn('[PhysikCard]', e); }
+    setTimeout(()=>{ lastTs = Date.now(); loop(); }, 800);
+  });
+})();
+</script>
+
+
+<!-- Finanz-Workspace: Einnahmen & Rückfluss Mapping (Energy → EUR) -->
+<script>
+(function(){
+  function addCard(el){ const grid=document.querySelector('.dashboard-grid'); if(!grid) return; grid.appendChild(el); }
+  function fmtEUR(n){ try{ return Number(n).toLocaleString('de-DE', { minimumFractionDigits:2, maximumFractionDigits:2 }); }catch(e){ return String(n); } }
+  function parseDE(s){ if (!s) return NaN; try{ const x=String(s).replace(/[^0-9,.-]/g,'').replace(/\.(?=\d{3}(\D|$))/g,'').replace(',', '.'); return parseFloat(x); }catch(e){ return NaN; } }
+  function currentEnergyKWh(){
+    try{
+      if (typeof window.__physEnergyKWh === 'number' && isFinite(window.__physEnergyKWh)) return window.__physEnergyKWh;
+    }catch(_){}
+    try{
+      const out = document.getElementById('p_out');
+      if (out){
+        const m = out.textContent.match(/E\s*=\s*([0-9]+(?:[\.,][0-9]+)?)\s*kWh/i);
+        if (m){ return parseDE(m[1]); }
+      }
+    }catch(_){ }
+    try{
+      const ld = document.getElementById('ldEnergy');
+      if (ld && ld.textContent && ld.textContent.indexOf('kWh')>-1){ return parseDE(ld.textContent); }
+    }catch(_){ }
+    try{
+      const e = document.getElementById('energy');
+      if (e){ return parseDE(e.textContent); }
+    }catch(_){ }
+    return 0;
+  }
+
+  function createCard(){
+    const c = document.createElement('div');
+    c.className = 'card';
+    c.id = 'financeWorkspace';
+    c.innerHTML = `
+      <div class="card-title">💶 Einnahmen & Rückfluss – Finanz‑Workspace</div>
+      <div class="small muted">Mathematische Relation: EUR = kWh × Preis × Verkauf − Kosten. Werte werden live aus der Energie abgeleitet.</div>
+      <div style="display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:10px;margin-top:10px">
+        <label>Preis [EUR/kWh]
+          <input id="fw_price" type="number" min="0" step="0.01" value="0.18" style="width:100%">
+        </label>
+        <label>Verkauf [%]
+          <input id="fw_sell" type="number" min="0" max="100" step="1" value="60" style="width:100%">
+        </label>
+        <label>Kosten [%]
+          <input id="fw_cost" type="number" min="0" max="100" step="1" value="15" style="width:100%">
+        </label>
+      </div>
+      <div style="display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:10px;margin-top:12px">
+        <div><div class="muted small">Energie gesamt</div><div id="fw_energy" class="card-value">–</div></div>
+        <div><div class="muted small">Umsatz (brutto)</div><div id="fw_gross" class="card-value">–</div></div>
+        <div><div class="muted small">Kosten</div><div id="fw_costAmt" class="card-value">–</div></div>
+        <div><div class="muted small">Rückfluss Wallets (netto)</div><div id="fw_net" class="card-value">–</div></div>
+      </div>
+      <div style="margin-top:12px;display:flex;gap:8px;flex-wrap:wrap">
+        <button class="btn" id="fw_stampBtn">🔏 Policy‑Stempel setzen</button>
+        <button class="btn" id="fw_unstampBtn">♻️ Stempel löschen</button>
+        <span id="fw_stampStatus" class="small muted"></span>
+      </div>
+      <div style="margin-top:12px">
+        <div class="muted small">Workspace/Komfortzone – Notizen</div>
+        <textarea id="fw_notes" placeholder="Planung, Verteilungslogik, Dienstpläne…" style="width:100%;min-height:90px;padding:10px;border-radius:8px;border:1px solid rgba(255,255,255,.12);background:rgba(255,255,255,.04);color:#fff;"></textarea>
+      </div>
+    `;
+    return c;
+  }
+
+  function loadCfg(){
+    try{ return JSON.parse(localStorage.getItem('financeCfg')||'{}'); }catch(_){ return {}; }
+  }
+  function saveCfg(cfg){ try{ localStorage.setItem('financeCfg', JSON.stringify(cfg)); }catch(_){} }
+  function loadNotes(){ try{ return localStorage.getItem('financeNotes')||''; }catch(_){ return ''; } }
+  function saveNotes(v){ try{ localStorage.setItem('financeNotes', v||''); }catch(_){} }
+
+  function setStamp(txt){ try{ localStorage.setItem('financeStamp', txt); }catch(_){} }
+  function getStamp(){ try{ return localStorage.getItem('financeStamp'); }catch(_){ return null; } }
+  function clearStamp(){ try{ localStorage.removeItem('financeStamp'); }catch(_){} }
+
+  function mount(){
+    const card = createCard();
+    addCard(card);
+    const elPrice = card.querySelector('#fw_price');
+    const elSell  = card.querySelector('#fw_sell');
+    const elCost  = card.querySelector('#fw_cost');
+    const elE     = card.querySelector('#fw_energy');
+    const elG     = card.querySelector('#fw_gross');
+    const elC     = card.querySelector('#fw_costAmt');
+    const elN     = card.querySelector('#fw_net');
