+      if (!el.out.textContent || el.out.textContent === '–') el.out.textContent = fmtEUR(cfg.expense);
+      if (!el.netto.textContent || el.netto.textContent === '–') el.netto.textContent = fmtEUR(cfg.income - cfg.expense);
