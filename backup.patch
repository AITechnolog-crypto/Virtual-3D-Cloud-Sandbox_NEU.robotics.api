+                if (!res.ok){ out.innerHTML = '<span style="color:#ff4d6d">❌ ' + (json && json.error || ('HTTP '+res.status)) + '</span>'; return; }
+                let text = '';
+                const r = json && (json.response || json);
+                if (r && r.choices && r.choices[0] && r.choices[0].message){
+                    text = r.choices[0].message.content || '';
+                } else if (typeof json.text === 'string') {
+                    text = json.text;
+                }
+                out.innerHTML = '<div style="white-space:pre-wrap;line-height:1.4">' + (text || 'Keine Antwort erhalten.') + '</div>';
