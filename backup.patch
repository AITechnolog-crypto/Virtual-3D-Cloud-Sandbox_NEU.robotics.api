+    // ========================================
+    // 3D BACKGROUND INIT
+    // ========================================
+    function loadThree(cb){
+        try{
+            if (window.THREE){ try{ cb&&cb(); }catch(e){ console.warn('[3D init]', e); } return; }
+            const id = 'three-js-loader';
+            if (document.getElementById(id)){
+                // already loading – wait
+                const iv = setInterval(()=>{ if (window.THREE){ clearInterval(iv); try{ cb&&cb(); }catch(e){ console.warn('[3D init]', e); } } }, 250);
+                return;
+            }
+            const s = document.createElement('script');
+            s.id = id; s.defer = true; s.async = true;
+            s.src = 'https://unpkg.com/three@0.156.1/build/three.min.js';
+            s.onload = ()=>{ try{ cb&&cb(); }catch(e){ console.warn('[3D init]', e); } };
+            s.onerror = ()=>{ console.warn('[3D] THREE.js konnte nicht geladen werden – fahre ohne 3D fort.'); };
+            document.head.appendChild(s);
+        }catch(e){ console.warn('[3D loader]', e); }
+    }
+    function init3D() {
+        const canvas = document.getElementById('bg-canvas');
+        const scene = new THREE.Scene();
+        const camera = new THREE.PerspectiveCamera(75, window.innerWidth / window.innerHeight, 0.1, 2000);
+        const renderer = new THREE.WebGLRenderer({ canvas, antialias: true, alpha: true });
+
+        renderer.setPixelRatio(Math.min(window.devicePixelRatio || 1, 2));
+        renderer.setSize(window.innerWidth, window.innerHeight);
+        camera.position.set(0, 0, 420);
+
+        // Respect user preference for reduced motion
+        const motionReduced = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
+
+        // =====================
+        // Particle Starfield
+        // =====================
+        const particleCount = 1500;
+        const positions = new Float32Array(particleCount * 3);
+        const speeds = new Float32Array(particleCount);
+        for (let i = 0; i < particleCount; i++) {
+            const i3 = i * 3;
+            positions[i3 + 0] = (Math.random() - 0.5) * 1600; // x
+            positions[i3 + 1] = (Math.random() - 0.5) * 900;  // y
+            positions[i3 + 2] = (Math.random() - 0.5) * 1200; // z
+            speeds[i] = 0.15 + Math.random() * 0.6; // drift speed
+        }
+        const particleGeo = new THREE.BufferGeometry();
+        particleGeo.setAttribute('position', new THREE.BufferAttribute(positions, 3));
+        const particleMat = new THREE.PointsMaterial({
+            color: 0x00ffcc,
+            size: 2,
+            transparent: true,
+            opacity: 0.85,
+            depthWrite: false,
+            blending: THREE.AdditiveBlending
+        });
+        const particles = new THREE.Points(particleGeo, particleMat);
+        scene.add(particles);
+
+        // =====================
+        // Wireframe Globe + Halo
+        // =====================
+        const globeGeo = new THREE.IcosahedronGeometry(120, 1);
+        const globeMat = new THREE.MeshBasicMaterial({ color: 0x2288ff, wireframe: true, transparent: true, opacity: 0.18 });
+        const globe = new THREE.Mesh(globeGeo, globeMat);
+        scene.add(globe);
+
+        const ringGeo = new THREE.TorusGeometry(180, 0.8, 8, 160);
+        const ringMat = new THREE.MeshBasicMaterial({ color: 0x00ff88, transparent: true, opacity: 0.3 });
+        const ring = new THREE.Mesh(ringGeo, ringMat);
+        ring.rotation.x = Math.PI / 2;
+        scene.add(ring);
+
+        // Vision: export key 3D references for external UI controls
+        try {
+            window.__scene = scene;
+            window.__camera = camera;
+            window.__globe = globe;
+            window.__ring = ring;
+            window.__particles = particles;
+            window.__materials = { globe: globeMat, ring: ringMat, particles: particleMat };
+        } catch (e) { /* no-op */ }
+
+        // =====================
+        // Subtle camera parallax
+        // =====================
+        let mouseX = 0, mouseY = 0, targetX = 0, targetY = 0;
+        document.addEventListener('mousemove', (e) => {
+            const x = (e.clientX / window.innerWidth) * 2 - 1;
+            const y = (e.clientY / window.innerHeight) * 2 - 1;
+            mouseX = x; mouseY = y;
+        });
+
+        const clock = new THREE.Clock();
+        function animate() {
+            const dt = clock.getDelta();
+            const pos = particles.geometry.attributes.position.array;
+
+            if (!motionReduced) {
+                // Parallax
+                targetX += (mouseX - targetX) * 0.05;
+                targetY += (mouseY - targetY) * 0.05;
+                camera.position.x = targetX * 40;
+                camera.position.y = -targetY * 20;
+                camera.lookAt(0, 0, 0);
+
+                // Rotate centerpiece
+                globe.rotation.y += 0.25 * dt;
+                ring.rotation.z += 0.15 * dt;
+                scene.rotation.y += 0.06 * dt;
+
+                // Drift particles forward in Z and wrap
+                for (let i = 0; i < particleCount; i++) {
+                    const zIndex = i * 3 + 2;
+                    pos[zIndex] += speeds[i] * (1 + 0.3 * Math.sin((i + performance.now() * 0.0005)));
+                    if (pos[zIndex] > 650) pos[zIndex] = -650;
+                }
+                particles.geometry.attributes.position.needsUpdate = true;
+            }
+
+            renderer.render(scene, camera);
+            requestAnimationFrame(animate);
+        }
+        animate();
+
+        window.addEventListener('resize', () => {
+            camera.aspect = window.innerWidth / window.innerHeight;
+            camera.updateProjectionMatrix();
+            renderer.setSize(window.innerWidth, window.innerHeight);
+        });
+    }
+
+    // ========================================
+    // CHART INIT
+    // ========================================
+    function initChart() {
+        if (!ENERGY_LIVE_ENABLED) { window.updateEnergyChart = function(){}; return; }
+        const energyEl = document.getElementById('energyChart');
+        if (!energyEl) { window.updateEnergyChart = function(){}; return; }
+        energyChart = new Chart(energyEl, {
+            type: 'line',
+            data: {
+                labels: Array(20).fill(''),
+                datasets: [{
+                    label: 'Energie (kWh)',
+                    data: Array(20).fill(0).map(() => Math.random() * 3000 + 2000),
+                    borderColor: '#00ff88',
+                    backgroundColor: 'rgba(0, 255, 136, 0.1)',
+                    tension: 0.4,
+                    fill: true
+                }]
+            },
+            options: {
+                responsive: true,
+                maintainAspectRatio: false,
+                animation: { duration: 180 },
+                plugins: { legend: { display: false } },
+                layout: { padding: { left: 0, right: 6, top: 0, bottom: 0 } },
+                scales: {
+                    x: { display: false },
+                    y: {
+                        ticks: { color: '#00ff88', maxTicksLimit: 4, font: { size: 10 } },
+                        grid: { color: 'rgba(0, 255, 136, 0.08)' }
+                    }
+                }
+            }
+        });
+
+        // Fallback: periodische Zufallsupdates (deaktiviert, sobald Telemetrie Live‑Werte liefert)
+        if (window.energyIv) { clearInterval(window.energyIv); }
+        window.energyIv = setInterval(() => {
+            if (!window.__energyLive) {
+                const ds = energyChart.data.datasets[0].data;
+                ds.shift();
+                ds.push(Math.random() * 3000 + 2000);
+                energyChart.update('none');
+            }
+        }, 2000);
+
+        // Tab‑Sichtbarkeit beachten (Ressourcen sparen)
+        document.addEventListener('visibilitychange', () => {
+            try {
+                if (document.hidden) {
+                    if (window.energyIv) clearInterval(window.energyIv);
+                } else {
+                    if (window.energyIv) clearInterval(window.energyIv);
+                    window.energyIv = setInterval(() => {
+                        if (!window.__energyLive) {
+                            const ds = energyChart.data.datasets[0].data;
+                            ds.shift();
+                            ds.push(Math.random() * 3000 + 2000);
+                            energyChart.update('none');
+                        }
+                    }, 2000);
+                }
+            } catch (_) {}
+        });
+
+        // Live‑Updater für Telemetrie (SSE/Polling)
+        window.__energyLive = false;
+        window.updateEnergyChart = function(val){
+            try {
+                if (typeof val === 'number' && isFinite(val)) {
+                    window.__energyLive = true;
+                    const ds = energyChart.data.datasets[0].data;
+                    ds.shift();
+                    ds.push(val);
+                    energyChart.update('none');
+                }
+            } catch (_) {}
+        };
+    }
