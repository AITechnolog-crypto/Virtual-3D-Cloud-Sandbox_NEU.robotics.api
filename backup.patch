+<pre><a name="l1"><span class="ln">1    </span></a><span class="s0"># ============================================</span>
+<a name="l2"><span class="ln">2    </span></a><span class="s0"># INFRASTRUCTURE MANAGEMENT SYSTEM CONFIG</span>
+<a name="l3"><span class="ln">3    </span></a><span class="s0"># ============================================</span>
+<a name="l4"><span class="ln">4    </span></a>
+<a name="l5"><span class="ln">5    </span></a><span class="s0"># Application</span>
+<a name="l6"><span class="ln">6    </span></a><span class="s2">spring.application.name</span><span class="s1">=</span><span class="s3">Infrastructure Management System 3D VR</span>
+<a name="l7"><span class="ln">7    </span></a>
