+class QrPayloadFactory {
+    /** BIP-21 bitcoin URI. amountBtc nullable → ohne Amount. */
+    public static String bitcoinUri(String address, Double amountBtc) {
+        if (amountBtc == null) return "bitcoin:" + address;
+        NumberFormat nf = NumberFormat.getInstance(Locale.US);
+        nf.setGroupingUsed(false);
+        nf.setMaximumFractionDigits(8);
+        String amt = nf.format(amountBtc);
+        return "bitcoin:" + address + "?amount=" + amt;
+    }
+    /** EIP-681 light */
+    public static String ethereumUri(String address) { return "ethereum:" + address; }
+
+    /** EPC/SEPA-QR (BCD, minimal). amountEUR nullable → ohne Betrag. */
+    public static String epcSepaPayload(String name, String iban, Double amountEUR, String remittanceUnstructured) {
+        String version = "001";     // EPC069-12
+        String encoding = "1";      // UTF-8
+        String service  = "SCT";
+        String bic      = "";       // optional leer
+        String amount   = (amountEUR == null) ? "" :
+                "EUR" + String.format(Locale.US, "%.2f", Math.max(0.01, amountEUR));
+        String rem      = (remittanceUnstructured == null) ? "" : remittanceUnstructured;
+
+        return String.join("\n", Arrays.asList(
+                "BCD", version, encoding, service,
+                bic, name, iban.replace(" ", ""),
+                amount, "", rem, "", ""   // Purpose/Ref optional
+        ));
