+<a name="l10"><span class="ln">10   </span></a><span class="s0">public class </span><span class="s1">ResourceStorage {</span>
+<a name="l11"><span class="ln">11   </span></a>
+<a name="l12"><span class="ln">12   </span></a>    <span class="s0">private final </span><span class="s1">Map&lt;ResourceType, Integer&gt; resources;</span>
+<a name="l13"><span class="ln">13   </span></a>
+<a name="l14"><span class="ln">14   </span></a>    <span class="s0">public </span><span class="s1">ResourceStorage() {</span>
+<a name="l15"><span class="ln">15   </span></a>        <span class="s0">this</span><span class="s1">.resources = </span><span class="s0">new </span><span class="s1">EnumMap&lt;&gt;(ResourceType.</span><span class="s0">class</span><span class="s1">);</span>
+<a name="l16"><span class="ln">16   </span></a>        <span class="s0">for </span><span class="s1">(ResourceType type : ResourceType.values()) {</span>
+<a name="l17"><span class="ln">17   </span></a>            <span class="s1">resources.put(type, </span><span class="s3">0</span><span class="s1">);</span>
