+  </div>
+  <div class="small" style="margin-top:6px">Tipp: Dein vorhandener Marker beginnt mit <code>b8d0d1ff...</code></div>
+</div>
+
+<div class="panel" id="startpanel" style="right:20px;display:none">
+  <h3>Start-Orbit (Launcher)</h3>
+  <div id="startApps"></div>
+</div>
+
+<!-- Windows container -->
+<div id="wins"></div>
+
+<!-- Start list floating -->
+<div class="start" id="startbox" style="display:none"></div>
+
+<div class="hud">
+  <div class="g">
+    <div class="small">Wallet</div>
+    <div id="walletBal">0.00</div>
+    <div class="row" style="margin-top:6px">
+      <input id="wamount" type="number" placeholder="Betrag" style="width:120px">
+      <button class="btn" onclick="wallet.credit()">+</button>
+      <button class="btn" onclick="wallet.debit()">−</button>
+    </div>
+  </div>
+  <div class="g">
+    <div class="small">Status</div>
+    <div>Globus: <span id="globusState">geschlossen</span></div>
+    <div>Creator: <span id="creatorState">aus</span></div>
+  </div>
+</div>
+
+<script>
+/*** STATE ******************************************************************/
+const LS = k => localStorage.getItem(k);
+const SS = (k,v)=> localStorage.setItem(k, typeof v==="string"? v: JSON.stringify(v));
+const clamp = (v,a,b)=>Math.max(a,Math.min(b,v));
+
+const state = {
+  auth:false,
+  blessed:false,
+  charge:0,
+  energy:{solar:0, plasma:0, lev:0},
+  creator:false,
+  globusOpen:false,
+  metrics:{ops:0,temp:0,win:0},
+  vcpu:{cores:64, base:3.2, turbo:6.4, on:false, load:0.12, temp:38, ops:0},
+  contacts:{name:"Sanel Crnkic", email:"gpt99@iCloud.com", phone:""},
+  wallet: Number(LS("wallet")||0),
+  notes: JSON.parse(LS("notes")||"[]"),
+  marker: LS("marker")||"",
+  startPinned: ["wallet","notes","cpu","contacts","starmap","silo"],
+  windows: []
+};
+
+function save(){ SS("wallet", state.wallet); SS("notes", state.notes); SS("marker", state.marker); }
+state.download = function(){
+  const blob = new Blob([JSON.stringify(state,null,2)],{type:"application/json"});
+  const a = document.createElement('a'); a.href = URL.createObjectURL(blob);
+  a.download = "HoloGlobePro_snapshot.json"; a.click(); URL.revokeObjectURL(a.href);
+};
+
+/*** UI *********************************************************************/
+const ui = {
+  el:{
+    status:document.getElementById('status'),
+    metricsPill:document.getElementById('metrics-pill'),
+    mSolar:document.getElementById('mSolar'),
+    mPlasma:document.getElementById('mPlasma'),
+    mLev:document.getElementById('mLev'),
+    mCharge:document.getElementById('mCharge'),
+    globusState:document.getElementById('globusState'),
+    creatorState:document.getElementById('creatorState'),
+    walletBal:document.getElementById('walletBal'),
+    startApps:document.getElementById('startApps'),
+    startbox:document.getElementById('startbox'),
+    wins:document.getElementById('wins')
+  },
+  sync(){
+    ui.el.status.textContent = `offline • ${state.auth?'unlocked':'locked'}`;
+    ui.el.metricsPill.textContent = `ops ${Math.round(state.vcpu.ops)} • temp ${state.vcpu.temp.toFixed(1)}°C • win ${state.windows.length}`;
+    ui.el.mSolar.style.width = `${state.energy.solar}%`;
+    ui.el.mPlasma.style.width = `${state.energy.plasma}%`;
+    ui.el.mLev.style.width    = `${state.energy.lev}%`;
+    ui.el.mCharge.style.width = `${state.charge}%`;
+    ui.el.globusState.textContent = state.globusOpen?'offen':'geschlossen';
+    ui.el.creatorState.textContent = state.creator?'an':'aus';
+    ui.el.walletBal.textContent = state.wallet.toFixed(2);
+  },
+  togglePanel(id){
+    const el = document.getElementById(id);
+    el.style.display = (el.style.display==='none'||!el.style.display)?'block':'none';
+  },
+  creator(){
+    const phrase = prompt("Creator-Mode Schlüssel eingeben:");
+    if(!phrase) return;
+    if(phrase.toLowerCase().includes("kun fa ya kun")){ state.creator=true; ui.sync(); alert("Creator-Mode aktiv."); }
+    else alert("Falsche Phrase.");
+  },
+  openGlobe(){
+    const need = state.creator? 50 : 100;
+    if(state.blessed && state.charge>=need){ state.globusOpen=true; ui.sync(); ui.showStart(true); }
+    else alert("Noch nicht genug Ritual-Charge oder nicht gesegnet.");
+  },
+  showStart(show){
+    const box = ui.el.startbox;
+    if(show===false){ box.style.display='none'; return; }
+    box.innerHTML = `<div class="small">Start-Orbit</div>` + state.startPinned.map(k=>(
+      `<div class="app" onclick="start.launch('${k}')">🚀 ${k}</div>`
+    )).join('');
+    box.style.display='block';
+  }
+};
+ui.sync();
+
+/*** BIO ********************************************************************/
+const bio = {
+  enroll(){
+    const val = document.getElementById('enrollHash').value.trim().toLowerCase();
+    if(!/^[0-9a-f]{64}$/.test(val)){ alert("Bitte gültigen SHA-256 Hash eintragen (64 hex)."); return; }
+    state.marker = val; save(); alert("Marker gespeichert (lokal).");
+  },
+  async login(){
+    if(!state.marker){ alert("Kein Marker gespeichert. Bitte zuerst Enroll."); return; }
+    const tryHash = document.getElementById('enrollHash').value.trim().toLowerCase();
+    if(tryHash===state.marker){ state.auth=true; ui.sync(); alert("Entsperrt."); }
+    else alert("Auth fehlgeschlagen.");
+  }
+};
+
+/*** WALLET / NOTES / CONTACTS **********************************************/
+const wallet = {
+  credit(){ const a = Number(document.getElementById('wamount').value||0); if(a>0){ state.wallet+=a; save(); ui.sync(); } },
+  debit(){ const a = Number(document.getElementById('wamount').value||0); if(a>0&&a<=state.wallet){ state.wallet-=a; save(); ui.sync(); } }
+};
+const apps = {
+  Wallet(body){
+    body.innerHTML = `<div>Saldo: <b>${state.wallet.toFixed(2)}</b></div>
+      <div class="row" style="margin-top:8px"><input id="wa" type="number" placeholder="Betrag">
+      <button class="btn" onclick="(function(){let a=Number(document.getElementById('wa').value||0); if(a>0){state.wallet+=a; save(); ui.sync();})()">Gutschrift</button>
+      <button class="btn" onclick="(function(){let a=Number(document.getElementById('wa').value||0); if(a>0&&a<=state.wallet){state.wallet-=a; save(); ui.sync();}})()">Belastung</button></div>`;
+  },
+  Notes(body){
+    const redraw=()=>{
+      body.innerHTML = `<div class="row"><textarea id="nt" placeholder="Notiz..."></textarea>
+        <button class="btn" onclick="(function(){let t=document.getElementById('nt').value.trim(); if(!t)return; state.notes.push({t,ts:Date.now()}); save(); draw();})()">Speichern</button></div>
+        <div style="margin-top:8px">${state.notes.slice().reverse().map(n=>`<div class="small">• ${new Date(n.ts).toLocaleString()} – ${n.t}</div>`).join('')}</div>`;
+    };
+    window.draw = redraw; redraw();
+  },
+  Contacts(body){
+    const c=state.contacts;
+    body.innerHTML = `<div class="grid2">
+      <div><div class="small">Name</div><input id="cn" value="${c.name}"></div>
+      <div><div class="small">E-Mail</div><input id="ce" value="${c.email}"></div>
+      <div><div class="small">Telefon</div><input id="cp" value="${c.phone}"></div>
+    </div>
+    <div class="row" style="margin-top:8px"><button class="btn" onclick="(function(){
+      state.contacts={name:document.getElementById('cn').value,email:document.getElementById('ce').value,phone:document.getElementById('cp').value}; save(); alert('Gespeichert.');
+    })()">Speichern</button></div>`;
+  },
+  CPU(body){
+    body.innerHTML = `<div class="grid2">
+      <div><div class="small">Cores</div><div class="pill">${state.vcpu.cores}</div></div>
+      <div><div class="small">Turbo</div><button class="btn" onclick="(state.vcpu.on=!state.vcpu.on)">Toggle</button></div>
+      <div style="grid-column:1/3"><div class="small">Load</div>
+        <input id="ld" type="range" min="0" max="1" step="0.01" value="${state.vcpu.load}" oninput="state.vcpu.load=Number(this.value)">
+      </div>
+      <div>Temp: <b id="ct">${state.vcpu.temp.toFixed(1)}°C</b></div>
+      <div>OPS: <b id="co">${Math.round(state.vcpu.ops)}</b></div>
+    </div>`;
+  },
+  StarMap(body){
+    body.innerHTML = `<div class="small">Sternenhimmel (offline, Demo)</div>
+      <div style="height:200px;border:1px dashed #6bd; margin-top:8px; display:grid;place-items:center;color:#9ad">
+      ✦ ✦ ✧ ✦ ✧ ✦ (Demo-Sky) </div>`;
+  },
+  Silo(body){
+    body.innerHTML = `<div class="small">Energie-Silos (Demo)</div>
+    <div class="grid2" style="margin-top:6px">
+      <div>Solar: <b>${state.energy.solar.toFixed(1)}</b></div>
+      <div>Plasma: <b>${state.energy.plasma.toFixed(1)}</b></div>
+      <div>Lev: <b>${state.energy.lev.toFixed(1)}</b></div>
+      <div>Charge: <b>${state.charge.toFixed(1)}</b></div>
+    </div>`;
+  }
+};
+
+/*** WINDOWS ***************************************************************/
+function makeWindow(title, app){
+  const id = crypto.randomUUID();
+  const w = document.createElement('div'); w.className='window'; w.style.left=(120+state.windows.length*24)+'px';
+  w.style.top=(120+state.windows.length*18)+'px';
+  w.innerHTML = `<div class="wtitle"><span class="pill">${app}</span> ${title}
+      <span class="close" onclick="closeWin('${id}')">✕</span></div>
+    <div class="wbody" id="wb-${id}"></div>`;
+  document.getElementById('wins').appendChild(w);
+  // drag
+  const titleBar = w.querySelector('.wtitle'); let ox=0,oy=0,dx=0,dy=0,drag=false;
+  titleBar.addEventListener('pointerdown',e=>{drag=true;ox=e.clientX;oy=e.clientY;dx=w.offsetLeft;dy=w.offsetTop;titleBar.setPointerCapture(e.pointerId)});
+  titleBar.addEventListener('pointermove',e=>{if(!drag)return; w.style.left = (dx+e.clientX-ox)+'px'; w.style.top=(dy+e.clientY-oy)+'px';});
+  titleBar.addEventListener('pointerup',()=>drag=false);
+  state.windows.push({id,title,app}); ui.sync();
+  apps[app]?.(w.querySelector('.wbody'));
+  return id;
+}
+function closeWin(id){
+  const el = [...document.querySelectorAll('.window')].find(d=>d.querySelector('.close').onclick.toString().includes(id));
+  if(el) el.remove();
+  state.windows = state.windows.filter(w=>w.id!==id);
+  ui.sync();
+}
+const start = {
+  list(){
+    ui.el.startApps.innerHTML = state.startPinned.map(k=>(
+      `<div class="row"><div class="pill">${k}</div><button class="btn" onclick="start.launch('${k}')">Start</button></div>`
+    )).join('');
+  },
+  launch(key){
+    if(!state.globusOpen){ alert("Globus zuerst öffnen."); return; }
+    const map = {
+      wallet:['Wallet','Wallet'], notes:['Notizen','Notes'], cpu:['CPU Monitor','CPU'],
+      contacts:['Kontakte','Contacts'], starmap:['Sternenhimmel','StarMap'], silo:['Energie-Silos','Silo']
+    };
+    const def = map[key]||['App','Notes'];
+    makeWindow(def[0], def[1]);
+  }
+};
+start.list();
+
+/*** RITUAL + AIRPODS ******************************************************/
+const ritual = {
+  wind(loops=12){
+    for(let i=0;i<loops;i++){ state.energy.solar = clamp(state.energy.solar+3.5,0,100); state.charge = clamp(state.charge+0.8,0,100); }
+    ui.sync();
+  },
+  inschallah(){
+    state.blessed=true; state.energy.plasma = clamp(state.energy.plasma+5,0,100); ui.sync();
+  }
+};
+const airpods = {
+  gesture(action){
+    if(action==='wind') ritual.wind(12);
+    else if(action==='inschallah') ritual.inschallah();
+    else if(action==='openGlobe') ui.openGlobe();
+    else if(action==='openStart'){ if(state.globusOpen) ui.showStart(true); else alert("Globus zuerst öffnen."); }
+  }
+};
+
+// Ritualpad circle gesture
+(function(){
+  const pad = document.getElementById('pad');
+  let down=false,lastA=null,acc=0;
+  const getA = (e)=>{ const r=pad.getBoundingClientRect(), cx=r.left+r.width/2, cy=r.top+r.height/2;
+    const x=(e.touches?e.touches[0].clientX:e.clientX)-cx, y=(e.touches?e.touches[0].clientY:e.clientY)-cy;
+    return Math.atan2(y,x);
+  };
+  const onDown = e=>{down=true; lastA=getA(e); acc=0; pad.setPointerCapture?.(e.pointerId);}
+  const onMove = e=>{
+    if(!down) return; const a=getA(e); if(lastA==null){lastA=a;return;}
+    let d=a-lastA; if(d>Math.PI) d-=2*Math.PI; if(d<-Math.PI) d+=2*Math.PI; acc += d; lastA=a;
+    if(Math.abs(acc) > 2*Math.PI){ // eine volle Umdrehung
+      ritual.wind(6); acc=0;
+    }
+  };
+  const onUp = ()=>{down=false; lastA=null;};
+  pad.addEventListener('pointerdown',onDown); pad.addEventListener('pointermove',onMove); pad.addEventListener('pointerup',onUp);
+  pad.addEventListener('touchstart',onDown,{passive:true}); pad.addEventListener('touchmove',onMove,{passive:true}); pad.addEventListener('touchend',onUp);
+})();
+
+/*** VCPU LOOP **************************************************************/
+setInterval(()=>{
+  // Energieverbrauch ~ einfache Näherung
+  let ghz = state.vcpu.on? state.vcpu.turbo : state.vcpu.base;
+  let watts = (20 + state.vcpu.cores*ghz*0.9) * (0.4 + 0.6*state.vcpu.load);
+  // Ziehe aus Solar/Plasma
+  let need = watts / 25; // scale
+  const pool = state.energy.solar + state.energy.plasma;
+  if(pool < need){ state.vcpu.on=false; ghz=state.vcpu.base*0.7; state.vcpu.load=Math.min(state.vcpu.load,0.6); }
+  // „spend“
+  const ratio = pool? state.energy.solar/pool : 0.5;
+  state.energy.solar = clamp(state.energy.solar - need*ratio, 0, 100);
+  state.energy.plasma= clamp(state.energy.plasma - need*(1-ratio), 0, 100);
+  // Temp & Ops
+  state.vcpu.temp = clamp(state.vcpu.temp + (watts*0.02) - (state.energy.lev*0.01), 28, 95);
+  if(state.vcpu.temp>82){ state.vcpu.on=false; state.vcpu.load=Math.min(state.vcpu.load,0.7); }
+  state.vcpu.ops = state.vcpu.cores*ghz*1000*state.vcpu.load;
+  ui.sync();
+}, 250);
+
+/*** STARTUP ***************************************************************/
+(function boot(){
+  // wenn Marker schon gespeichert → vorbefüllen
+  const e=document.getElementById('enrollHash');
+  if(state.marker && e) e.value = state.marker;
+  ui.sync();
+})();
+</script>
+</body>
+</html>
