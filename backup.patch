+
+    async function train(){
+      out.innerHTML = '<div class="loading">Trainiere…</div>';
+      try{
+        const r = await fetch(API + '/ml/train', { method:'POST' });
+        const j = await r.json();
+        out.innerHTML = '✅ Trainiert • n='+(j.n||0)+', Trend='+(j.slope!=null? Number(j.slope).toFixed(2):'-');
+      }catch(e){ out.innerHTML = '❌ Training fehlgeschlagen'; }
+    }
+
+    async function predict(){
+      out.innerHTML = '<div class="loading">Prognose…</div>';
+      try{
+        const r = await fetch(API + '/ml/predict?steps=10');
+        const j = await r.json();
+        const list = (j.predictions||[]).slice(0,10).map((v,i)=> (i+1)+': '+Number(v).toFixed(0)).join(', ');
+        out.innerHTML = '🔮 Energie‑Prognose: '+list;
+      }catch(e){ out.innerHTML = '❌ Prognose fehlgeschlagen'; }
