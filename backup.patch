+<pre><a name="l1"><span class="ln">1    </span></a><span class="s0">package </span><span class="s1">com.june.hidden;</span>
+<a name="l2"><span class="ln">2    </span></a>
+<a name="l3"><span class="ln">3    </span></a><span class="s2">/**</span>
+<a name="l4"><span class="ln">4    </span></a> <span class="s2">* Einfache Geräte-Fingerprint-Hilfsklasse.</span>
+<a name="l5"><span class="ln">5    </span></a> <span class="s2">* Nutzt nur harmlose System-Properties und bildet einen stabilen Hash ab.</span>
+<a name="l6"><span class="ln">6    </span></a> <span class="s2">*/</span>
+<a name="l7"><span class="ln">7    </span></a><span class="s0">public final class </span><span class="s1">DeviceFingerprint {</span>
+<a name="l8"><span class="ln">8    </span></a>    <span class="s0">private </span><span class="s1">DeviceFingerprint() {}</span>
+<a name="l9"><span class="ln">9    </span></a>
+<a name="l10"><span class="ln">10   </span></a>    <span class="s0">public static </span><span class="s1">String fingerprint() {</span>
+<a name="l11"><span class="ln">11   </span></a>        <span class="s1">String os = System.getProperty(</span><span class="s3">&quot;os.name&quot;</span><span class="s1">, </span><span class="s3">&quot;&quot;</span><span class="s1">);</span>
+<a name="l12"><span class="ln">12   </span></a>        <span class="s1">String arch = System.getProperty(</span><span class="s3">&quot;os.arch&quot;</span><span class="s1">, </span><span class="s3">&quot;&quot;</span><span class="s1">);</span>
+<a name="l13"><span class="ln">13   </span></a>        <span class="s1">String user = System.getProperty(</span><span class="s3">&quot;user.name&quot;</span><span class="s1">, </span><span class="s3">&quot;&quot;</span><span class="s1">);</span>
+<a name="l14"><span class="ln">14   </span></a>        <span class="s1">String home = System.getProperty(</span><span class="s3">&quot;user.home&quot;</span><span class="s1">, </span><span class="s3">&quot;&quot;</span><span class="s1">);</span>
+<a name="l15"><span class="ln">15   </span></a>        <span class="s1">String java = System.getProperty(</span><span class="s3">&quot;java.version&quot;</span><span class="s1">, </span><span class="s3">&quot;&quot;</span><span class="s1">);</span>
+<a name="l16"><span class="ln">16   </span></a>        <span class="s1">String t = os + </span><span class="s3">&quot;|&quot; </span><span class="s1">+ arch + </span><span class="s3">&quot;|&quot; </span><span class="s1">+ user + </span><span class="s3">&quot;|&quot; </span><span class="s1">+ home + </span><span class="s3">&quot;|&quot; </span><span class="s1">+ java;</span>
+<a name="l17"><span class="ln">17   </span></a>        <span class="s0">return </span><span class="s1">Integer.toHexString(t.hashCode());</span>
+<a name="l18"><span class="ln">18   </span></a>    <span class="s1">}</span>
+<a name="l19"><span class="ln">19   </span></a><span class="s1">}</span>
