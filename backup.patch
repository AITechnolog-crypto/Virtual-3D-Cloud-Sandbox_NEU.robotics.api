+<a name="l25"><span class="ln">25   </span></a>            <span class="s1">logger.info(</span><span class="s4">&quot;Keine Trainingsdaten vorhanden.&quot;</span><span class="s1">);</span>
+<a name="l26"><span class="ln">26   </span></a>            <span class="s0">return</span><span class="s1">;</span>
+<a name="l27"><span class="ln">27   </span></a>        <span class="s1">}</span>
+<a name="l28"><span class="ln">28   </span></a>        <span class="s1">logger.info(</span><span class="s4">&quot;Training des maschinellen Lernmodells mit Sensordaten.&quot;</span><span class="s1">);</span>
+<a name="l29"><span class="ln">29   </span></a>        <span class="s0">double </span><span class="s1">sum = </span><span class="s3">0.0</span><span class="s1">;</span>
+<a name="l30"><span class="ln">30   </span></a>        <span class="s0">int </span><span class="s1">n = </span><span class="s3">0</span><span class="s1">;</span>
+<a name="l31"><span class="ln">31   </span></a>        <span class="s0">for </span><span class="s1">(<a href="SensorData.java.html">SensorData</a> d : trainingData) {</span>
+<a name="l32"><span class="ln">32   </span></a>            <span class="s0">if </span><span class="s1">(d == </span><span class="s0">null</span><span class="s1">) </span><span class="s0">continue</span><span class="s1">;</span>
+<a name="l33"><span class="ln">33   </span></a>            <span class="s1">sum += d.getTemperature();</span>
+<a name="l34"><span class="ln">34   </span></a>            <span class="s1">n++;</span>
+<a name="l35"><span class="ln">35   </span></a>        <span class="s1">}</span>
+<a name="l36"><span class="ln">36   </span></a>        <span class="s0">if </span><span class="s1">(n &gt; </span><span class="s3">0</span><span class="s1">) {</span>
+<a name="l37"><span class="ln">37   </span></a>            <span class="s1">averageValue = sum / n;</span>
+<a name="l38"><span class="ln">38   </span></a>            <span class="s1">isTrained = </span><span class="s0">true</span><span class="s1">;</span>
+<a name="l39"><span class="ln">39   </span></a>            <span class="s1">logger.log(Level.FINE, </span><span class="s4">&quot;Durchschnitt berechnet: {0}&quot;</span><span class="s1">, averageValue);</span>
+<a name="l40"><span class="ln">40   </span></a>        <span class="s1">} </span><span class="s0">else </span><span class="s1">{</span>
+<a name="l41"><span class="ln">41   </span></a>            <span class="s1">logger.info(</span><span class="s4">&quot;Keine gültigen Trainingsdatensätze.&quot;</span><span class="s1">);</span>
+<a name="l42"><span class="ln">42   </span></a>        <span class="s1">}</span>
+<a name="l43"><span class="ln">43   </span></a>    <span class="s1">}</span>
