@@ -0,0 +1,212 @@
+// ======================================================
+// NurSystem All-in-One v8 — Swarm + Energie + Abwehr + API (beraterisch)
+// ======================================================
+// - Basierend auf v7 (Ablauf beibehalten), hier als eigenständige Demo umgesetzt
+// - Neu: ApiConnector für externe Intelligenz (OpenAI ODER Azure OpenAI)
+// - Nutzt API-Responses als Beratung/Steuer-Input (rein textuell)
+// - Keine geheimen Schlüssel im Code: Konfiguration über Umgebungsvariablen/System-Properties
+//   OpenAI:
+//     AI_PROVIDER=openai
+//     OPENAI_API_KEY=sk-...
+//     OPENAI_MODEL=gpt-4o-mini   (optional, Default)
+//   Azure OpenAI:
+//     AI_PROVIDER=azure
+//     AZURE_OPENAI_ENDPOINT=https://<ressourcenname>.openai.azure.com
+//     AZURE_OPENAI_DEPLOYMENT=<deploymentName>
+//     AZURE_OPENAI_API_KEY=...
+//     AZURE_OPENAI_API_VERSION=2024-08-01-preview   (optional, Default)
+// ======================================================
+
+package com.june.secureswarm;
+
+import java.net.URI;
+import java.net.http.HttpClient;
+import java.net.http.HttpRequest;
+import java.net.http.HttpResponse;
+import java.net.http.HttpTimeoutException;
+import java.nio.charset.StandardCharsets;
+import java.time.Duration;
+
+// -----------------------------
+// Hauptsystem (standalone Demo – ohne Abhängigkeit auf v7-Klassen)
+// -----------------------------
+public class NurSystemGlobalV8 {
+    public static void main(String[] args) {
+        DemoLogger.log("1) Schwarm starten … (Demo)");
+        DemoLogger.log("2) Energie sammeln (Drohnen) … (Demo)");
+        DemoLogger.log("3) Kühlung aktivieren & Selbstheilung … (Demo)");
+        DemoLogger.log("4) Resonanzabwehr: Scan & Absorption … (Demo)");
+
+        // 5) API‑Abfrage für strategische Beratung (rein textuell, defensiv)
+        ApiConnector api = new ApiConnector();
+        String advisory = api.query("Analysiere Energiestatus und gib Empfehlungen für defensive Verstärkung.");
+        System.out.println("\uD83C\uDF10 API Advisory: " + advisory);
+
+        DemoLogger.log("6) Rückspeisung gespeicherter Energie an Stichprobe … (Demo)");
+        DemoLogger.log("7) Reflexionstest: 'Laserstrahl' & 'Feindliche KI' … (Demo)");
+        DemoLogger.log("8) Ethik‑Gate prüfen … (Demo)");
+        DemoLogger.log("9) Security‑Playbook anwenden & Dashboard aktualisieren … (Demo)");
+
+        System.out.println("NurSystemGlobalV8: Zyklus abgeschlossen (Demo).");
+    }
+}
+
+// Mini‑Logger für die Demo‑Abläufe
+class DemoLogger {
+    static void log(String msg){ System.out.println("[NurSystemV8] " + msg); }
+}
+
+// ======================================================
+// API Connector (OpenAI ODER Azure OpenAI)
+// ======================================================
+class ApiConnector {
+    private final HttpClient http = HttpClient.newBuilder()
+            .connectTimeout(Duration.ofSeconds(12))
+            .build();
+
+    public String query(String userPrompt) {
+        String provider = getEnvOrProp("AI_PROVIDER", "openai").trim().toLowerCase();
+        try {
+            if ("azure".equals(provider)) {
+                return doAzureOpenAI(userPrompt);
+            } else {
+                return doOpenAI(userPrompt);
+            }
+        } catch (HttpTimeoutException te) {
+            return "⚠️ API Timeout: " + te.getMessage();
+        } catch (Exception e) {
+            return "⚠️ API Fehler: " + e.getMessage();
+        }
+    }
+
+    // -------- OpenAI (public endpoint) --------
+    private String doOpenAI(String prompt) throws Exception {
+        String apiKey = getEnvOrProp("OPENAI_API_KEY", null);
+        if (isBlank(apiKey)) {
+            return missingConfig("OPENAI_API_KEY");
+        }
+        String model = getEnvOrProp("OPENAI_MODEL", "gpt-4o-mini");
+        String body = "{" +
+                quote("model") + ":" + quote(model) + "," +
+                quote("messages") + ":[{" + quote("role") + ":" + quote("user") + "," + quote("content") + ":" + quote(escape(prompt)) + "}]" +
+                "}";
+
+        HttpRequest req = HttpRequest.newBuilder()
+                .uri(URI.create("https://api.openai.com/v1/chat/completions"))
+                .timeout(Duration.ofSeconds(20))
+                .header("Content-Type", "application/json")
+                .header("Authorization", "Bearer " + apiKey)
+                .header("User-Agent", "NurSystemGlobalV8/1.0")
+                .POST(HttpRequest.BodyPublishers.ofString(body, StandardCharsets.UTF_8))
+                .build();
+        HttpResponse<String> resp = http.send(req, HttpResponse.BodyHandlers.ofString(StandardCharsets.UTF_8));
+        if (resp.statusCode() / 100 != 2) {
+            return "⚠️ OpenAI HTTP " + resp.statusCode() + ": " + safeTrim(resp.body());
+        }
+        return extractAssistantText(resp.body());
+    }
+
+    // -------- Azure OpenAI --------
+    private String doAzureOpenAI(String prompt) throws Exception {
+        String endpoint = trimTrailingSlash(getEnvOrProp("AZURE_OPENAI_ENDPOINT", null));
+        String deployment = getEnvOrProp("AZURE_OPENAI_DEPLOYMENT", null);
+        String apiKey = getEnvOrProp("AZURE_OPENAI_API_KEY", null);
+        String apiVersion = getEnvOrProp("AZURE_OPENAI_API_VERSION", "2024-08-01-preview");
+        if (isBlank(endpoint) || isBlank(deployment) || isBlank(apiKey)) {
+            return missingConfig("AZURE_OPENAI_ENDPOINT / AZURE_OPENAI_DEPLOYMENT / AZURE_OPENAI_API_KEY");
+        }
+        String url = endpoint + "/openai/deployments/" + urlEncode(deployment) + "/chat/completions?api-version=" + urlEncode(apiVersion);
+        String body = "{" +
+                quote("messages") + ":[{" + quote("role") + ":" + quote("user") + "," + quote("content") + ":" + quote(escape(prompt)) + "}]" +
+                "}";
+
+        HttpRequest req = HttpRequest.newBuilder()
+                .uri(URI.create(url))
+                .timeout(Duration.ofSeconds(20))
+                .header("Content-Type", "application/json")
+                .header("api-key", apiKey)
+                .header("User-Agent", "NurSystemGlobalV8/1.0")
+                .POST(HttpRequest.BodyPublishers.ofString(body, StandardCharsets.UTF_8))
+                .build();
+        HttpResponse<String> resp = http.send(req, HttpResponse.BodyHandlers.ofString(StandardCharsets.UTF_8));
+        if (resp.statusCode() / 100 != 2) {
+            return "⚠️ Azure OpenAI HTTP " + resp.statusCode() + ": " + safeTrim(resp.body());
+        }
+        return extractAssistantText(resp.body());
+    }
+
+    // -------- Helpers --------
+    private static String extractAssistantText(String json) {
+        // Defensive, dependency‑free mini‑parser: versucht content‑Feld zu finden.
+        if (json == null || json.isEmpty()) return "(leere Antwort)";
+        // 1) Versuche OpenAI‑ähnliche Struktur: choices[0].message.content
+        int idx = json.indexOf("\"message\"");
+        if (idx >= 0) {
+            int cidx = json.indexOf("\"content\"", idx);
+            if (cidx >= 0) {
+                int colon = json.indexOf(':', cidx);
+                if (colon >= 0) {
+                    String tail = json.substring(colon + 1).trim();
+                    String val = readJsonStringValue(tail);
+                    if (!isBlank(val)) return val;
+                }
+            }
+        }
+        // 2) Fallback: "content":"..." erstes Auftreten
+        int c = json.indexOf("\"content\"");
+        if (c >= 0) {
+            int colon = json.indexOf(':', c);
+            if (colon >= 0) {
+                String tail = json.substring(colon + 1).trim();
+                String val = readJsonStringValue(tail);
+                if (!isBlank(val)) return val;
+            }
+        }
+        // 3) Letzter Fallback: gib gekürzten JSON‑Body zurück
+        return safeTrim(json);
+    }
+
+    private static String readJsonStringValue(String s) {
+        // Erwartet einen JSON‑String (beginnend mit \"), retourniert entschärften Inhalt.
+        if (s == null) return null;
+        int firstQuote = s.indexOf('"');
+        if (firstQuote < 0) return null;
+        String rest = s.substring(firstQuote + 1);
+        StringBuilder out = new StringBuilder();
+        boolean esc = false;
+        for (int i = 0; i < rest.length(); i++) {
+            char ch = rest.charAt(i);
+            if (esc) {
+                // einfache Escape‑Behandlung
+                if (ch == '"' || ch == '\\' || ch == '/') out.append(ch);
+                else if (ch == 'b') out.append('\b');
+                else if (ch == 'f') out.append('\f');
+                else if (ch == 'n') out.append('\n');
+                else if (ch == 'r') out.append('\r');
+                else if (ch == 't') out.append('\t');
+                else out.append(ch);
+                esc = false;
+            } else {
+                if (ch == '\\') { esc = true; }
+                else if (ch == '"') { break; }
+                else { out.append(ch); }
+            }
+        }
+        return out.toString().trim();
+    }
+
+    private static String quote(String s) { return '"' + s + '"'; }
+    private static String escape(String s) { return s == null ? "" : s.replace("\\", "\\\\").replace("\"", "\\\""); }
+    private static String urlEncode(String s) { try { return java.net.URLEncoder.encode(s, StandardCharsets.UTF_8); } catch (Exception e) { return s; } }
+    private static String safeTrim(String s) { if (s == null) return ""; s = s.trim(); return s.length() > 600 ? s.substring(0, 600) + "…" : s; }
+    private static String trimTrailingSlash(String s){ if (s==null) return null; while (s.endsWith("/")) s=s.substring(0, s.length()-1); return s; }
+    private static boolean isBlank(String s){ return s == null || s.trim().isEmpty(); }
+    private static String getEnvOrProp(String key, String def){
+        String v = System.getenv(key);
+        if (v == null) v = System.getProperty(key);
+        return v == null ? def : v;
+    }
+    private static String missingConfig(String keys){
+        return "⚠️ API nicht konfiguriert. Bitte setzen: " + keys + ". (AI_PROVIDER=openai|azure)";
+    }
+}
