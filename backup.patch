+<a name="l9"><span class="ln">9    </span></a><span class="s2">server.port</span><span class="s1">=</span><span class="s3">8080</span>
+<a name="l10"><span class="ln">10   </span></a>
+<a name="l11"><span class="ln">11   </span></a><span class="s0"># H2 Database (In-Memory)</span>
+<a name="l12"><span class="ln">12   </span></a><span class="s2">spring.datasource.url</span><span class="s1">=</span><span class="s3">jdbc:h2:mem:infrastructuredb</span>
+<a name="l13"><span class="ln">13   </span></a><span class="s2">spring.datasource.driverClassName</span><span class="s1">=</span><span class="s3">org.h2.Driver</span>
+<a name="l14"><span class="ln">14   </span></a><span class="s2">spring.datasource.username</span><span class="s1">=</span><span class="s3">admin</span>
+<a name="l15"><span class="ln">15   </span></a><span class="s2">spring.datasource.password</span><span class="s1">=</span><span class="s3">admin123</span>
+<a name="l16"><span class="ln">16   </span></a>
+<a name="l17"><span class="ln">17   </span></a><span class="s0"># JPA/Hibernate</span>
+<a name="l18"><span class="ln">18   </span></a><span class="s2">spring.jpa.database-platform</span><span class="s1">=</span><span class="s3">org.hibernate.dialect.H2Dialect</span>
+<a name="l19"><span class="ln">19   </span></a><span class="s2">spring.jpa.hibernate.ddl-auto</span><span class="s1">=</span><span class="s3">create-drop</span>
+<a name="l20"><span class="ln">20   </span></a><span class="s2">spring.jpa.show-sql</span><span class="s1">=</span><span class="s3">true</span>
+<a name="l21"><span class="ln">21   </span></a><span class="s2">spring.jpa.properties.hibernate.format_sql</span><span class="s1">=</span><span class="s3">true</span>
+<a name="l22"><span class="ln">22   </span></a>
+<a name="l23"><span class="ln">23   </span></a><span class="s0"># H2 Console</span>
+<a name="l24"><span class="ln">24   </span></a><span class="s2">spring.h2.console.enabled</span><span class="s1">=</span><span class="s3">true</span>
+<a name="l25"><span class="ln">25   </span></a><span class="s2">spring.h2.console.path</span><span class="s1">=</span><span class="s3">/h2-console</span>
+<a name="l26"><span class="ln">26   </span></a><span class="s2">spring.h2.console.settings.web-allow-others</span><span class="s1">=</span><span class="s3">true</span>
