+      '</div>',
+      '<div style="display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:10px;margin-top:10px">',
+      '  <div><div class="small muted">Compute‑Auslastung</div><div id="ifU1" class="card-value" style="font-size:1.2rem">–%</div></div>',
+      '  <div><div class="small muted">Storage‑Auslastung</div><div id="ifU2" class="card-value" style="font-size:1.2rem">–%</div></div>',
+      '  <div><div class="small muted">Netz‑Auslastung</div><div id="ifU3" class="card-value" style="font-size:1.2rem">–%</div></div>',
+      '</div>'
+    ].join('');
+
+    const c = card('🏗️ Infrastruktur Kapazität & Auslastung', inner);
+    addCard(c);
+
+    const q = s=>c.querySelector(s);
+    const els = {
+      nodes: q('#ifNodes'), nodesV: q('#ifNodesV'),
+      storage: q('#ifStorage'), storageV: q('#ifStorageV'),
+      net: q('#ifNet'), netV: q('#ifNetV'),
+      drones: q('#ifDrones'), dronesV: q('#ifDronesV'),
