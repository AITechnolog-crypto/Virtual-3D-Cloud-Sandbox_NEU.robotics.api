+<a name="l28"><span class="ln">28   </span></a><span class="s0"># Logging</span>
+<a name="l29"><span class="ln">29   </span></a><span class="s2">logging.level.com.june</span><span class="s1">=</span><span class="s3">DEBUG</span>
+<a name="l30"><span class="ln">30   </span></a><span class="s2">logging.level.org.springframework.web</span><span class="s1">=</span><span class="s3">INFO</span>
+<a name="l31"><span class="ln">31   </span></a><span class="s2">logging.level.org.hibernate</span><span class="s1">=</span><span class="s3">INFO</span>
+<a name="l32"><span class="ln">32   </span></a><span class="s2">logging.pattern.console</span><span class="s1">=</span><span class="s3">%d{HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n</span>
+<a name="l33"><span class="ln">33   </span></a>
+<a name="l34"><span class="ln">34   </span></a><span class="s0"># Static Resources</span>
+<a name="l35"><span class="ln">35   </span></a><span class="s2">spring.web.resources.static-locations</span><span class="s1">=</span><span class="s3">classpath:/static/</span>
+<a name="l36"><span class="ln">36   </span></a>
+<a name="l37"><span class="ln">37   </span></a><span class="s0"># CORS</span>
+<a name="l38"><span class="ln">38   </span></a><span class="s2">spring.web.cors.allowed-origins</span><span class="s1">=</span><span class="s3">*</span>
+<a name="l39"><span class="ln">39   </span></a><span class="s2">spring.web.cors.allowed-methods</span><span class="s1">=</span><span class="s3">GET,POST,PUT,DELETE,OPTIONS</span>
+<a name="l40"><span class="ln">40   </span></a><span class="s2">spring.web.cors.allowed-headers</span><span class="s1">=</span><span class="s3">*</span>
+<a name="l41"><span class="ln">41   </span></a>
+<a name="l42"><span class="ln">42   </span></a><span class="s0"># WebSocket</span>
+<a name="l43"><span class="ln">43   </span></a><span class="s2">spring.websocket.allowed-origins</span><span class="s1">=</span><span class="s3">*</span>
+<a name="l44"><span class="ln">44   </span></a>
+<a name="l45"><span class="ln">45   </span></a><span class="s0"># Scheduling</span>
