+    };
+
+    function load(){
+      const ls = localStorage;
+      els.nodes.value = ls.getItem('infra.nodes')||'24';
+      els.storage.value = ls.getItem('infra.storageTB')||'480';
+      els.net.value = ls.getItem('infra.netGbps')||'320';
+      els.drones.value = ls.getItem('infra.drones')|| (document.getElementById('droneCount')?.textContent||'1200');
+      els.robots.value = ls.getItem('infra.robots')|| (document.getElementById('robotCount')?.textContent||'2');
+      updateLabels();
+    }
+    function save(){
+      const ls = localStorage;
+      ls.setItem('infra.nodes', String(els.nodes.value));
+      ls.setItem('infra.storageTB', String(els.storage.value));
+      ls.setItem('infra.netGbps', String(els.net.value));
+      ls.setItem('infra.drones', String(els.drones.value));
+      ls.setItem('infra.robots', String(els.robots.value));
+    }
+    function updateLabels(){
+      els.nodesV.textContent = els.nodes.value + ' Knoten';
+      els.storageV.textContent = els.storage.value + ' TB';
+      els.netV.textContent = els.net.value + ' Gbps';
+      els.dronesV.textContent = els.drones.value;
+      els.robotsV.textContent = els.robots.value;
+    }
+    function utilization(){
+      // Einfach: aktuelle Werte im UI vs. Kapazität (hier als 70% baseline plus Rauschen simuliert)
+      const base = 0.7, r=()=> (base + (Math.random()-0.5)*0.1);
+      els.u1.textContent = Math.round(clamp(r()*100,0,100)) + '%';
+      els.u2.textContent = Math.round(clamp(r()*100,0,100)) + '%';
