+  window.addEventListener('DOMContentLoaded', ()=> addCard(card));
+
+  const API_BASE = window.location.origin + '/api';
+  let es;
+  function connectSSE(){
+    try{
+      es = new EventSource(API_BASE + '/telemetry/stream');
+      document.getElementById('liveHint').textContent = 'Verbunden (SSE)';
+      es.addEventListener('snapshot', (e)=> update(JSON.parse(e.data)));
+      es.addEventListener('update', (e)=> update(JSON.parse(e.data)));
+      es.onerror = ()=>{ document.getElementById('liveHint').textContent = 'SSE getrennt – Fallback Polling'; es.close(); startPolling(); };
