+<html>
+<head>
+<title>NurSystemGlobal.java</title>
+<meta http-equiv="Content-Type" content="text/html; charset=utf-8">
+<style type="text/css">
+.s0 { color: #808080;}
+.s1 { color: #afb9c3;}
+.s2 { color: #c88cdc;}
+.s3 { color: #36beff;}
