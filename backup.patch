+<a name="l160"><span class="ln">160  </span></a>      <span class="s8">if </span><span class="s0">(stream) stream.getTracks().forEach(t=&gt;t.stop())</span>
+<a name="l161"><span class="ln">161  </span></a>      <span class="s0">stream = await navigator.mediaDevices.getUserMedia({</span>
+<a name="l162"><span class="ln">162  </span></a>        <span class="s0">video: { facingMode: facing, width:{ideal:</span><span class="s4">1920</span><span class="s0">}, height:{ideal:</span><span class="s4">1080</span><span class="s0">} },</span>
