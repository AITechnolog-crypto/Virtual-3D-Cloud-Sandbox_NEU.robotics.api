+<script>
+// Kombiniere die letzten 5 Apps zu einer Karte mit Tabs
+(function(){
+  function bySel(root, sel){ return Array.prototype.slice.call(root.querySelectorAll(sel)); }
+  function textOf(el){ return (el && el.textContent || '').trim(); }
+  function makeEl(tag, cls, html){ var e=document.createElement(tag); if(cls) e.className=cls; if(html!=null) e.innerHTML=html; return e; }
+
+  function combineLastFive(){
+    try{
+      var grid = document.querySelector('.dashboard-grid');
+      if (!grid) return;
+      var cards = bySel(grid, ':scope > .card');
+      if (!cards || cards.length < 5) return; // zu wenig Karten – nichts tun
+
+      // Nimm die letzten 5 Karten
+      var lastFive = cards.slice(-5);
+      var firstOfFive = lastFive[0];
+
+      // Erzeuge kombinierte Karte
+      var combined = makeEl('div', 'card');
+      combined.id = 'combined-last-five';
+      var titleBar = makeEl('div', 'card-title');
+      titleBar.style.display='flex';
+      titleBar.style.alignItems='center';
+      titleBar.style.justifyContent='space-between';
+
+      var titleLeft = makeEl('div', '', '🔗 Kombinierte Apps (5)');
+      var actions = makeEl('div');
+      var restoreBtn = makeEl('button', 'btn', 'Entkoppeln');
+      restoreBtn.title = 'Apps wieder als einzelne Karten anzeigen';
+      actions.appendChild(restoreBtn);
+      titleBar.appendChild(titleLeft);
+      titleBar.appendChild(actions);
+
+      var tabs = makeEl('div');
+      tabs.style.display='flex';
+      tabs.style.gap='8px';
+      tabs.style.flexWrap='wrap';
+      tabs.style.margin='6px 0 8px 0';
+
+      var panels = makeEl('div');
+      panels.style.borderTop='1px solid rgba(255,255,255,0.08)';
+      panels.style.marginTop='6px';
+      panels.style.paddingTop='8px';
+
+      combined.appendChild(titleBar);
+      combined.appendChild(tabs);
+      combined.appendChild(panels);
+
+      // Erzeuge Tabs und verschiebe die Karten als Panels hinein
+      var originalPositions = [];
+      lastFive.forEach(function(card, idx){
+        // Titel extrahieren
+        var t = textOf(card.querySelector('.card-title')) || ('App '+(idx+1));
+        var btn = makeEl('button', 'btn', t);
+        btn.style.padding='8px 12px';
+        btn.style.fontSize='.9rem';
+        btn.dataset.tab = String(idx);
+        tabs.appendChild(btn);
+
+        var panel = makeEl('div');
+        panel.dataset.panel = String(idx);
+        panel.style.display = idx===0? 'block' : 'none';
+        // Merke ursprüngliche Position, um wiederherstellen zu können
+        originalPositions.push({ parent:grid, next: card.nextSibling });
+        // Karte in Panel verschieben (verschieben erhält Event-Listener)
+        panel.appendChild(card);
+        // Entferne Kartentitel innerhalb des Panels, da Tabs den Titel zeigen
+        var innerTitle = card.querySelector('.card-title');
+        if (innerTitle) innerTitle.style.display='none';
+        // Passe card-in-card Abstände minimal an
+        card.style.margin='0';
+        panels.appendChild(panel);
+      });
+
+      // Aktive Tab Umschaltung
+      function activate(i){
+        bySel(panels,'[data-panel]').forEach(function(p){ p.style.display = (p.dataset.panel===String(i))? 'block':'none'; });
+        bySel(tabs,'button').forEach(function(b){ b.style.opacity = (b.dataset.tab===String(i))? '1':'0.6'; });
+      }
+      tabs.addEventListener('click', function(e){
+        var b = e.target.closest('button'); if(!b) return; activate(b.dataset.tab);
+      });
+
+      // Entkoppeln: Panels zurück ins Grid verschieben
+      restoreBtn.addEventListener('click', function(){
+        try{
+          var toRestore = bySel(panels,'[data-panel] > .card');
+          toRestore.forEach(function(card, i){
+            var pos = originalPositions[i] || { parent:grid, next:null };
+            // Titel wieder einblenden
+            var innerTitle = card.querySelector('.card-title');
+            if (innerTitle) innerTitle.style.display='';
+            card.style.margin='';
+            pos.parent.insertBefore(card, pos.next);
+          });
+          combined.remove();
+        }catch(_){}
+      });
+
+      // Kombinierte Karte im Grid an der Position der ersten Karte einfügen
+      grid.insertBefore(combined, firstOfFive);
+    }catch(e){ /* no-op */ }
+  }
+
+  // Warten bis DOM steht – dann kombinieren
+  if (document.readyState === 'loading'){
+    document.addEventListener('DOMContentLoaded', function(){ setTimeout(combineLastFive, 50); });
+  } else {
+    setTimeout(combineLastFive, 50);
+  }
+})();
+</script>
