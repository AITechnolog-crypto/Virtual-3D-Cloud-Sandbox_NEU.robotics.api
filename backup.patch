+<a name="l554"><span class="ln">554  </span></a>                <span class="s1">st.solar.execute(dec.ep, st.flags.kopplung);</span>
+<a name="l555"><span class="ln">555  </span></a>
+<a name="l556"><span class="ln">556  </span></a>                <span class="s2">// Kleine Reinvest durch simulierte Solar-Überschüsse</span>
+<a name="l557"><span class="ln">557  </span></a>                <span class="s1">st.silos.addEnergy(</span><span class="s4">5</span><span class="s1">); st.silos.addWater(</span><span class="s4">20</span><span class="s1">);</span>
+<a name="l558"><span class="ln">558  </span></a>
+<a name="l559"><span class="ln">559  </span></a>                <span class="s2">// Aid: periodisch</span>
+<a name="l560"><span class="ln">560  </span></a>                <span class="s0">if</span><span class="s1">((System.currentTimeMillis()/</span><span class="s4">1000</span><span class="s1">)%</span><span class="s4">7</span><span class="s1">==</span><span class="s4">0</span><span class="s1">){</span>
+<a name="l561"><span class="ln">561  </span></a>                    <span class="s0">new </span><span class="s1">AidRouter(st.equity, st.silos, st.wOps).waterAid(</span><span class="s4">160</span><span class="s1">, </span><span class="s4">0.28</span><span class="s1">);</span>
+<a name="l562"><span class="ln">562  </span></a>                <span class="s1">}</span>
+<a name="l563"><span class="ln">563  </span></a>
+<a name="l564"><span class="ln">564  </span></a>                <span class="s1">st.cloud.maybeSync();</span>
+<a name="l565"><span class="ln">565  </span></a>                <span class="s1">Snapshot.write(st);</span>
+<a name="l566"><span class="ln">566  </span></a>
+<a name="l567"><span class="ln">567  </span></a>                <span class="s1">LOG.info(String.format(Locale.US,</span><span class="s3">&quot;Silos water=%.0fL energy=%.0f grain=%.0fkg | wallets owner=%s ops=%s aid=%s&quot;</span><span class="s1">,</span>
+<a name="l568"><span class="ln">568  </span></a>                        <span class="s1">st.silos.waterLiters, st.silos.energyUnits, st.silos.grainKg,</span>
+<a name="l569"><span class="ln">569  </span></a>                        <span class="s1">money(st.wOwner.getTotal()), money(st.wOps.getTotal()), money(st.wAid.getTotal())));</span>
+<a name="l570"><span class="ln">570  </span></a>            <span class="s1">}</span><span class="s0">catch</span><span class="s1">(Exception e){ LOG.log(Level.SEVERE,</span><span class="s3">&quot;tick error&quot;</span><span class="s1">, e); }</span>
+<a name="l571"><span class="ln">571  </span></a>        <span class="s1">}, </span><span class="s4">0</span><span class="s1">, </span><span class="s4">1200</span><span class="s1">, TimeUnit.MILLISECONDS);</span>
+<a name="l572"><span class="ln">572  </span></a>
+<a name="l573"><span class="ln">573  </span></a>        <span class="s2">// Entrepreneur-Verkaufsloop (Kundenbindung + Finance Routing)</span>
+<a name="l574"><span class="ln">574  </span></a>        <span class="s1">ses.scheduleAtFixedRate(()-&gt;{</span>
+<a name="l575"><span class="ln">575  </span></a>            <span class="s0">try</span><span class="s1">{</span>
+<a name="l576"><span class="ln">576  </span></a>                <span class="s2">// Kunde (bestehender oder neuer)</span>
+<a name="l577"><span class="ln">577  </span></a>                <span class="s1">Customer buyer = st.crm.upsertRandom();</span>
+<a name="l578"><span class="ln">578  </span></a>
+<a name="l579"><span class="ln">579  </span></a>                <span class="s2">// Produkt wählen</span>
+<a name="l580"><span class="ln">580  </span></a>                <span class="s1">Offer offer = st.market.offers.values().stream().filter(o-&gt;o.name.equals(</span><span class="s3">&quot;Wheat&quot;</span><span class="s1">) &amp;&amp; o.stockKg&gt;</span><span class="s4">0</span><span class="s1">).findFirst().orElse(</span><span class="s0">null</span><span class="s1">);</span>
+<a name="l581"><span class="ln">581  </span></a>                <span class="s0">if</span><span class="s1">(offer==</span><span class="s0">null</span><span class="s1">) </span><span class="s0">return</span><span class="s1">;</span>
+<a name="l582"><span class="ln">582  </span></a>
+<a name="l583"><span class="ln">583  </span></a>                <span class="s2">// Menge abhängig vom Lager</span>
+<a name="l584"><span class="ln">584  </span></a>                <span class="s0">int </span><span class="s1">burst=(</span><span class="s0">int</span><span class="s1">)Math.min(</span><span class="s4">500</span><span class="s1">, Math.max(</span><span class="s4">0</span><span class="s1">, offer.stockKg - </span><span class="s4">600</span><span class="s1">));</span>
+<a name="l585"><span class="ln">585  </span></a>                <span class="s0">if</span><span class="s1">(burst&lt;=</span><span class="s4">0</span><span class="s1">) </span><span class="s0">return</span><span class="s1">;</span>
+<a name="l586"><span class="ln">586  </span></a>
+<a name="l587"><span class="ln">587  </span></a>                <span class="s2">// Grain aus physischem Silo abziehen (sim Aggregation)</span>
+<a name="l588"><span class="ln">588  </span></a>                <span class="s0">if</span><span class="s1">(!st.silos.useGrain(burst)) </span><span class="s0">return</span><span class="s1">;</span>
+<a name="l589"><span class="ln">589  </span></a>
+<a name="l590"><span class="ln">590  </span></a>                <span class="s0">double </span><span class="s1">revenue = st.market.sell(offer, burst, buyer, st.equity, st.reg, st.flags.marketing, st.orders);</span>
+<a name="l591"><span class="ln">591  </span></a>                <span class="s0">double </span><span class="s1">opsCost = revenue * </span><span class="s4">0.15</span><span class="s1">;</span>
+<a name="l592"><span class="ln">592  </span></a>                <span class="s1">st.payments.route(revenue, opsCost);</span>
+<a name="l593"><span class="ln">593  </span></a>
+<a name="l594"><span class="ln">594  </span></a>            <span class="s1">}</span><span class="s0">catch</span><span class="s1">(Exception e){ LOG.log(Level.WARNING,</span><span class="s3">&quot;entrepreneur loop error&quot;</span><span class="s1">, e); }</span>
+<a name="l595"><span class="ln">595  </span></a>        <span class="s1">}, </span><span class="s4">1000</span><span class="s1">, </span><span class="s4">2000</span><span class="s1">, TimeUnit.MILLISECONDS);</span>
+<a name="l596"><span class="ln">596  </span></a>
+<a name="l597"><span class="ln">597  </span></a>        <span class="s1">LOG.info(</span><span class="s3">&quot;Engine läuft. Ctrl+C zum Beenden. Snapshots in ./data/state.json&quot;</span><span class="s1">);</span>
+<a name="l598"><span class="ln">598  </span></a>        <span class="s1">Runtime.getRuntime().addShutdownHook(</span><span class="s0">new </span><span class="s1">Thread(()-&gt;{</span>
+<a name="l599"><span class="ln">599  </span></a>            <span class="s0">try</span><span class="s1">{ ses.shutdownNow(); }</span><span class="s0">catch</span><span class="s1">(Exception ignored){}</span>
+<a name="l600"><span class="ln">600  </span></a>            <span class="s1">System.out.println(</span><span class="s3">&quot;</span><span class="s5">\n</span><span class="s3">Shutdown ok.&quot;</span><span class="s1">);</span>
+<a name="l601"><span class="ln">601  </span></a>        <span class="s1">}));</span>
+<a name="l602"><span class="ln">602  </span></a>        <span class="s1">Thread.currentThread().join();</span>
+<a name="l603"><span class="ln">603  </span></a>    <span class="s1">}</span>
+<a name="l604"><span class="ln">604  </span></a><span class="s1">}</span>
+<a name="l605"><span class="ln">605  </span></a></pre>
+</body>
+</html>
