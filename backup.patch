+
+    // Restore cfg/notes
+    const cfg = Object.assign({ price:0.18, sell:60, cost:15 }, loadCfg());
+    elPrice.value = cfg.price;
+    elSell.value  = cfg.sell;
+    elCost.value  = cfg.cost;
+    elNotes.value = loadNotes();
+
+    function update(){
+      const E = Number(currentEnergyKWh())||0;
+      const price = Math.max(0, parseFloat(elPrice.value)||0);
+      const sell  = Math.max(0, Math.min(100, parseFloat(elSell.value)||0))/100.0;
+      const costR = Math.max(0, Math.min(100, parseFloat(elCost.value)||0))/100.0;
+      const gross = E * price * sell;
+      const costA = gross * costR;
+      const net   = Math.max(0, gross - costA);
+      elE.textContent = (isFinite(E)? E.toLocaleString('de-DE') : '–') + ' kWh';
+      elG.textContent = fmtEUR(gross) + ' EUR';
+      elC.textContent = fmtEUR(costA) + ' EUR';
+      elN.textContent = fmtEUR(net)   + ' EUR';
+    }
+
+    function persist(){ saveCfg({ price:parseFloat(elPrice.value)||0, sell:parseFloat(elSell.value)||0, cost:parseFloat(elCost.value)||0 }); }
+
+    elPrice.addEventListener('input', ()=>{ persist(); update(); });
+    elSell .addEventListener('input', ()=>{ persist(); update(); });
+    elCost .addEventListener('input', ()=>{ persist(); update(); });
+    elNotes.addEventListener('input', ()=>{ saveNotes(elNotes.value); });
+
+    card.querySelector('#fw_stampBtn').addEventListener('click', ()=>{
+      const ts = new Date();
+      const txt = 'Stempel • '+ts.toLocaleString('de-DE')+' • Preis='+elPrice.value+' EUR/kWh, Verkauf='+elSell.value+'%, Kosten='+elCost.value+'%';
