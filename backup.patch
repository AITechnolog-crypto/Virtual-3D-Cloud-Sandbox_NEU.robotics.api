+<a name="l397"><span class="ln">397  </span></a>  <span class="s8">// Energieverbrauch ~ einfache Näherung</span>
+<a name="l398"><span class="ln">398  </span></a>  <span class="s7">let </span><span class="s0">ghz = state.vcpu.on? state.vcpu.turbo : state.vcpu.base;</span>
+<a name="l399"><span class="ln">399  </span></a>  <span class="s7">let </span><span class="s0">watts = (</span><span class="s6">20 </span><span class="s0">+ state.vcpu.cores*ghz*</span><span class="s6">0.9</span><span class="s0">) * (</span><span class="s6">0.4 </span><span class="s0">+ </span><span class="s6">0.6</span><span class="s0">*state.vcpu.load);</span>
+<a name="l400"><span class="ln">400  </span></a>  <span class="s8">// Ziehe aus Solar/Plasma</span>
+<a name="l401"><span class="ln">401  </span></a>  <span class="s7">let </span><span class="s0">need = watts / </span><span class="s6">25</span><span class="s0">; </span><span class="s8">// scale</span>
+<a name="l402"><span class="ln">402  </span></a>  <span class="s7">const </span><span class="s0">pool = state.energy.solar + state.energy.plasma;</span>
+<a name="l403"><span class="ln">403  </span></a>  <span class="s7">if</span><span class="s0">(pool &lt; need){ state.vcpu.on=</span><span class="s7">false</span><span class="s0">; ghz=state.vcpu.base*</span><span class="s6">0.7</span><span class="s0">; state.vcpu.load=Math.min(state.vcpu.load,</span><span class="s6">0.6</span><span class="s0">); }</span>
+<a name="l404"><span class="ln">404  </span></a>  <span class="s8">// „spend“</span>
+<a name="l405"><span class="ln">405  </span></a>  <span class="s7">const </span><span class="s0">ratio = pool? state.energy.solar/pool : </span><span class="s6">0.5</span><span class="s0">;</span>
+<a name="l406"><span class="ln">406  </span></a>  <span class="s0">state.energy.solar = clamp(state.energy.solar - need*ratio, </span><span class="s6">0</span><span class="s0">, </span><span class="s6">100</span><span class="s0">);</span>
+<a name="l407"><span class="ln">407  </span></a>  <span class="s0">state.energy.plasma= clamp(state.energy.plasma - need*(</span><span class="s6">1</span><span class="s0">-ratio), </span><span class="s6">0</span><span class="s0">, </span><span class="s6">100</span><span class="s0">);</span>
+<a name="l408"><span class="ln">408  </span></a>  <span class="s8">// Temp &amp; Ops</span>
+<a name="l409"><span class="ln">409  </span></a>  <span class="s0">state.vcpu.temp = clamp(state.vcpu.temp + (watts*</span><span class="s6">0.02</span><span class="s0">) - (state.energy.lev*</span><span class="s6">0.01</span><span class="s0">), </span><span class="s6">28</span><span class="s0">, </span><span class="s6">95</span><span class="s0">);</span>
+<a name="l410"><span class="ln">410  </span></a>  <span class="s7">if</span><span class="s0">(state.vcpu.temp&gt;</span><span class="s6">82</span><span class="s0">){ state.vcpu.on=</span><span class="s7">false</span><span class="s0">; state.vcpu.load=Math.min(state.vcpu.load,</span><span class="s6">0.7</span><span class="s0">); }</span>
+<a name="l411"><span class="ln">411  </span></a>  <span class="s0">state.vcpu.ops = state.vcpu.cores*ghz*</span><span class="s6">1000</span><span class="s0">*state.vcpu.load;</span>
+<a name="l412"><span class="ln">412  </span></a>  <span class="s0">ui.sync();</span>
+<a name="l413"><span class="ln">413  </span></a><span class="s0">}, </span><span class="s6">250</span><span class="s0">);</span>
+<a name="l414"><span class="ln">414  </span></a>
