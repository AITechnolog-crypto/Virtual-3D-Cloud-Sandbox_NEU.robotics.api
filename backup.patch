+  function panel(title, inner){ const s=document.createElement('section'); s.className='panel'; s.innerHTML='<h2>'+title+'</h2>'+inner; return s; }
+  function esc(s){ return String(s||'').replace(/[&<>]/g,m=>({"&":"&amp;","<":"&lt;",">":"&gt;"}[m])); }
+
+  function mount(){
+    if (!window.SaaS){ return; }
+    const inner = [
+      '<p class="small muted">Verbinde deine Azure Functions Funktions‑App (HTTP Trigger). BASE/Token werden nur lokal gespeichert.</p>',
