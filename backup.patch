+<a name="l53"><span class="ln">53   </span></a>        <span class="s0">return new <a href="Prediction.java.html">Prediction</a></span><span class="s1">(averageValue, </span><span class="s3">0.6</span><span class="s1">);</span>
+<a name="l54"><span class="ln">54   </span></a>    <span class="s1">}</span>
+<a name="l55"><span class="ln">55   </span></a><span class="s1">}</span>
