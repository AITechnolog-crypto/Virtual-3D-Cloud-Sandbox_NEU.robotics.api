+<!-- Cloud Ressourcen & Finanzen + Infrastruktur Kapazität (additive) -->
+<script>
+(function(){
+  function addCard(el){ const grid=document.querySelector('.dashboard-grid'); if(!grid) return; grid.appendChild(el); }
+  function card(title, inner){ const d=document.createElement('div'); d.className='card'; d.innerHTML='<div class="card-title">'+title+'</div>'+inner; return d; }
+  function fmtEUR(n){ try{ return Number(n||0).toLocaleString('de-DE',{minimumFractionDigits:2,maximumFractionDigits:2}); }catch(e){ return String(n); } }
+  function clamp(v,a,b){ return Math.max(a, Math.min(b, v)); }
+
+  // 1) Cloud Ressourcen & Finanzen (Live)
+  function mountFinance(){
+    const inner = [
+      '<div class="small muted">Live‑Überblick deiner virtuellen Cloud: Ressourcen und Geldflüsse. Werte sind lokal konfigurier‑ und simulierbar.</div>',
