+<a name="l167"><span class="ln">167  </span></a>      <span class="s0">fit()</span>
+<a name="l168"><span class="ln">168  </span></a>      <span class="s0">gate.style.display = </span><span class="s3">'none'</span>
+<a name="l169"><span class="ln">169  </span></a>      <span class="s0">log(</span><span class="s3">''</span><span class="s0">)</span>
+<a name="l170"><span class="ln">170  </span></a>    <span class="s0">} </span><span class="s8">catch</span><span class="s0">(e){</span>
+<a name="l171"><span class="ln">171  </span></a>      <span class="s0">log(</span><span class="s3">'Kamera Fehler ' </span><span class="s0">+ e)</span>
+<a name="l172"><span class="ln">172  </span></a>    <span class="s0">}</span>
+<a name="l173"><span class="ln">173  </span></a>  <span class="s0">}</span>
+<a name="l174"><span class="ln">174  </span></a>
+<a name="l175"><span class="ln">175  </span></a>  <span class="s6">// Render-Loop</span>
+<a name="l176"><span class="ln">176  </span></a>  <span class="s8">let </span><span class="s0">tPrev = performance.now()</span>
+<a name="l177"><span class="ln">177  </span></a>  <span class="s8">function </span><span class="s0">tick(){</span>
