+<body>
+<div class="wrap">
+  <h1>LineLux – HTML Varianten (50)</h1>
+  <p class="muted">Diese Sammlung enthält 50 eigenständige HTML‑Varianten für Vorschau/Experimente. Jede Variante ist leicht
+  unterschiedlich (Farbschema/Titel) und kann als Ausgangspunkt für weitere Seiten dienen.</p>
+  <p class="muted">Zur Hauptoberfläche: <a href="../linelux-style.html">linelux-style.html</a> • Tradebot: <a href="../tradebot.html">tradebot.html</a> • Tradebot‑Seiten: <a href="../tradebot-index.html">tradebot-index.html</a> • Instanzen: <a href="../instances-index.html">instances-index.html</a> • Aerial: <a href="aerial-variants-index.html">aerial-variants-index.html</a> • Material: <a href="material-variants-index.html">material-variants-index.html</a> • Galaxy‑Lab: <a href="../galaxy-labs.html">galaxy-labs.html</a></p>
+  <div id="list" class="grid"></div>
+</div>
+<script>
+(function(){
+  const list = document.getElementById('list');
+  for(let i=1;i<=50;i++){
+    const n = String(i).padStart(2,'0');
+    const hue = Math.round((i/50)*360);
+    const div = document.createElement('div');
+    div.className = 'card';
+    div.innerHTML = '<div style="font-weight:700;margin-bottom:6px;color:hsl('+hue+',85%,70%)">Variante '+n+'</div>'+
