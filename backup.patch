+      '  <button id="fxHelp"   class="secondary">❓ Hilfe</button>',
+      '</div>',
+      '<div id="fxOut" class="changelog" style="min-height:80px"></div>'
+    ].join('');
+
+    const sec = panel('Azure Functions – Funktions‑App Interface', inner);
+    addPanel(sec);
+
+    const out = sec.querySelector('#fxOut');
+    const elBase = sec.querySelector('#fxBase');
+    const elTok  = sec.querySelector('#fxTok');
+    try{ elBase.value = (SaaS.getBase && SaaS.getBase()) || localStorage.getItem('saas.base') || ''; }catch(_){}
+    try{ elTok.value  = (SaaS.getToken && SaaS.getToken()) || localStorage.getItem('saas.token') || ''; }catch(_){ }
