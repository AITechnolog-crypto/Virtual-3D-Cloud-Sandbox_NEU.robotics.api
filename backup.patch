+<a name="l30"><span class="ln">30   </span></a>    <span class="s1">List&lt;Object[]&gt; countByCategory();</span>
+<a name="l31"><span class="ln">31   </span></a>    
+<a name="l32"><span class="ln">32   </span></a>    <span class="s1">List&lt;Blueprint&gt; findByStatusIn(List&lt;String&gt; statuses);</span>
+<a name="l33"><span class="ln">33   </span></a><span class="s1">}</span>
