+      '</div>',
+      '<div id="vpOut" class="small muted" style="margin-top:6px">Bereit.</div>'
+    ].join('');
+    const c = card('✨ Visual Pack', inner); addCard(c);
+    const cb = c.querySelector('#vpGlow');
+    const out = c.querySelector('#vpOut');
+    cb.checked = localStorage.getItem('visual.glow') === '1';
+
+    function apply(){
+      localStorage.setItem('visual.glow', cb.checked ? '1':'0');
+      try{
+        const mats = window.__materials || {};
+        if (mats.particles && mats.particles.color){
+          mats.particles.color.set(cb.checked? 0x66ffee : 0x00ffcc);
+          mats.particles.opacity = cb.checked? 0.95 : 0.85;
+          mats.particles.size = cb.checked? 2.8 : 2.0;
