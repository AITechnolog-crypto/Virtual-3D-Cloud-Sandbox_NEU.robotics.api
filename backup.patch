+<script>
+  // simple sliding window anomaly detector
+  class AnomalyDetector {
+    constructor(windowSize=30){ this.windowSize=windowSize; this.data=[]; }
+    push(val){ this.data.push(Number(val)||0); if(this.data.length>this.windowSize) this.data.shift(); return this.check(val); }
+    mean(){ return this.data.reduce((a,b)=>a+b,0)/this.data.length; }
+    std(){ const m=this.mean(); return Math.sqrt(this.data.reduce((s,v)=>s+(v-m)*(v-m),0)/this.data.length)||0; }
+    check(val){ if(this.data.length<5) return false; const z=(val-this.mean())/(this.std()||1); return Math.abs(z) > 3; }
+  }
+  (function(){
+    const detector = new AnomalyDetector(60);
+    const panel = document.getElementById('explainPanel');
+    const body = document.getElementById('explainBody');
+    const ack = document.getElementById('ackBtn');
+    function showExplain(text){ try{ body.textContent = text; panel.style.display='block'; }catch(_){} }
+    if (ack) ack.addEventListener('click', ()=>{ try{ panel.style.display='none'; }catch(_){} });
