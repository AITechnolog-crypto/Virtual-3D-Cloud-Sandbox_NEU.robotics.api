+</head>
+<body bgcolor="#1a2426">
+<table CELLSPACING=0 CELLPADDING=5 COLS=1 WIDTH="100%" BGCOLOR="#606060" >
+<tr><td><center>
+<font face="Arial, Helvetica" color="#000000">
+ApiKeyFilter.java</font>
+</center></td></tr></table>
+<pre><a name="l1"><span class="ln">1    </span></a><span class="s0">package </span><span class="s1">com.june.config;</span>
+<a name="l2"><span class="ln">2    </span></a>
+<a name="l3"><span class="ln">3    </span></a><span class="s0">import </span><span class="s1">jakarta.servlet.FilterChain;</span>
+<a name="l4"><span class="ln">4    </span></a><span class="s0">import </span><span class="s1">jakarta.servlet.ServletException;</span>
+<a name="l5"><span class="ln">5    </span></a><span class="s0">import </span><span class="s1">jakarta.servlet.http.HttpServletRequest;</span>
+<a name="l6"><span class="ln">6    </span></a><span class="s0">import </span><span class="s1">jakarta.servlet.http.HttpServletResponse;</span>
+<a name="l7"><span class="ln">7    </span></a><span class="s0">import </span><span class="s1">org.springframework.core.env.Environment;</span>
+<a name="l8"><span class="ln">8    </span></a><span class="s0">import </span><span class="s1">org.springframework.stereotype.Component;</span>
+<a name="l9"><span class="ln">9    </span></a><span class="s0">import </span><span class="s1">org.springframework.web.filter.OncePerRequestFilter;</span>
+<a name="l10"><span class="ln">10   </span></a>
+<a name="l11"><span class="ln">11   </span></a><span class="s0">import </span><span class="s1">java.io.IOException;</span>
+<a name="l12"><span class="ln">12   </span></a><span class="s0">import </span><span class="s1">java.util.Set;</span>
+<a name="l13"><span class="ln">13   </span></a>
+<a name="l14"><span class="ln">14   </span></a><span class="s2">/**</span>
+<a name="l15"><span class="ln">15   </span></a> <span class="s2">* Simple API key gate for sensitive proxy endpoints.</span>
+<a name="l16"><span class="ln">16   </span></a> <span class="s2">* - Protects /api/deepseek/* and /api/serp/* if app.api.key (or APP_API_KEY env) is set.</span>
+<a name="l17"><span class="ln">17   </span></a> <span class="s2">* - Uses header X-API-KEY for authentication.</span>
+<a name="l18"><span class="ln">18   </span></a> <span class="s2">* - If no key configured, filter is permissive (does not block), so local/demo remains usable.</span>
+<a name="l19"><span class="ln">19   </span></a> <span class="s2">*/</span>
+<a name="l20"><span class="ln">20   </span></a><span class="s1">@Component</span>
+<a name="l21"><span class="ln">21   </span></a><span class="s0">public class </span><span class="s1">ApiKeyFilter </span><span class="s0">extends </span><span class="s1">OncePerRequestFilter {</span>
+<a name="l22"><span class="ln">22   </span></a>    <span class="s0">private final </span><span class="s1">String configuredKey;</span>
+<a name="l23"><span class="ln">23   </span></a>    <span class="s0">private static final </span><span class="s1">Set&lt;String&gt; PROTECTED_PREFIXES = Set.of(</span>
+<a name="l24"><span class="ln">24   </span></a>            <span class="s3">&quot;/api/deepseek/&quot;</span><span class="s1">,</span>
+<a name="l25"><span class="ln">25   </span></a>            <span class="s3">&quot;/api/serp/&quot;</span><span class="s1">,</span>
+<a name="l26"><span class="ln">26   </span></a>            <span class="s3">&quot;/api/ml/&quot;</span><span class="s1">,</span>
+<a name="l27"><span class="ln">27   </span></a>            <span class="s3">&quot;/api/azure/&quot;</span><span class="s1">,</span>
+<a name="l28"><span class="ln">28   </span></a>            <span class="s3">&quot;/api/chat/&quot;</span>
+<a name="l29"><span class="ln">29   </span></a>    <span class="s1">);</span>
+<a name="l30"><span class="ln">30   </span></a>
+<a name="l31"><span class="ln">31   </span></a>    <span class="s0">public </span><span class="s1">ApiKeyFilter(Environment env) {</span>
+<a name="l32"><span class="ln">32   </span></a>        <span class="s1">String k = System.getenv(</span><span class="s3">&quot;APP_API_KEY&quot;</span><span class="s1">);</span>
+<a name="l33"><span class="ln">33   </span></a>        <span class="s0">if </span><span class="s1">(k == </span><span class="s0">null </span><span class="s1">|| k.isBlank()) {</span>
+<a name="l34"><span class="ln">34   </span></a>            <span class="s1">k = env != </span><span class="s0">null </span><span class="s1">? env.getProperty(</span><span class="s3">&quot;app.api.key&quot;</span><span class="s1">, </span><span class="s3">&quot;&quot;</span><span class="s1">) : </span><span class="s3">&quot;&quot;</span><span class="s1">;</span>
+<a name="l35"><span class="ln">35   </span></a>        <span class="s1">}</span>
+<a name="l36"><span class="ln">36   </span></a>        <span class="s0">this</span><span class="s1">.configuredKey = k;</span>
+<a name="l37"><span class="ln">37   </span></a>    <span class="s1">}</span>
+<a name="l38"><span class="ln">38   </span></a>
+<a name="l39"><span class="ln">39   </span></a>    <span class="s1">@Override</span>
+<a name="l40"><span class="ln">40   </span></a>    <span class="s0">protected void </span><span class="s1">doFilterInternal(HttpServletRequest request, HttpServletResponse response, FilterChain filterChain)</span>
+<a name="l41"><span class="ln">41   </span></a>            <span class="s0">throws </span><span class="s1">ServletException, IOException {</span>
+<a name="l42"><span class="ln">42   </span></a>        <span class="s1">String path = request.getRequestURI();</span>
+<a name="l43"><span class="ln">43   </span></a>        <span class="s0">if </span><span class="s1">(needsProtection(path) &amp;&amp; isProtectionEnabled()) {</span>
+<a name="l44"><span class="ln">44   </span></a>            <span class="s1">String key = request.getHeader(</span><span class="s3">&quot;X-API-KEY&quot;</span><span class="s1">);</span>
+<a name="l45"><span class="ln">45   </span></a>            <span class="s0">if </span><span class="s1">(key == </span><span class="s0">null </span><span class="s1">|| !key.equals(configuredKey)) {</span>
+<a name="l46"><span class="ln">46   </span></a>                <span class="s1">response.setStatus(HttpServletResponse.SC_UNAUTHORIZED);</span>
+<a name="l47"><span class="ln">47   </span></a>                <span class="s1">response.setContentType(</span><span class="s3">&quot;application/json;charset=utf-8&quot;</span><span class="s1">);</span>
+<a name="l48"><span class="ln">48   </span></a>                <span class="s1">response.getWriter().write(</span><span class="s3">&quot;{</span><span class="s4">\&quot;</span><span class="s3">error</span><span class="s4">\&quot;</span><span class="s3">:</span><span class="s4">\&quot;</span><span class="s3">Unauthorized – missing or invalid X-API-KEY</span><span class="s4">\&quot;</span><span class="s3">}&quot;</span><span class="s1">);</span>
+<a name="l49"><span class="ln">49   </span></a>                <span class="s0">return</span><span class="s1">;</span>
+<a name="l50"><span class="ln">50   </span></a>            <span class="s1">}</span>
+<a name="l51"><span class="ln">51   </span></a>        <span class="s1">}</span>
+<a name="l52"><span class="ln">52   </span></a>        <span class="s1">filterChain.doFilter(request, response);</span>
+<a name="l53"><span class="ln">53   </span></a>    <span class="s1">}</span>
+<a name="l54"><span class="ln">54   </span></a>
+<a name="l55"><span class="ln">55   </span></a>    <span class="s0">private boolean </span><span class="s1">needsProtection(String path) {</span>
+<a name="l56"><span class="ln">56   </span></a>        <span class="s0">if </span><span class="s1">(path == </span><span class="s0">null</span><span class="s1">) </span><span class="s0">return false</span><span class="s1">;</span>
+<a name="l57"><span class="ln">57   </span></a>        <span class="s0">for </span><span class="s1">(String p : PROTECTED_PREFIXES) {</span>
+<a name="l58"><span class="ln">58   </span></a>            <span class="s0">if </span><span class="s1">(path.startsWith(p)) </span><span class="s0">return true</span><span class="s1">;</span>
