+
+    function load(){
+      const ls = localStorage;
+      els.nodes.value = ls.getItem('infra.nodes')||'24';
+      els.storage.value = ls.getItem('infra.storageTB')||'480';
+      els.net.value = ls.getItem('infra.netGbps')||'320';
+      els.drones.value = ls.getItem('infra.drones')|| (document.getElementById('droneCount')?.textContent||'1200');
+      els.robots.value = ls.getItem('infra.robots')|| (document.getElementById('robotCount')?.textContent||'2');
