+        return isFinite(n) ? n : fallback;
+      }catch(_){ return fallback; }
+    }
+
+    function suggest(){
+      // Heuristik basierend auf aktuellen UI‑Werten
+      const energy = readNumber('energy', 2800); // kWh
+      const threats = parseInt((document.getElementById('threats')||{}).textContent||'0')||0;
+      const drones = parseInt((document.getElementById('droneCount')||{}).textContent||'0')||0;
+      const ideas = [];
+      if (energy < 2500) ideas.push('Energie gering: Solarfläche oder Windleistung temporär +10% skalieren.');
+      else ideas.push('Energie stabil: Wartungsfenster für kalte Nodes einplanen (30min).');
+      if (threats > 0) ideas.push('Bedrohungen erkannt: Resonanz‑Absorption verstärken und Swarm‑Segmente härten.');
+      if (drones < 3) ideas.push('Wenig Drohnen aktiv: 2 zusätzliche Aufklärer für Antarktis‑Zonen starten.');
+      if (ideas.length===0) ideas.push('System im grünen Bereich. Monitoring beibehalten.');
+      const ts = now();
+      out.innerHTML = '<div class="muted">'+ts+'</div><ul style="margin:6px 0 0; padding-left:18px">'+ideas.map(x=>'\n<li>'+x+'</li>').join('')+'</ul>';
