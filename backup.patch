+<a name="l201"><span class="ln">201  </span></a>  <span class="s0">})</span>
+<a name="l202"><span class="ln">202  </span></a>  <span class="s0">btnReset.addEventListener(</span><span class="s3">'click'</span><span class="s0">, resetOrientation)</span>
+<a name="l203"><span class="ln">203  </span></a>  <span class="s0">btnCube.addEventListener(</span><span class="s3">'click'</span><span class="s0">, makeCube)</span>
+<a name="l204"><span class="ln">204  </span></a>  <span class="s0">btnRing.addEventListener(</span><span class="s3">'click'</span><span class="s0">, makeRing)</span>
+<a name="l205"><span class="ln">205  </span></a>  <span class="s0">btnAxis.addEventListener(</span><span class="s3">'click'</span><span class="s0">, toggleAxes)</span>
+<a name="l206"><span class="ln">206  </span></a>
+<a name="l207"><span class="ln">207  </span></a>  <span class="s6">// Fallback wenn keine Motion Events</span>
+<a name="l208"><span class="ln">208  </span></a>  <span class="s0">setTimeout(()=&gt;{ </span><span class="s8">if </span><span class="s0">(!(</span><span class="s3">'ondeviceorientation' </span><span class="s8">in </span><span class="s0">window)) log(</span><span class="s3">'Hinweis Gerät liefert keine Orientation Events – Rotation per Touch denkbar'</span><span class="s0">) }, </span><span class="s4">2000</span><span class="s0">)</span>
