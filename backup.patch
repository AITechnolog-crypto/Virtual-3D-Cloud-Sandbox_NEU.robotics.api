+      <div style="margin-top:8px"><a class="btn" href="../linelux-style.html">Haupt‑UI öffnen</a></div>
+    </div>
+  </div>
+  <p style="margin-top:10px"><a href="variants-index.html">Varianten</a></p>
+</div>
+<script>
+function n(x){return Number(x).toLocaleString('de-DE')}
+function deployR(){ const el=document.getElementById('v7R'); const v=parseInt(el.textContent||'0'); el.textContent = n(v+1); }
+function deployD(){ const el=document.getElementById('v7D'); const v=parseInt(el.textContent||'0'); el.textContent = n(v+100); }
+function calcCost(){ const cd=parseFloat(cD.value||0), cg=parseFloat(cG.value||0), md=parseInt(mD.value||0), mg=parseInt(mG.value||0); const sum=cd*md + cg*mg; costOut.textContent = 'Kosten: '+sum.toLocaleString('de-DE',{minimumFractionDigits:2})+' €'; }
+function pnl(){ const r=parseFloat(rev.value||0), e=parseFloat(exp.value||0); const net=r-e; pnlOut.textContent = (net>=0?'Gewinn: ':'Verlust: ')+net.toLocaleString('de-DE',{minimumFractionDigits:2})+' €'; }
