+            boolean imminent = analyser.analyse(t);
+            if (imminent) {
+                shield.activate(t);
+                mag.strengthenField();
+                if (t.getType() == ThreatType.ATOMBOMBE) {
+                    double absorbed = rad.filterGammaNeutronen();
