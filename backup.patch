+      '  <div><div class="small muted">Einnahmen</div><div id="cfIn" class="card-value" style="font-size:1.4rem">–</div><div class="small muted">EUR / h</div></div>',
+      '  <div><div class="small muted">Ausgaben</div><div id="cfOut" class="card-value" style="font-size:1.4rem">–</div><div class="small muted">EUR / h</div></div>',
+      '  <div><div class="small muted">Netto</div><div id="cfNetto" class="card-value" style="font-size:1.4rem">–</div><div class="small muted">EUR / h</div></div>',
+      '</div>',
+      '<div class="small muted" id="cfHint" style="margin-top:8px">Konfiguriere Kapazitäten im Panel "Infrastruktur Kapazität".</div>'
