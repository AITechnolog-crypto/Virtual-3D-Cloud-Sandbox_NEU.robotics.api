+<a name="l25"><span class="ln">25   </span></a>                <span class="s2">// Produkt neu hinzufügen</span>
+<a name="l26"><span class="ln">26   </span></a>                <span class="s1">lagerMap.put(produkt.getName(), produkt);</span>
+<a name="l27"><span class="ln">27   </span></a>            <span class="s1">}</span>
+<a name="l28"><span class="ln">28   </span></a>        <span class="s1">});</span>
+<a name="l29"><span class="ln">29   </span></a>    <span class="s1">}</span>
+<a name="l30"><span class="ln">30   </span></a>
+<a name="l31"><span class="ln">31   </span></a>    <span class="s1">@Override</span>
