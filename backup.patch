+  let pollIv;
+  function startPolling(){
+    clearInterval(pollIv);
+    pollIv = setInterval(async ()=>{
+      try{ const r = await fetch(API_BASE + '/telemetry/status'); const j = await r.json(); update(j); document.getElementById('liveHint').textContent = 'Polling aktiv'; }catch(e){}
