+
+<!-- Backend Sync: Realtime Counts (drones/transactions) with graceful fallback -->
+<script>
+(function(){
+  const API = window.location.origin + '/api';
+  async function getNumber(url){
+    try{ const r = await fetch(url, { cache:'no-store' }); if(!r.ok) return null; const ct=r.headers.get('content-type')||''; if (ct.includes('application/json')){ const j=await r.json(); return typeof j==='number'? j : (Array.isArray(j)? j.length : null); } const t=await r.text(); const n = Number(t); return isFinite(n)? n : null; }catch(_){ return null; }
+  }
+  async function tick(){
+    try{
+      const d = await getNumber(API + '/drones/count');
+      if (d != null){ const el = document.getElementById('droneCount'); if (el) el.textContent = d.toLocaleString('de-DE'); }
+    }catch(_){}
+    try{
+      const t = await getNumber(API + '/transactions/count');
+      if (t != null){ const el = document.getElementById('transactionCount'); if (el) el.textContent = t.toLocaleString('de-DE'); }
+    }catch(_){}
+  }
+  // run periodically without being intrusive
+  document.addEventListener('DOMContentLoaded', ()=>{ tick(); setInterval(tick, 8000); });
+})();
+</script>
+
+
+<!-- Entfernen „Instanz‑Föderation“ & „Physik/Mathe/Chemie“ + Labor‑Ersatz -->
+<script>
+(function(){
+  function removeCardsByTitle(matches){
+    try{
+      const cards = Array.from(document.querySelectorAll('.card'));
+      cards.forEach(c=>{
+        const t = (c.querySelector('.card-title')||{}).textContent||'';
+        if (matches.some(m=> t.indexOf(m) !== -1)) { c.remove(); }
+      });
+    }catch(_){}
+  }
+  function addLabCard(){
+    const grid = document.querySelector('.dashboard-grid') || document.querySelector('.features') || document.body;
+    const card = document.createElement('div');
+    card.className='card';
+    card.innerHTML = '<div class="card-title">🧪 Labor – Druck & Aggregatzustände</div>'+
+      '<div class="small muted">Einfache Labor‑Simulation: Temperatur & Druck steuern, Phase (Eis/Wasser/Dampf) anzeigen. Rein visuell.</div>'+
+      '<div style="display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:10px;margin-top:10px">'+
+      '  <label>Temperatur [°C] <input id="labT" type="range" min="-50" max="200" value="22"> <span id="labTval" class="small muted">22°C</span></label>'+
+      '  <label>Druck [atm] <input id="labP" type="range" min="0.2" max="5" step="0.1" value="1"> <span id="labPval" class="small muted">1.0 atm</span></label>'+
+      '</div>'+
+      '<div style="display:flex;align-items:center;gap:14px;margin-top:10px">'+
+      '  <div id="labPhase" class="card-value" style="font-size:1.6rem">Wasser (flüssig)</div>'+
+      '  <div id="labHint" class="small muted"></div>'+
+      '</div>'+
+      '<canvas id="labCanvas" style="width:100%;height:120px;margin-top:10px;border-radius:8px;background:rgba(255,255,255,.03)"></canvas>';
+    grid.appendChild(card);
+
+    const tEl = card.querySelector('#labT');
+    const pEl = card.querySelector('#labP');
+    const tv = card.querySelector('#labTval');
+    const pv = card.querySelector('#labPval');
+    const ph = card.querySelector('#labPhase');
+    const hint = card.querySelector('#labHint');
+    const cv = card.querySelector('#labCanvas');
+    const ctx = cv.getContext('2d');
+    function resize(){ cv.width = cv.clientWidth; cv.height = cv.clientHeight; }
+    window.addEventListener('resize', resize); resize();
+
+    function boilPointAtm(atm){ // grobe Annäherung: 100°C bei 1 atm, ~ +10°C je Dekade
+      const a = Math.max(0.1, atm);
+      return 100 + 10 * Math.log10(a);
+    }
+    function freezePoint(atm){ return 0; } // konst.
+    function draw(temp, atm){
+      const w=cv.width, h=cv.height; ctx.clearRect(0,0,w,h);
+      // Hintergrund‑Gradient (kalt→warm)
+      const g = ctx.createLinearGradient(0,0,w,0);
+      g.addColorStop(0,'#66aaff'); g.addColorStop(0.5,'#a8ffdf'); g.addColorStop(1,'#ff7755');
+      ctx.fillStyle=g; ctx.fillRect(0,0,w,h);
+      // Marker für aktuelle T
+      const x = ((temp+50)/250)*w; ctx.fillStyle='rgba(0,0,0,.6)'; ctx.fillRect(x-2,0,4,h);
+      // Linien für Gefrier- & Siedepunkt
+      const xF = ((freezePoint(atm)+50)/250)*w; const xB = ((boilPointAtm(atm)+50)/250)*w;
+      ctx.fillStyle='rgba(255,255,255,.8)'; ctx.fillRect(xF-1,0,2,h); ctx.fillRect(xB-1,0,2,h);
+    }
+    function update(){
+      const T = parseFloat(tEl.value); const P = parseFloat(pEl.value);
+      tv.textContent = T.toFixed(0)+'°C'; pv.textContent = P.toFixed(1)+' atm';
+      const Tb = boilPointAtm(P); const Tf = freezePoint(P);
+      let phase = 'Wasser (flüssig)';
+      if (T <= Tf - 0.1) phase = 'Eis (fest)';
+      else if (T >= Tb + 0.1) phase = 'Dampf (gasförmig)';
+      ph.textContent = phase;
+      hint.textContent = `Gefrierpunkt ≈ ${Tf.toFixed(0)}°C • Siedepunkt ≈ ${Tb.toFixed(0)}°C`;
+      draw(T,P);
+    }
+    tEl.addEventListener('input', update); pEl.addEventListener('input', update);
+    update();
+  }
+  function init(){
+    removeCardsByTitle(['Instanz‑Föderation','Physik/Mathe/Chemie']);
+    addLabCard();
+  }
+  if (document.readyState==='loading') document.addEventListener('DOMContentLoaded', init); else init();
+})();
+</script>
