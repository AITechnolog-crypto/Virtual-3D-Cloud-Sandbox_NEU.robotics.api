+class PricingEngine {
+    public double priceFor(Offer o, double demandIdx) {
+        double p = o.getBasePrice() * demandIdx;
+        return Math.max(o.getMinPrice(), p);
+    }
+    public double estimateOpsCost(Offer o) {
+        return Math.max(50, o.getBasePrice() * 0.15);
+    }
+}
