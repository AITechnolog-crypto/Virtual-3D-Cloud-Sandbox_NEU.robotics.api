+<a name="l386"><span class="ln">386  </span></a>    <span class="s7">if</span><span class="s0">(Math.abs(acc) &gt; </span><span class="s6">2</span><span class="s0">*Math.PI){ </span><span class="s8">// eine volle Umdrehung</span>
+<a name="l387"><span class="ln">387  </span></a>      <span class="s0">ritual.wind(</span><span class="s6">6</span><span class="s0">); acc=</span><span class="s6">0</span><span class="s0">;</span>
+<a name="l388"><span class="ln">388  </span></a>    <span class="s0">}</span>
