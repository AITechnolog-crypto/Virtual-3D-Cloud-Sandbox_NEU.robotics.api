+<a name="l157"><span class="ln">157  </span></a>  <span class="s6">// Kamera starten</span>
+<a name="l158"><span class="ln">158  </span></a>  <span class="s0">async </span><span class="s8">function </span><span class="s0">startCamera(){</span>
