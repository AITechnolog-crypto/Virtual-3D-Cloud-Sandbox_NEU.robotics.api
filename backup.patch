+    // periodic refresh
+    update();
+    setInterval(update, 3000);
+
+    // try to hook into energy updates if available
+    try{
+      const old = window.updateEnergyChart;
+      if (typeof old === 'function'){
+        window.updateEnergyChart = function(v){ try{ update(); }catch(_){ } old(v); };
+      }
+    }catch(_){ }
+  }
+
+  window.addEventListener('DOMContentLoaded', ()=>{ try{ mount(); }catch(e){ console.warn('[FinanceWorkspace]', e); } });
+})();
+</script>
