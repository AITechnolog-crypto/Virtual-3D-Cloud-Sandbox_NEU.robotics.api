+class Geofence {
+    public final String id; public final boolean conflict; public final List<GeoPoint> poly = new ArrayList<>();
+    Geofence(String id, boolean conflict, GeoPoint...pts){ this.id=id; this.conflict=conflict; poly.addAll(Arrays.asList(pts)); }
+    public boolean contains(GeoPoint p){
+        boolean c=false; for(int i=0,j=poly.size()-1;i<poly.size();j=i++){
+            GeoPoint a=poly.get(i), b=poly.get(j);
+            if(((a.lon>p.lon)!=(b.lon>p.lon)) && (p.lat < (b.lat-a.lat)*(p.lon-a.lon)/(b.lon-a.lon)+a.lat)) c=!c;
+        } return c;
+    }
+}
