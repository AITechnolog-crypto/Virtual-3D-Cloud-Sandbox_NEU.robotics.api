+<table CELLSPACING=0 CELLPADDING=5 COLS=1 WIDTH="100%" BGCOLOR="#606060" >
+<tr><td><center>
+<font face="Arial, Helvetica" color="#000000">
+KIIntegrationVerbessert.java</font>
+</center></td></tr></table>
+<pre><a name="l1"><span class="ln">1    </span></a><span class="s0">package </span><span class="s1">com.june.ai;</span>
+<a name="l2"><span class="ln">2    </span></a>
+<a name="l3"><span class="ln">3    </span></a><span class="s0">import </span><span class="s1">org.slf4j.Logger;</span>
+<a name="l4"><span class="ln">4    </span></a><span class="s0">import </span><span class="s1">org.slf4j.LoggerFactory;</span>
+<a name="l5"><span class="ln">5    </span></a>
+<a name="l6"><span class="ln">6    </span></a><span class="s0">import </span><span class="s1">java.util.concurrent.CompletableFuture;</span>
+<a name="l7"><span class="ln">7    </span></a>
+<a name="l8"><span class="ln">8    </span></a><span class="s2">/**</span>
+<a name="l9"><span class="ln">9    </span></a> <span class="s2">* Beispiel-Entry-Point, der eine sichere, fehlertolerante KI-Integration demonstriert.</span>
+<a name="l10"><span class="ln">10   </span></a> <span class="s2">*</span>
+<a name="l11"><span class="ln">11   </span></a> <span class="s2">* Liest Konfiguration aus Umgebungsvariablen:</span>
+<a name="l12"><span class="ln">12   </span></a> <span class="s2">*  - CLOUD_ENDPOINT</span>
+<a name="l13"><span class="ln">13   </span></a> <span class="s2">*  - API_KEY</span>
+<a name="l14"><span class="ln">14   </span></a> <span class="s2">*/</span>
+<a name="l15"><span class="ln">15   </span></a><span class="s0">public class </span><span class="s1">KIIntegrationVerbessert {</span>
+<a name="l16"><span class="ln">16   </span></a>    <span class="s0">private static final </span><span class="s1">Logger logger = LoggerFactory.getLogger(KIIntegrationVerbessert.</span><span class="s0">class</span><span class="s1">);</span>
+<a name="l17"><span class="ln">17   </span></a>
+<a name="l18"><span class="ln">18   </span></a>    <span class="s0">public static void </span><span class="s1">main(String[] args) {</span>
+<a name="l19"><span class="ln">19   </span></a>        <span class="s2">// 1. Sicheres Laden der Konfiguration aus Umgebungsvariablen</span>
+<a name="l20"><span class="ln">20   </span></a>        <span class="s1">String cloudEndpoint = System.getenv(</span><span class="s3">&quot;CLOUD_ENDPOINT&quot;</span><span class="s1">);</span>
+<a name="l21"><span class="ln">21   </span></a>        <span class="s1">String apiKey = System.getenv(</span><span class="s3">&quot;API_KEY&quot;</span><span class="s1">);</span>
+<a name="l22"><span class="ln">22   </span></a>
+<a name="l23"><span class="ln">23   </span></a>        <span class="s0">if </span><span class="s1">(cloudEndpoint == </span><span class="s0">null </span><span class="s1">|| apiKey == </span><span class="s0">null</span><span class="s1">) {</span>
+<a name="l24"><span class="ln">24   </span></a>            <span class="s1">logger.error(</span><span class="s3">&quot;Endpoint oder API-Schlüssel nicht gefunden. Bitte Umgebungsvariablen festlegen.&quot;</span><span class="s1">);</span>
+<a name="l25"><span class="ln">25   </span></a>            <span class="s1">logger.error(</span><span class="s3">&quot;Beispiel: set CLOUD_ENDPOINT=https://example.ai &amp;&amp; set API_KEY=xyz123 (Windows Powershell/CMD)&quot;</span><span class="s1">);</span>
+<a name="l26"><span class="ln">26   </span></a>            <span class="s0">return</span><span class="s1">;</span>
+<a name="l27"><span class="ln">27   </span></a>        <span class="s1">}</span>
+<a name="l28"><span class="ln">28   </span></a>
+<a name="l29"><span class="ln">29   </span></a>        <a href="CloudKonfiguration.java.html">CloudKonfiguration</a> <span class="s1">konfig = </span><span class="s0">new <a href="CloudKonfiguration.java.html">CloudKonfiguration</a></span><span class="s1">();</span>
+<a name="l30"><span class="ln">30   </span></a>        <span class="s1">konfig.setEndpoint(cloudEndpoint);</span>
+<a name="l31"><span class="ln">31   </span></a>        <span class="s1">konfig.setApiKey(apiKey);</span>
+<a name="l32"><span class="ln">32   </span></a>
+<a name="l33"><span class="ln">33   </span></a>        <a href="KIBibliothek.java.html">KIBibliothek</a> <span class="s1">ki = </span><span class="s0">new <a href="KIBibliothek.java.html">KIBibliothek</a></span><span class="s1">();</span>
+<a name="l34"><span class="ln">34   </span></a>        <span class="s0">try </span><span class="s1">{</span>
+<a name="l35"><span class="ln">35   </span></a>            <span class="s2">// 2. Fehlerbehandlung für Verbindung und Initialisierung</span>
+<a name="l36"><span class="ln">36   </span></a>            <span class="s1">logger.info(</span><span class="s3">&quot;Versuche Verbindung zur Cloud herzustellen...&quot;</span><span class="s1">);</span>
+<a name="l37"><span class="ln">37   </span></a>            <span class="s1">ki.verbindeMitCloud(konfig);</span>
+<a name="l38"><span class="ln">38   </span></a>            <span class="s1">logger.info(</span><span class="s3">&quot;Verbindung erfolgreich. Initialisiere KI-Modell...&quot;</span><span class="s1">);</span>
+<a name="l39"><span class="ln">39   </span></a>            <span class="s1">ki.initialisiereModell();</span>
+<a name="l40"><span class="ln">40   </span></a>            <span class="s1">logger.info(</span><span class="s3">&quot;KI-Modell initialisiert.&quot;</span><span class="s1">);</span>
+<a name="l41"><span class="ln">41   </span></a>
+<a name="l42"><span class="ln">42   </span></a>            <span class="s2">// 3. Asynchrone Ausführung der Aufgabe</span>
+<a name="l43"><span class="ln">43   </span></a>            <span class="s1">String aufgabe = args != </span><span class="s0">null </span><span class="s1">&amp;&amp; args.length &gt; </span><span class="s4">0 </span><span class="s1">? String.join(</span><span class="s3">&quot; &quot;</span><span class="s1">, args) : </span><span class="s3">&quot;Ihre Aufgabe&quot;</span><span class="s1">;</span>
+<a name="l44"><span class="ln">44   </span></a>            <span class="s1">logger.info(</span><span class="s3">&quot;Sende Aufgabe an KI: {}&quot;</span><span class="s1">, aufgabe);</span>
+<a name="l45"><span class="ln">45   </span></a>
+<a name="l46"><span class="ln">46   </span></a>            <span class="s1">CompletableFuture.supplyAsync(() -&gt; ki.fuehreAufgabeAus(aufgabe))</span>
+<a name="l47"><span class="ln">47   </span></a>                <span class="s1">.thenAccept(ergebnis -&gt; logger.info(</span><span class="s3">&quot;Ergebnis der KI-Aufgabe: {}&quot;</span><span class="s1">, ergebnis))</span>
+<a name="l48"><span class="ln">48   </span></a>                <span class="s1">.exceptionally(e -&gt; {</span>
+<a name="l49"><span class="ln">49   </span></a>                    <span class="s1">logger.error(</span><span class="s3">&quot;Fehler bei der Ausführung der KI-Aufgabe: {}&quot;</span><span class="s1">, e.getMessage());</span>
+<a name="l50"><span class="ln">50   </span></a>                    <span class="s0">return null</span><span class="s1">;</span>
+<a name="l51"><span class="ln">51   </span></a>                <span class="s1">})</span>
+<a name="l52"><span class="ln">52   </span></a>                <span class="s2">// Warten bis die async Pipeline abgeschlossen wurde (kleiner Demo-Blocker)</span>
+<a name="l53"><span class="ln">53   </span></a>                <span class="s1">.join();</span>
+<a name="l54"><span class="ln">54   </span></a>
+<a name="l55"><span class="ln">55   </span></a>        <span class="s1">} </span><span class="s0">catch </span><span class="s1">(<a href="KIException.java.html">KIException</a> e) {</span>
+<a name="l56"><span class="ln">56   </span></a>            <span class="s1">logger.error(</span><span class="s3">&quot;Kritischer Fehler bei der KI-Integration: {}&quot;</span><span class="s1">, e.getMessage());</span>
+<a name="l57"><span class="ln">57   </span></a>            <span class="s2">// Optional: Retry-Logik oder sauberes Beenden</span>
+<a name="l58"><span class="ln">58   </span></a>        <span class="s1">}</span>
+<a name="l59"><span class="ln">59   </span></a>    <span class="s1">}</span>
+<a name="l60"><span class="ln">60   </span></a><span class="s1">}</span>
+<a name="l61"><span class="ln">61   </span></a></pre>
+</body>
+</html>
