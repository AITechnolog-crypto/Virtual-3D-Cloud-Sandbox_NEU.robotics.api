+<!-- Realtime Analyse: kompakte Live-Statistiken -->
+<script>
+(function(){ if (typeof ENERGY_LIVE_ENABLED !== 'undefined' && !ENERGY_LIVE_ENABLED) { return; }
+  const MAX_POINTS = 60; // ~2min bei 2s Fallback / 3s SSE
+  const state = { series: [] };
+
+  function ensureCard(){
+    if (document.getElementById('rtAnalysisCard')) return;
+    const grid = document.querySelector('.dashboard-grid');
+    if (!grid) return;
+    const card = document.createElement('div');
+    card.className = 'card';
+    card.id = 'rtAnalysisCard';
+    card.innerHTML = '<div class="card-title">⚡ Echtzeit‑Analyse</div>'+
+      '<div class="small muted">Automatisch aus den Live‑Werten berechnet</div>'+
+      '<div style="display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:8px;margin-top:10px">'+
+      '  <div><div class="muted small">Letzter</div><div id="rtLast" class="card-value" style="font-size:1.2rem">–</div></div>'+
+      '  <div><div class="muted small">Trend</div><div id="rtTrend" class="card-value" style="font-size:1.2rem">–</div></div>'+
+      '  <div><div class="muted small">Durchschnitt</div><div id="rtAvg" class="card-value" style="font-size:1.2rem">–</div></div>'+
+      '  <div><div class="muted small">Min / Max</div><div id="rtMinMax" class="card-value" style="font-size:1.2rem">–</div></div>'+
+      '</div>';
+    grid.appendChild(card);
+  }
+
+  function fmt(n){ try { return Number(n).toLocaleString('de-DE'); } catch(e) { return String(n); } }
+  function compute(){
+    const arr = state.series;
+    if (!arr.length) return null;
+    const last = arr[arr.length-1];
+    const min = Math.min(...arr);
+    const max = Math.max(...arr);
+    const avg = arr.reduce((a,b)=>a+b,0)/arr.length;
+    // einfacher Trend (letzte 8 Punkte): linearer Fit via zwei Punkte
+    const k = Math.min(8, arr.length-1);
+    let trend = 0;
+    if (k>1){
+      const y1 = arr[arr.length-k];
+      const y2 = last;
+      trend = (y2 - y1) / k;
+    }
+    return { last, min, max, avg, trend };
+  }
+
+  function render(){
+    ensureCard();
+    const stats = compute();
+    if (!stats) return;
+    const tEl = document.getElementById('rtTrend');
+    const lEl = document.getElementById('rtLast');
+    const aEl = document.getElementById('rtAvg');
+    const mEl = document.getElementById('rtMinMax');
+    if (!tEl) return;
+    const arrow = stats.trend>3 ? '⬆️' : (stats.trend<-3 ? '⬇️' : '→');
+    tEl.textContent = arrow + ' ' + (stats.trend>=0?'+':'') + stats.trend.toFixed(1);
+    lEl.textContent = fmt(stats.last) + ' kWh';
+    aEl.textContent = fmt(stats.avg.toFixed(0)) + ' kWh';
+    mEl.textContent = fmt(stats.min) + ' / ' + fmt(stats.max) + ' kWh';
+  }
+
+  function push(val){
+    if (typeof val !== 'number' || !isFinite(val)) return;
+    state.series.push(val);
+    if (state.series.length > MAX_POINTS) state.series.shift();
+    render();
+  }
+
+  // Hook in bestehendes Update – behutsam dekorieren
+  const oldUpdate = window.updateEnergyChart;
+  window.updateEnergyChart = function(v){ try{ push(v); }catch(_){}; if (typeof oldUpdate === 'function') oldUpdate(v); };
+
+  // Fallback: auch Zufallswerte einsammeln, sofern aktiv
+  const oldIv = window.energyIv;
+  if (oldIv){
+    clearInterval(oldIv);
+    window.energyIv = setInterval(()=>{
+      if (!window.__energyLive && window.energyChart){
+        const ds = window.energyChart.data.datasets[0].data;
+        const v = Number(ds[ds.length-1]);
+        push(v);
+        // original update
+        const dso = window.energyChart.data.datasets[0].data;
+        dso.shift(); dso.push(Math.random()*3000 + 2000);
+        window.energyChart.update('none');
+      }
+    }, 2000);
+  }
+
+  window.addEventListener('DOMContentLoaded', ensureCard);
+})();
+</script>
