+  async function fetchNum(url){ try{ const r=await fetch(url,{cache:'no-store'}); if(!r.ok) return null; const ct=r.headers.get('content-type')||''; if(ct.includes('application/json')){ const j=await r.json(); return typeof j==='number'? j : (Array.isArray(j)? j.length : null); } const t=await r.text(); const n=Number(t); return isFinite(n)? n:null; }catch(e){ return null; } }
+  async function tick(){
+    try{ const d = await fetchNum(API+'/drones/count'); if(d!=null) document.getElementById('mDrones').textContent = d.toLocaleString('de-DE'); }catch(e){}
+    try{ const r = await fetchNum(API+'/robots/count'); if(r!=null) document.getElementById('mRobotics').textContent = r.toLocaleString('de-DE'); }catch(e){}
+    try{ const s = await fetch(API+'/telemetry/status').then(r=>r.ok?r.json():null).catch(()=>null); if(s&&s.metrics&&typeof s.metrics.energy==='number'){ document.getElementById('mEnergy').textContent = Number(s.metrics.energy).toLocaleString('de-DE'); }
+    }catch(e){}
+  }
