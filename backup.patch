+<a name="l119"><span class="ln">119  </span></a>        <span class="s1">m.put(</span><span class="s3">&quot;maxTrainPerHour&quot;</span><span class="s1">, p.maxTrainPerHour);</span>
+<a name="l120"><span class="ln">120  </span></a>        <span class="s1">m.put(</span><span class="s3">&quot;allowExternalModels&quot;</span><span class="s1">, p.allowExternalModels);</span>
+<a name="l121"><span class="ln">121  </span></a>        <span class="s0">if </span><span class="s1">(p.extra != </span><span class="s0">null </span><span class="s1">&amp;&amp; !p.extra.isEmpty()) m.put(</span><span class="s3">&quot;extra&quot;</span><span class="s1">, p.extra);</span>
+<a name="l122"><span class="ln">122  </span></a>        <span class="s0">return </span><span class="s1">toJson(m);</span>
+<a name="l123"><span class="ln">123  </span></a>    <span class="s1">}</span>
+<a name="l124"><span class="ln">124  </span></a>
+<a name="l125"><span class="ln">125  </span></a>    <span class="s0">private static </span><span class="s1">String toJson(Map&lt;String,Object&gt; m){</span>
+<a name="l126"><span class="ln">126  </span></a>        <span class="s1">StringBuilder sb = </span><span class="s0">new </span><span class="s1">StringBuilder();</span>
+<a name="l127"><span class="ln">127  </span></a>        <span class="s1">appendJson(sb, m); </span><span class="s0">return </span><span class="s1">sb.toString();</span>
+<a name="l128"><span class="ln">128  </span></a>    <span class="s1">}</span>
+<a name="l129"><span class="ln">129  </span></a>    <span class="s1">@SuppressWarnings(</span><span class="s3">&quot;unchecked&quot;</span><span class="s1">)</span>
+<a name="l130"><span class="ln">130  </span></a>    <span class="s0">private static void </span><span class="s1">appendJson(StringBuilder sb, Object obj){</span>
+<a name="l131"><span class="ln">131  </span></a>        <span class="s0">if </span><span class="s1">(obj == </span><span class="s0">null</span><span class="s1">){ sb.append(</span><span class="s3">&quot;null&quot;</span><span class="s1">); </span><span class="s0">return</span><span class="s1">; }</span>
+<a name="l132"><span class="ln">132  </span></a>        <span class="s0">if </span><span class="s1">(obj </span><span class="s0">instanceof </span><span class="s1">Number || obj </span><span class="s0">instanceof </span><span class="s1">Boolean){ sb.append(String.valueOf(obj)); </span><span class="s0">return</span><span class="s1">; }</span>
+<a name="l133"><span class="ln">133  </span></a>        <span class="s0">if </span><span class="s1">(obj </span><span class="s0">instanceof </span><span class="s1">String){ sb.append(</span><span class="s3">'&quot;'</span><span class="s1">).append(escape((String)obj)).append(</span><span class="s3">'&quot;'</span><span class="s1">); </span><span class="s0">return</span><span class="s1">; }</span>
+<a name="l134"><span class="ln">134  </span></a>        <span class="s0">if </span><span class="s1">(obj </span><span class="s0">instanceof </span><span class="s1">Map){ sb.append(</span><span class="s3">'{'</span><span class="s1">); </span><span class="s0">boolean </span><span class="s1">first=</span><span class="s0">true</span><span class="s1">; </span><span class="s0">for </span><span class="s1">(Map.Entry&lt;?,?&gt; e: ((Map&lt;?,?&gt;)obj).entrySet()){ </span><span class="s0">if</span><span class="s1">(!first) sb.append(</span><span class="s3">','</span><span class="s1">); first=</span><span class="s0">false</span><span class="s1">; sb.append(</span><span class="s3">'&quot;'</span><span class="s1">).append(escape(String.valueOf(e.getKey()))).append(</span><span class="s3">'&quot;'</span><span class="s1">).append(</span><span class="s3">':'</span><span class="s1">); appendJson(sb,e.getValue()); } sb.append(</span><span class="s3">'}'</span><span class="s1">); </span><span class="s0">return</span><span class="s1">; }</span>
+<a name="l135"><span class="ln">135  </span></a>        <span class="s0">if </span><span class="s1">(obj </span><span class="s0">instanceof </span><span class="s1">Iterable){ sb.append(</span><span class="s3">'['</span><span class="s1">); </span><span class="s0">boolean </span><span class="s1">first=</span><span class="s0">true</span><span class="s1">; </span><span class="s0">for </span><span class="s1">(Object v: (Iterable&lt;?&gt;)obj){ </span><span class="s0">if</span><span class="s1">(!first) sb.append(</span><span class="s3">','</span><span class="s1">); first=</span><span class="s0">false</span><span class="s1">; appendJson(sb,v);} sb.append(</span><span class="s3">']'</span><span class="s1">); </span><span class="s0">return</span><span class="s1">; }</span>
+<a name="l136"><span class="ln">136  </span></a>        <span class="s1">sb.append(</span><span class="s3">'&quot;'</span><span class="s1">).append(escape(String.valueOf(obj))).append(</span><span class="s3">'&quot;'</span><span class="s1">);</span>
+<a name="l137"><span class="ln">137  </span></a>    <span class="s1">}</span>
+<a name="l138"><span class="ln">138  </span></a>    <span class="s0">private static </span><span class="s1">String escape(String s){ </span><span class="s0">return </span><span class="s1">s.replace(</span><span class="s3">&quot;</span><span class="s5">\\</span><span class="s3">&quot;</span><span class="s1">,</span><span class="s3">&quot;</span><span class="s5">\\\\</span><span class="s3">&quot;</span><span class="s1">).replace(</span><span class="s3">&quot;</span><span class="s5">\&quot;</span><span class="s3">&quot;</span><span class="s1">,</span><span class="s3">&quot;</span><span class="s5">\\\&quot;</span><span class="s3">&quot;</span><span class="s1">).replace(</span><span class="s3">&quot;</span><span class="s5">\n</span><span class="s3">&quot;</span><span class="s1">,</span><span class="s3">&quot;</span><span class="s5">\\</span><span class="s3">n&quot;</span><span class="s1">); }</span>
+<a name="l139"><span class="ln">139  </span></a><span class="s1">}</span>
+<a name="l140"><span class="ln">140  </span></a></pre>
+</body>
+</html>
