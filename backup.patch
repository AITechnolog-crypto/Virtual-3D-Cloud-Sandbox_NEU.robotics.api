+<a name="l137"><span class="ln">137  </span></a>        <span class="s0">elMsg.textContent = </span><span class="s3">'⏳ '</span><span class="s0">+(j.status||</span><span class="s3">'Warte…'</span><span class="s0">);</span>
+<a name="l138"><span class="ln">138  </span></a>      <span class="s0">}</span>
+<a name="l139"><span class="ln">139  </span></a>    <span class="s0">}</span><span class="s7">catch</span><span class="s0">(e){ elMsg.textContent = </span><span class="s3">'❌ Fehler beim Abrufen: ' </span><span class="s0">+ (e.message||e); clearInterval(pollIv); }</span>
+<a name="l140"><span class="ln">140  </span></a>  <span class="s0">}</span>
+<a name="l141"><span class="ln">141  </span></a>
+<a name="l142"><span class="ln">142  </span></a>  <span class="s7">function </span><span class="s0">startPolling(){ </span><span class="s7">if </span><span class="s0">(pollIv) clearInterval(pollIv); pollIv = setInterval(pollOnce, </span><span class="s6">1200</span><span class="s0">); }</span>
+<a name="l143"><span class="ln">143  </span></a>  <span class="s7">function </span><span class="s0">cancel(){ </span><span class="s7">if </span><span class="s0">(pollIv) clearInterval(pollIv); pollIv=</span><span class="s7">null</span><span class="s0">; taskId=</span><span class="s7">null</span><span class="s0">; elStatus.textContent=</span><span class="s3">'–'</span><span class="s0">; elMsg.textContent=</span><span class="s3">'Abgebrochen.'</span><span class="s0">; }</span>
+<a name="l144"><span class="ln">144  </span></a>
+<a name="l145"><span class="ln">145  </span></a>  <span class="s0">document.getElementById(</span><span class="s3">'btnCreate'</span><span class="s0">).addEventListener(</span><span class="s3">'click'</span><span class="s0">, create);</span>
+<a name="l146"><span class="ln">146  </span></a>  <span class="s0">document.getElementById(</span><span class="s3">'btnCancel'</span><span class="s0">).addEventListener(</span><span class="s3">'click'</span><span class="s0">, cancel);</span>
+<a name="l147"><span class="ln">147  </span></a><span class="s0">})();</span>
+<a name="l148"><span class="ln">148  </span></a><span class="s0">&lt;/</span><span class="s2">script</span><span class="s0">&gt;</span>
+<a name="l149"><span class="ln">149  </span></a><span class="s0">&lt;/</span><span class="s2">body</span><span class="s0">&gt;</span>
+<a name="l150"><span class="ln">150  </span></a><span class="s0">&lt;/</span><span class="s2">html</span><span class="s0">&gt;</span></pre>
+</body>
+</html>
