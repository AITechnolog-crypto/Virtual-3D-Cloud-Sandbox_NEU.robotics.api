+<a name="l465"><span class="ln">465  </span></a>      <span class="s0">return </span><span class="s1">Map.of(</span><span class="s3">&quot;ok&quot;</span><span class="s1">,</span><span class="s3">&quot;saved&quot;</span><span class="s1">);</span>
+<a name="l466"><span class="ln">466  </span></a>    <span class="s1">}</span>
+<a name="l467"><span class="ln">467  </span></a>
+<a name="l468"><span class="ln">468  </span></a>    <span class="s2">/** Produkte anlegen/ändern – SUB unter 99.000 EUR blockt hart */</span>
+<a name="l469"><span class="ln">469  </span></a>    <span class="s1">@PostMapping(</span><span class="s3">&quot;/product&quot;</span><span class="s1">)</span>
+<a name="l470"><span class="ln">470  </span></a>    <span class="s0">public </span><span class="s1">Map&lt;String,Object&gt; upsertProduct(@RequestHeader(</span><span class="s3">&quot;X-Admin-Token&quot;</span><span class="s1">) String t,</span>
+<a name="l471"><span class="ln">471  </span></a>                                            <span class="s1">@RequestParam String sku,</span>
+<a name="l472"><span class="ln">472  </span></a>                                            <span class="s1">@RequestParam String name,</span>
+<a name="l473"><span class="ln">473  </span></a>                                            <span class="s1">@RequestParam </span><span class="s0">int </span><span class="s1">priceCentsEUR,</span>
+<a name="l474"><span class="ln">474  </span></a>                                            <span class="s1">@RequestParam String kind,      </span><span class="s2">// SUB oder ONE</span>
+<a name="l475"><span class="ln">475  </span></a>                                            <span class="s1">@RequestParam String fileName) {</span>
+<a name="l476"><span class="ln">476  </span></a>      <span class="s1">auth(t);</span>
+<a name="l477"><span class="ln">477  </span></a>      <span class="s1">Product p = </span><span class="s0">new </span><span class="s1">Product(sku.toUpperCase(), name, priceCentsEUR, kind.toUpperCase(), fileName);</span>
+<a name="l478"><span class="ln">478  </span></a>      <span class="s1">p.enforce();</span>
+<a name="l479"><span class="ln">479  </span></a>      <span class="s1">catalog.put(p);</span>
+<a name="l480"><span class="ln">480  </span></a>      <span class="s1">audit.add(</span><span class="s3">&quot;admin&quot;</span><span class="s1">,</span><span class="s3">&quot;UPSERT_PRODUCT&quot;</span><span class="s1">, sku, </span><span class="s3">&quot;local&quot;</span><span class="s1">);</span>
+<a name="l481"><span class="ln">481  </span></a>      <span class="s0">return </span><span class="s1">Map.of(</span><span class="s3">&quot;ok&quot;</span><span class="s1">,</span><span class="s3">&quot;saved&quot;</span><span class="s1">,</span><span class="s3">&quot;sku&quot;</span><span class="s1">,p.sku(),</span><span class="s3">&quot;price_eur&quot;</span><span class="s1">,p.priceCentsEUR()/</span><span class="s4">100.0</span><span class="s1">,</span><span class="s3">&quot;kind&quot;</span><span class="s1">,p.kind());</span>
+<a name="l482"><span class="ln">482  </span></a>    <span class="s1">}</span>
+<a name="l483"><span class="ln">483  </span></a>
+<a name="l484"><span class="ln">484  </span></a>    <span class="s2">/** Manuell freischalten (z. B. nach Überweisung) → 10-Minuten-Link */</span>
+<a name="l485"><span class="ln">485  </span></a>    <span class="s1">@PostMapping(</span><span class="s3">&quot;/manual-issue&quot;</span><span class="s1">)</span>
+<a name="l486"><span class="ln">486  </span></a>    <span class="s0">public </span><span class="s1">Map&lt;String,String&gt; manualIssue(@RequestHeader(</span><span class="s3">&quot;X-Admin-Token&quot;</span><span class="s1">) String t,</span>
+<a name="l487"><span class="ln">487  </span></a>                                          <span class="s1">@RequestParam String sku,</span>
+<a name="l488"><span class="ln">488  </span></a>                                          <span class="s1">@RequestParam(required=</span><span class="s0">false</span><span class="s1">) String buyerEmail) {</span>
+<a name="l489"><span class="ln">489  </span></a>      <span class="s1">auth(t);</span>
+<a name="l490"><span class="ln">490  </span></a>      <span class="s2">// fiktive Order</span>
+<a name="l491"><span class="ln">491  </span></a>      <span class="s1">orders.create(sku, buyerEmail);</span>
+<a name="l492"><span class="ln">492  </span></a>      <span class="s1">String token = orders.issueDownloadToken(sku, buyerEmail, </span><span class="s4">600</span><span class="s1">);</span>
+<a name="l493"><span class="ln">493  </span></a>      <span class="s1">String link = orders.linkFromToken(token);</span>
+<a name="l494"><span class="ln">494  </span></a>      <span class="s1">audit.add(</span><span class="s3">&quot;admin&quot;</span><span class="s1">,</span><span class="s3">&quot;MANUAL_ISSUE&quot;</span><span class="s1">, sku + </span><span class="s3">&quot; to &quot; </span><span class="s1">+ buyerEmail, </span><span class="s3">&quot;local&quot;</span><span class="s1">);</span>
+<a name="l495"><span class="ln">495  </span></a>      <span class="s0">return </span><span class="s1">Map.of(</span><span class="s3">&quot;download&quot;</span><span class="s1">, link);</span>
+<a name="l496"><span class="ln">496  </span></a>    <span class="s1">}</span>
+<a name="l497"><span class="ln">497  </span></a>
+<a name="l498"><span class="ln">498  </span></a>    <span class="s1">@GetMapping(</span><span class="s3">&quot;/orders&quot;</span><span class="s1">)</span>
+<a name="l499"><span class="ln">499  </span></a>    <span class="s0">public </span><span class="s1">Collection&lt;Order&gt; orders(@RequestHeader(</span><span class="s3">&quot;X-Admin-Token&quot;</span><span class="s1">) String t) {</span>
+<a name="l500"><span class="ln">500  </span></a>      <span class="s1">auth(t);</span>
+<a name="l501"><span class="ln">501  </span></a>      <span class="s0">return </span><span class="s1">orders.list();</span>
+<a name="l502"><span class="ln">502  </span></a>    <span class="s1">}</span>
+<a name="l503"><span class="ln">503  </span></a>
+<a name="l504"><span class="ln">504  </span></a>    <span class="s1">@GetMapping(</span><span class="s3">&quot;/audit&quot;</span><span class="s1">)</span>
+<a name="l505"><span class="ln">505  </span></a>    <span class="s0">public </span><span class="s1">List&lt;Audit&gt; audit(@RequestHeader(</span><span class="s3">&quot;X-Admin-Token&quot;</span><span class="s1">) String t, @RequestParam(defaultValue = </span><span class="s3">&quot;25&quot;</span><span class="s1">) </span><span class="s0">int </span><span class="s1">tail) {</span>
+<a name="l506"><span class="ln">506  </span></a>      <span class="s1">auth(t);</span>
+<a name="l507"><span class="ln">507  </span></a>      <span class="s0">return new </span><span class="s1">ArrayList&lt;&gt;(audit.tail(Math.max(</span><span class="s4">1</span><span class="s1">, Math.min(</span><span class="s4">200</span><span class="s1">, tail))));</span>
+<a name="l508"><span class="ln">508  </span></a>    <span class="s1">}</span>
+<a name="l509"><span class="ln">509  </span></a>  <span class="s1">}</span>
+<a name="l510"><span class="ln">510  </span></a><span class="s1">}</span>
+<a name="l511"><span class="ln">511  </span></a></pre>
+</body>
+</html>
