+<a name="l143"><span class="ln">143  </span></a>  <span class="s8">// Message handling (vision + optional sensors/learn stats)</span>
+<a name="l144"><span class="ln">144  </span></a>  <span class="s0">window.addEventListener(</span><span class="s3">'message'</span><span class="s0">, (ev)=&gt;{</span>
