+      + '<button id="btnHardReload" style="margin-left:6px;background:#10261e;color:#a8ffdf;border:1px solid rgba(168,255,223,.35);padding:4px 8px;border-radius:8px;cursor:pointer">Cache leeren & neu laden</button>'
+      + '</div>'
