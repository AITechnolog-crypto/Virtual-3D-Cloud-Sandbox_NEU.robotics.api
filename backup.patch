+<a name="l212"><span class="ln">212  </span></a>  <span class="s0">canvas.addEventListener(</span><span class="s3">'pointerdown'</span><span class="s0">, e=&gt;{ drag=</span><span class="s8">true</span><span class="s0">; lx=e.clientX; ly=e.clientY })</span>
