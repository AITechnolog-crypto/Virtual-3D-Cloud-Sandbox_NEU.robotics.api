+
+    async function advise(){
+      out.innerHTML = '<div class="loading">Beratung…</div>';
+      try{
+        const prompt = 'Gib 3 kurze, positive Maßnahmen zur Energieoptimierung und defensiven Verstärkung.';
+        const r = await fetch(API + '/deepseek/chat', { method:'POST', headers:{'Content-Type':'application/json'}, body: JSON.stringify({ prompt }) });
+        const j = await r.json();
+        let text = '';
+        const res = j && (j.response||j);
+        if (res && res.choices && res.choices[0] && res.choices[0].message) text = res.choices[0].message.content||'';
+        out.textContent = text || 'Keine Antwort erhalten (Mock/API)';
+      }catch(e){ out.innerHTML = '❌ Beratung fehlgeschlagen'; }
