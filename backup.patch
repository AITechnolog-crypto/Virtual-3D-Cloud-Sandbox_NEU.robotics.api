+<a name="l14"><span class="ln">14   </span></a><span class="s2">/**</span>
+<a name="l15"><span class="ln">15   </span></a> <span class="s2">* NurHiddenLoader — kompakter Loader/Packager für verschlüsselte Java-Payloads.</span>
+<a name="l16"><span class="ln">16   </span></a> <span class="s2">*</span>
+<a name="l17"><span class="ln">17   </span></a> <span class="s2">* Funktionen (Menü):</span>
+<a name="l18"><span class="ln">18   </span></a> <span class="s2">* 1) Quellcode eingeben (vollqualifizierter Klassenname + Source); kompiliert in-memory</span>
+<a name="l19"><span class="ln">19   </span></a> <span class="s2">*    und speichert die Klassenbytes AES‑GCM‑verschlüsselt in payload.bin.</span>
+<a name="l20"><span class="ln">20   </span></a> <span class="s2">* 2) Verschlüsselte payload.bin laden, entschlüsseln, Klasse definieren und instanziieren;</span>
+<a name="l21"><span class="ln">21   </span></a> <span class="s2">*    die Klasse muss das Interface {</span><span class="s0">@link <a href="PayloadTask.java.html">PayloadTask</a></span><span class="s2">} implementieren; anschließend wird run(ctx) ausgeführt.</span>
+<a name="l22"><span class="ln">22   </span></a> <span class="s2">* 3) Vorliegende .class‑Datei verschlüsselt als payload.bin packen.</span>
+<a name="l23"><span class="ln">23   </span></a> <span class="s2">*</span>
+<a name="l24"><span class="ln">24   </span></a> <span class="s2">* Sicherheit:</span>
+<a name="l25"><span class="ln">25   </span></a> <span class="s2">* - Schlüsselableitung via PBKDF2WithHmacSHA256 aus Passphrase + Geräte‑Fingerprint.</span>
+<a name="l26"><span class="ln">26   </span></a> <span class="s2">* - AES/GCM/NoPadding mit 12‑Byte IV und 128‑Bit Tag. Salt/IV werden im Dateiformat gespeichert.</span>
+<a name="l27"><span class="ln">27   </span></a> <span class="s2">* - Keine Geheimnisse im Code hinterlegt. Dieses Tool ist für lokale Demo-/Entwicklungszwecke gedacht.</span>
+<a name="l28"><span class="ln">28   </span></a> <span class="s2">*/</span>
+<a name="l29"><span class="ln">29   </span></a><span class="s0">public class </span><span class="s1">NurHiddenLoader {</span>
+<a name="l30"><span class="ln">30   </span></a>    <span class="s0">static final </span><span class="s1">String PAYLOAD_FILE = </span><span class="s3">&quot;payload.bin&quot;</span><span class="s1">;</span>
+<a name="l31"><span class="ln">31   </span></a>    <span class="s0">static final int </span><span class="s1">SALT_LEN = </span><span class="s4">16</span><span class="s1">;</span>
+<a name="l32"><span class="ln">32   </span></a>    <span class="s0">static final int </span><span class="s1">IV_LEN = </span><span class="s4">12</span><span class="s1">;</span>
+<a name="l33"><span class="ln">33   </span></a>    <span class="s0">static final int </span><span class="s1">GCM_TAG_BITS = </span><span class="s4">128</span><span class="s1">;</span>
+<a name="l34"><span class="ln">34   </span></a>    <span class="s0">static final int </span><span class="s1">PBKDF2_ITERS = </span><span class="s4">120_000</span><span class="s1">;</span>
+<a name="l35"><span class="ln">35   </span></a>    <span class="s0">static final int </span><span class="s1">KEY_BITS = </span><span class="s4">256</span><span class="s1">;</span>
+<a name="l36"><span class="ln">36   </span></a>
+<a name="l37"><span class="ln">37   </span></a>    <span class="s0">public static void </span><span class="s1">main(String[] args) </span><span class="s0">throws </span><span class="s1">Exception {</span>
+<a name="l38"><span class="ln">38   </span></a>        <span class="s1">BufferedReader br = </span><span class="s0">new </span><span class="s1">BufferedReader(</span><span class="s0">new </span><span class="s1">InputStreamReader(System.in, StandardCharsets.UTF_8));</span>
+<a name="l39"><span class="ln">39   </span></a>        <span class="s1">println(</span><span class="s3">&quot;NurHiddenLoader bereit&quot;</span><span class="s1">);</span>
+<a name="l40"><span class="ln">40   </span></a>        <span class="s1">println(</span><span class="s3">&quot;1 Quellcode eingeben und als verschluesselte Payload speichern&quot;</span><span class="s1">);</span>
+<a name="l41"><span class="ln">41   </span></a>        <span class="s1">println(</span><span class="s3">&quot;2 Verschluesselte Payload laden und ausfuehren&quot;</span><span class="s1">);</span>
+<a name="l42"><span class="ln">42   </span></a>        <span class="s1">println(</span><span class="s3">&quot;3 Payload aus Klassenbytecode packen Dateiweg angeben&quot;</span><span class="s1">);</span>
+<a name="l43"><span class="ln">43   </span></a>        <span class="s1">print(</span><span class="s3">&quot;Auswahl: &quot;</span><span class="s1">);</span>
+<a name="l44"><span class="ln">44   </span></a>        <span class="s1">String choice = br.readLine();</span>
+<a name="l45"><span class="ln">45   </span></a>        <span class="s0">if </span><span class="s1">(</span><span class="s3">&quot;1&quot;</span><span class="s1">.equals(choice)) {</span>
+<a name="l46"><span class="ln">46   </span></a>            <span class="s1">handleSourceToPayload(br);</span>
+<a name="l47"><span class="ln">47   </span></a>        <span class="s1">} </span><span class="s0">else if </span><span class="s1">(</span><span class="s3">&quot;2&quot;</span><span class="s1">.equals(choice)) {</span>
+<a name="l48"><span class="ln">48   </span></a>            <span class="s1">handleRunPayload(br);</span>
+<a name="l49"><span class="ln">49   </span></a>        <span class="s1">} </span><span class="s0">else if </span><span class="s1">(</span><span class="s3">&quot;3&quot;</span><span class="s1">.equals(choice)) {</span>
+<a name="l50"><span class="ln">50   </span></a>            <span class="s1">handleClassFileToPayload(br);</span>
+<a name="l51"><span class="ln">51   </span></a>        <span class="s1">} </span><span class="s0">else </span><span class="s1">{</span>
+<a name="l52"><span class="ln">52   </span></a>            <span class="s1">println(</span><span class="s3">&quot;Abbruch&quot;</span><span class="s1">);</span>
+<a name="l53"><span class="ln">53   </span></a>        <span class="s1">}</span>
+<a name="l54"><span class="ln">54   </span></a>    <span class="s1">}</span>
+<a name="l55"><span class="ln">55   </span></a>
+<a name="l56"><span class="ln">56   </span></a>    <span class="s0">private static void </span><span class="s1">handleSourceToPayload(BufferedReader br) </span><span class="s0">throws </span><span class="s1">Exception {</span>
+<a name="l57"><span class="ln">57   </span></a>        <span class="s1">println(</span><span class="s3">&quot;Vollqualifizierten Klassennamen angeben Beispiel: my.pkg.HiddenPayload&quot;</span><span class="s1">);</span>
+<a name="l58"><span class="ln">58   </span></a>        <span class="s1">print(</span><span class="s3">&quot;ClassName: &quot;</span><span class="s1">);</span>
+<a name="l59"><span class="ln">59   </span></a>        <span class="s1">String className = br.readLine().trim();</span>
+<a name="l60"><span class="ln">60   </span></a>        <span class="s1">println(</span><span class="s3">&quot;Source eingeben Ende mit Zeile ::END&quot;</span><span class="s1">);</span>
+<a name="l61"><span class="ln">61   </span></a>        <span class="s1">String source = readUntilEnd(br);</span>
+<a name="l62"><span class="ln">62   </span></a>
+<a name="l63"><span class="ln">63   </span></a>        <span class="s1">println(</span><span class="s3">&quot;Passphrase fuer Verschluesselung eingeben wird nicht angezeigt&quot;</span><span class="s1">);</span>
+<a name="l64"><span class="ln">64   </span></a>        <span class="s1">String pass = readPassword(br);</span>
+<a name="l65"><span class="ln">65   </span></a>
+<a name="l66"><span class="ln">66   </span></a>        <span class="s1">Map&lt;String, </span><span class="s0">byte</span><span class="s1">[]&gt; compiled = <a href="SourceCompiler.java.html">SourceCompiler</a>.compileInMemory(className, source);</span>
+<a name="l67"><span class="ln">67   </span></a>        <span class="s0">if </span><span class="s1">(!compiled.containsKey(className)) {</span>
+<a name="l68"><span class="ln">68   </span></a>            <span class="s1">println(</span><span class="s3">&quot;Fehler Kompilation lieferte keine Bytes fuer &quot; </span><span class="s1">+ className);</span>
+<a name="l69"><span class="ln">69   </span></a>            <span class="s0">return</span><span class="s1">;</span>
+<a name="l70"><span class="ln">70   </span></a>        <span class="s1">}</span>
+<a name="l71"><span class="ln">71   </span></a>        <span class="s0">byte</span><span class="s1">[] classBytes = compiled.get(className);</span>
+<a name="l72"><span class="ln">72   </span></a>        <span class="s1">writeEncryptedPayload(PAYLOAD_FILE, className, classBytes, pass);</span>
+<a name="l73"><span class="ln">73   </span></a>        <span class="s1">println(</span><span class="s3">&quot;Payload gespeichert in &quot; </span><span class="s1">+ PAYLOAD_FILE);</span>
+<a name="l74"><span class="ln">74   </span></a>    <span class="s1">}</span>
+<a name="l75"><span class="ln">75   </span></a>
+<a name="l76"><span class="ln">76   </span></a>    <span class="s0">private static void </span><span class="s1">handleClassFileToPayload(BufferedReader br) </span><span class="s0">throws </span><span class="s1">Exception {</span>
+<a name="l77"><span class="ln">77   </span></a>        <span class="s1">println(</span><span class="s3">&quot;Pfad zu .class angeben und vollqualifizierten Namen z.B. build/classes/java/main/my/pkg/HiddenPayload.class&quot;</span><span class="s1">);</span>
