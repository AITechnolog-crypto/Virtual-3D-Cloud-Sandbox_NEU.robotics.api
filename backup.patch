+
+            // Java-Programmierungen (Echtzeit, via SW-Mock oder Backend)
+            try {
+                fetch(window.location.origin + '/api/meta/java-counts', { cache: 'no-store' })
+                  .then(r => r.ok ? r.json() : null)
+                  .then(j => {
