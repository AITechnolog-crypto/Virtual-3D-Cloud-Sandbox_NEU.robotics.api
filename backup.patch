+      <div class="muted">Noch keine Nachrichten…</div>
+    </div>
+    <div class="row" style="margin-top:8px">
+      <input id="chatSender" placeholder="Dein Name (optional)" style="flex:1;min-width:160px">
+      <input id="chatText" placeholder="Nachricht eingeben…" style="flex:3;min-width:220px">
+      <button class="btn" id="btnSend">Senden</button>
+      <button class="btn ghost" id="btnAssist">Assistent antwortet</button>
+    </div>
+    <div class="muted" style="margin-top:6px">Kanal: <code id="chatChan">customer</code> • Hash: <code id="chatHead">–</code></div>
+  </div>
+</div>
+
+<script>
+// SW registrieren (für Mock‑APIs/Offline‑Vorschau)
+if ('serviceWorker' in navigator){ window.addEventListener('load',()=>{ navigator.serviceWorker.register('sw-mock-api.js').catch(()=>{}); }); }
+const API = location.origin + '/api';
+
+// Workspace toggles & DS key
+const LS_WS_AUTO = 'ws.autoIngest';
+const LS_WS_CTX  = 'ws.context';
+const LS_DS_KEY  = 'deepseek.key';
+(function(){
+  try{
+    const auto = localStorage.getItem(LS_WS_AUTO) !== '0';
+    const ctx  = localStorage.getItem(LS_WS_CTX)  !== '0';
+    const key  = localStorage.getItem(LS_DS_KEY)  || '';
+    const elA = document.getElementById('wsAutoIngest'); if (elA) { elA.checked = auto; elA.addEventListener('change', ()=> localStorage.setItem(LS_WS_AUTO, elA.checked? '1':'0')); }
+    const elC = document.getElementById('wsContext');   if (elC) { elC.checked = ctx;  elC.addEventListener('change', ()=> localStorage.setItem(LS_WS_CTX,  elC.checked? '1':'0')); }
+    const elK = document.getElementById('dsKey');       if (elK) elK.value = key ? (key.slice(0,6)+'…'+key.slice(-4)) : '';
+    const status = document.getElementById('wsStatus');
+    const btn = document.getElementById('btnSaveKey');
+    if (btn){ btn.addEventListener('click', async ()=>{
+      try{
+        const raw = prompt('DeepSeek API‑Key eingeben (wird lokal gespeichert):', key||'')||'';
+        if (!raw) return;
+        localStorage.setItem(LS_DS_KEY, raw.trim());
+        if (status) status.textContent = '🔐 Key gespeichert (lokal).';
+        // optional: SW informieren
+        try{ await fetch(API + '/deepseek/key', { method:'POST', headers:{'Content-Type':'application/json'}, body: JSON.stringify({ key: raw.trim() }) }); }catch(_){ }
+        if (elK) elK.value = raw.trim() ? (raw.trim().slice(0,6)+'…'+raw.trim().slice(-4)) : '';
+      }catch(e){ if (status) status.textContent = '❌ Fehler beim Speichern'; }
+    }); }
+  }catch(_){ }
+})();
+
+function dsHeaders(){ const k = localStorage.getItem(LS_DS_KEY)||''; return k? { 'x-deepseek-key': k }: {}; }
+function withContextPrompt(base){ try{ const on = (localStorage.getItem(LS_WS_CTX)!=='0'); if (!on) return base; const list = JSON.parse(localStorage.getItem('java_bausteine_ui_v2')||'[]'); const recent = list.slice(0,3).map(sn=> `• ${sn.title||''} [${(sn.tags||[]).join(', ')}]\n${(sn.text||'').slice(0,400)}` ).join("\n\n"); if (!recent) return base; return `Kontext (letzte Snippets):\n${recent}\n\nFrage:\n${base}`; }catch(_){ return base; }}
+
+// Live‑Zähler
+(async function live(){
+  function set(id, txt){ const el=document.getElementById(id); if(el) el.textContent = txt; }
+  async function tick(){
+    try{ const j = await fetch(API+'/meta/java-counts',{cache:'no-store'}).then(r=>r.json()); const total = Number(j.controllers||0)+Number(j.services||0)+Number(j.repositories||0)+Number(j.models||0); set('liveJava', total.toLocaleString('de-DE')); }catch(_){ }
+    try{ const n = await fetch(API+'/drones/count',{cache:'no-store'}).then(r=>r.json()); set('liveDrones', Number(n).toLocaleString('de-DE')); }catch(_){ }
+    try{ const s = await fetch(API+'/telemetry/status',{cache:'no-store'}).then(r=>r.json()); const tEl=document.getElementById('liveThreats'); if (Math.random()>0.985){ tEl.textContent = String(Number(tEl.textContent||'0')+1); } }catch(_){ }
+  }
+  tick(); setInterval(tick, 5000);
+})();
+
+// Tabs
+(function(){
+  const tabs=document.getElementById('tabs'); const panels=['p-snippets','p-deepseek','p-models','p-ml','p-chat'];
+  tabs.addEventListener('click', (e)=>{ const b=e.target.closest('.tab'); if(!b) return; tabs.querySelectorAll('.tab').forEach(x=>x.classList.remove('active')); b.classList.add('active'); panels.forEach(id=>{ const p=document.getElementById(id); if(p) p.style.display = (b.dataset.panel===id)?'block':'none'; }); });
+})();
+
+// Snippets (lokal)
+(function(){
+  const KEY='java_bausteine_ui_v2';
+  function load(){ try{ return JSON.parse(localStorage.getItem(KEY)||'[]'); }catch(_){ return []; } }
+  function save(arr){ try{ localStorage.setItem(KEY, JSON.stringify(arr)); }catch(_){ } }
+  function norm(sn){ const t=(sn.title||'').trim(); const x=(sn.text||'').trim(); const tags=Array.isArray(sn.tags)? sn.tags : String(sn.tags||'').split(',').map(s=>s.trim()).filter(Boolean); const id=sn.id||String(Math.abs((t+'|'+x).split('').reduce((h,c)=>((h*31+c.charCodeAt(0))|0),0))); return { id, ts: sn.ts||Date.now(), title:t||('Snippet '+new Date().toLocaleString()), tags, text:x }; }
+  const elTitle=snTitle, elTags=snTags, elText=snText, elList=snList, elSearch=snSearch;
+  function render(){ const q=(elSearch.value||'').toLowerCase(); const list=load().map(norm).filter(it=> (it.title+' '+it.tags.join(',')).toLowerCase().includes(q)); if(!list.length){ elList.textContent='Noch keine Bausteine.'; return; } const wrap=document.createElement('div'); wrap.style.display='flex'; wrap.style.flexDirection='column'; wrap.style.gap='8px'; list.forEach(it=>{ const d=document.createElement('details'); d.open=false; d.style.border='1px solid rgba(255,255,255,.12)'; d.style.borderRadius='10px'; d.style.padding='8px'; d.style.background='rgba(255,255,255,.04)'; const s=document.createElement('summary'); s.innerHTML = `<strong>${escapeHtml(it.title)}</strong> <span class="muted">[${escapeHtml(it.tags.join(', '))}]</span>`+` <button class="btn ghost" data-act="copy" style="padding:4px 8px">Kopieren</button>`+` <button class="btn ghost" data-act="del" style="padding:4px 8px">Löschen</button>`; const pre=document.createElement('pre'); pre.style.whiteSpace='pre-wrap'; pre.style.margin='6px 0 0'; pre.textContent=it.text; d.appendChild(s); d.appendChild(pre); d.addEventListener('click',(ev)=>{ const t=ev.target; if(t&&t.dataset&&t.dataset.act){ ev.preventDefault(); ev.stopPropagation(); if(t.dataset.act==='copy'){ navigator.clipboard.writeText(it.text).catch(()=>{}); } if(t.dataset.act==='del'){ const arr=load().filter(x=> (x.id||'')!==it.id); save(arr); render(); } } }); wrap.appendChild(d); }); elList.innerHTML=''; elList.appendChild(wrap); }
+  function escapeHtml(s){ return String(s||'').replace(/[&<>]/g, m=> ({'&':'&amp;','<':'&lt;','>':'&gt;'}[m])); }
+  snSave.addEventListener('click', async ()=>{ const t=(elTitle.value||'').trim(), g=(elTags.value||'').trim(), x=(elText.value||'').trim(); if(!x){ alert('Bitte Inhalt eingeben'); return; } const arr=load(); const sn=norm({title:t,text:x,tags:g}); const idx=arr.findIndex(a=> (a.id||'')===sn.id); if(idx>=0) arr[idx]=sn; else arr.unshift(sn); save(arr); elText.value=''; render(); try{ if ((localStorage.getItem('ws.autoIngest')||localStorage.getItem('ws.autoIngest')===null) && (localStorage.getItem('ws.autoIngest')!=='0')){ const features={ textLen: sn.text.length, lineCount: (sn.text.match(/\n/g)||[]).length+1, tagCount: sn.tags.length }; await fetch(API+'/ml/ingest',{ method:'POST', headers:{'Content-Type':'application/json'}, body: JSON.stringify({ features, label: sn.title, source:'java-interface' }) }).catch(()=>{}); document.getElementById('wsStatus') && (document.getElementById('wsStatus').textContent='📤 Ingest gesendet'); } }catch(_){ } });
+  snClear.addEventListener('click', ()=>{ if(confirm('Wirklich alle Bausteine löschen?')){ save([]); render(); } });
+  snExport.addEventListener('click', ()=>{ try{ const a=document.createElement('a'); a.href=URL.createObjectURL(new Blob([JSON.stringify(load(),null,2)],{type:'application/json'})); a.download='java_bausteine.json'; a.click(); setTimeout(()=>URL.revokeObjectURL(a.href), 1000); }catch(_){ } });
+  snImport.addEventListener('change', async (e)=>{ try{ const f=e.target.files&&e.target.files[0]; if(!f) return; const txt=await f.text(); const arr=JSON.parse(txt); if(Array.isArray(arr)){ const cur=load().map(norm); arr.map(norm).forEach(sn=>{ const i=cur.findIndex(x=> (x.id||'')===sn.id); if(i>=0) cur[i]=sn; else cur.unshift(sn); }); save(cur); render(); } }catch(_){ } e.target.value=''; });
+  elSearch.addEventListener('input', render);
+  render();
+})();
+
+// DeepSeek Beratung
+(function(){
+  const out=dsAnswer; const input=dsPrompt;
+  async function ask(){ let prompt=(input.value||'').trim(); if(!prompt){ out.textContent='Bitte eine Frage eingeben.'; return; } prompt = withContextPrompt(prompt); out.innerHTML='<div class="muted">Lade…</div>'; try{ const r=await fetch(API+'/deepseek/chat',{ method:'POST', headers:Object.assign({'Content-Type':'application/json'}, dsHeaders()), body: JSON.stringify({ prompt }) }); const j=await r.json().catch(()=>({})); let text=''; const res=j && (j.response||j); if (res && res.choices && res.choices[0] && res.choices[0].message) text=res.choices[0].message.content||''; out.textContent = text || 'Keine Antwort.'; }catch(e){ out.textContent='❌ Fehler'; } }
+  dsAsk.addEventListener('click', ask);
+  dsTokenTest.addEventListener('click', async ()=>{ out.innerHTML='<div class="muted">Teste…</div>'; try{ const r=await fetch(API+'/deepseek/chat',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({prompt:'PING'})}); out.textContent = r.ok? '✅ OK' : '⚠️ Problem'; }catch(_){ out.textContent='❌ Fehler'; } });
+})();
+
+// Modelle & Embeddings
+(function(){
+  btnLoadModels.addEventListener('click', async ()=>{ const out=modelsOut; out.innerHTML='<div class="muted">Lade…</div>'; try{ const r=await fetch(API+'/deepseek/models',{ headers: dsHeaders() }); const j=await r.json(); const list = (j && j.data) ? j.data.map(m=>m.id).join(', ') : 'Keine Daten'; out.textContent='Modelle: '+list; }catch(e){ out.textContent='❌ Fehler'; } });
+  btnEmbeddings.addEventListener('click', async ()=>{ const out=embOut; const text=(embInput.value||'').trim(); if(!text){ out.textContent='Bitte Text eingeben'; return; } out.innerHTML='<div class="muted">Berechne…</div>'; try{ const model=dsModel.value||'deepseek-embed'; const r=await fetch(API+'/deepseek/embeddings',{method:'POST',headers:Object.assign({'Content-Type':'application/json'}, dsHeaders()),body:JSON.stringify({ model, input:text })}); const j=await r.json(); if(!r.ok){ out.textContent='❌ Fehler'; return; } const vec=(j.data&&j.data[0]&&j.data[0].embedding)||[]; out.textContent='Embedding‑Länge: '+vec.length+' | Beispiel: ['+vec.slice(0,8).map(n=>Number(n).toFixed(3)).join(', ')+']'; }catch(_){ out.textContent='❌ Fehler'; } });
+})();
+
+// ML Train/Predict (einfach)
+(function(){
+  async function refreshStatus(){ try{ const s=await fetch(API+'/ml/status').then(r=>r.json()); const st=document.getElementById('mlStatus'); st.textContent = s && s.model && s.model.trained ? ('n='+s.model.n) : '–'; }catch(_){ } }
+  btnTrain.addEventListener('click', async ()=>{ const out=mlOut; out.innerHTML='<div class="muted">Trainiere…</div>'; try{ const j=await fetch(API+'/ml/train',{method:'POST'}).then(r=>r.json()); out.textContent='✅ Trainiert (n='+(j.n||0)+', Trend='+(j.slope!=null? Number(j.slope).toFixed(2):'-')+')'; refreshStatus(); }catch(_){ out.textContent='❌ Fehler'; } });
+  btnPredict.addEventListener('click', async ()=>{ const out=mlOut; out.innerHTML='<div class="muted">Prognose…</div>'; try{ const j=await fetch(API+'/ml/predict?steps=10').then(r=>r.json()); const list=(j.predictions||[]).slice(0,10).map((v,i)=> (i+1)+': '+Number(v).toFixed(0)).join(', '); out.textContent='🔮 '+list; }catch(_){ out.textContent='❌ Fehler'; } });
+  refreshStatus();
+})();
+
+// Chatbot
+(function(){
+  let channel=localStorage.getItem('chat_channel')||'customer';
+  function setChan(){ const el=document.getElementById('chatChan'); if(el) el.textContent = channel; }
+  async function loadHistory(){ try{ const arr=await fetch(API+'/chat/history?channel='+encodeURIComponent(channel)+'&limit=50').then(r=>r.json()); const box=document.getElementById('chatList'); box.innerHTML=''; arr.forEach(m=> box.insertAdjacentHTML('beforeend', msgHtml(m))); box.scrollTop = box.scrollHeight; }catch(_){ } }
