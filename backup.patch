+        const old = window.updateEnergyChart;
+        const wrapped = function(v){
+          try{ if (typeof v === 'number' && detector.push(v)) { showExplain('Anomalie erkannt bei Energie: '+Number(v).toLocaleString('de-DE')+' kWh'); } }catch(_){ }
+          return old.apply(this, arguments);
+        };
+        wrapped.__withAnomaly = true;
+        window.updateEnergyChart = wrapped;
+      }
+    }
+    // Try periodically until the chart updater exists
+    const iv = setInterval(wrap, 800);
