+            <div class="small">Plasma</div><div class="meter"><div id="mPlasma"></div></div>
+          </div>
+          <div>
+            <div class="small">Levitation</div><div class="meter"><div id="mLev"></div></div>
+          </div>
+          <div>
+            <div class="small">Ritual-Charge</div><div class="meter"><div id="mCharge"></div></div>
+          </div>
+        </div>
+      </div>
+      <div class="ritualbuttons">
+        <button class="btn" onclick="ritual.inschallah()">Inschallah</button>
