+<a name="l25"><span class="ln">25   </span></a>           <span class="s2">&quot;LOWER(b.name) LIKE LOWER(CONCAT('%', :keyword, '%')) OR &quot; </span><span class="s1">+</span>
+<a name="l26"><span class="ln">26   </span></a>           <span class="s2">&quot;LOWER(b.description) LIKE LOWER(CONCAT('%', :keyword, '%'))&quot;</span><span class="s1">)</span>
