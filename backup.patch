+<a name="l390"><span class="ln">390  </span></a>  <span class="s7">const </span><span class="s0">onUp = ()=&gt;{down=</span><span class="s7">false</span><span class="s0">; lastA=</span><span class="s7">null</span><span class="s0">;};</span>
+<a name="l391"><span class="ln">391  </span></a>  <span class="s0">pad.addEventListener(</span><span class="s3">'pointerdown'</span><span class="s0">,onDown); pad.addEventListener(</span><span class="s3">'pointermove'</span><span class="s0">,onMove); pad.addEventListener(</span><span class="s3">'pointerup'</span><span class="s0">,onUp);</span>
+<a name="l392"><span class="ln">392  </span></a>  <span class="s0">pad.addEventListener(</span><span class="s3">'touchstart'</span><span class="s0">,onDown,{passive:</span><span class="s7">true</span><span class="s0">}); pad.addEventListener(</span><span class="s3">'touchmove'</span><span class="s0">,onMove,{passive:</span><span class="s7">true</span><span class="s0">}); pad.addEventListener(</span><span class="s3">'touchend'</span><span class="s0">,onUp);</span>
