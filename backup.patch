+<table CELLSPACING=0 CELLPADDING=5 COLS=1 WIDTH="100%" BGCOLOR="#606060" >
+<tr><td><center>
+<font face="Arial, Helvetica" color="#000000">
+AutonomousMachine.java</font>
+</center></td></tr></table>
+<pre><a name="l1"><span class="ln">1    </span></a><span class="s0">package </span><span class="s1">com.june.autonomy;</span>
+<a name="l2"><span class="ln">2    </span></a>
+<a name="l3"><span class="ln">3    </span></a><span class="s0">import <a href="../../../com/june/autonomy/action/IAction.java.html">com.june.autonomy.action.IAction</a></span><span class="s1">;</span>
+<a name="l4"><span class="ln">4    </span></a><span class="s0">import <a href="../../../com/june/autonomy/action/MoveAction.java.html">com.june.autonomy.action.MoveAction</a></span><span class="s1">;</span>
+<a name="l5"><span class="ln">5    </span></a>
+<a name="l6"><span class="ln">6    </span></a><span class="s0">import </span><span class="s1">java.util.concurrent.ThreadLocalRandom;</span>
+<a name="l7"><span class="ln">7    </span></a><span class="s0">import </span><span class="s1">java.util.logging.Level;</span>
+<a name="l8"><span class="ln">8    </span></a><span class="s0">import </span><span class="s1">java.util.logging.Logger;</span>
+<a name="l9"><span class="ln">9    </span></a>
+<a name="l10"><span class="ln">10   </span></a><span class="s2">/**</span>
+<a name="l11"><span class="ln">11   </span></a> <span class="s2">* Einfache Implementierung einer autonomen Maschine mit steuerbarer Aggressivität.</span>
+<a name="l12"><span class="ln">12   </span></a> <span class="s2">* Fehlerwahrscheinlichkeiten werden basierend auf dem Aggressivitätsgrad simuliert.</span>
+<a name="l13"><span class="ln">13   </span></a> <span class="s2">*/</span>
+<a name="l14"><span class="ln">14   </span></a><span class="s0">public class </span><span class="s1">AutonomousMachine </span><span class="s0">implements <a href="IAutonomousMachine.java.html">IAutonomousMachine</a> </span><span class="s1">{</span>
+<a name="l15"><span class="ln">15   </span></a>    <span class="s0">private static final </span><span class="s1">Logger logger = Logger.getLogger(AutonomousMachine.</span><span class="s0">class</span><span class="s1">.getName());</span>
+<a name="l16"><span class="ln">16   </span></a>
+<a name="l17"><span class="ln">17   </span></a>    <span class="s2">// Aggressivität im Bereich [0, 1]. volatile für Thread-Reads ohne Lock.</span>
+<a name="l18"><span class="ln">18   </span></a>    <span class="s0">private volatile double </span><span class="s1">aggressiveness = </span><span class="s3">0.5</span><span class="s1">; </span><span class="s2">// Standardaggressivität</span>
+<a name="l19"><span class="ln">19   </span></a>
+<a name="l20"><span class="ln">20   </span></a>    <span class="s1">@Override</span>
+<a name="l21"><span class="ln">21   </span></a>    <span class="s0">public void </span><span class="s1">performPositiveActions() {</span>
+<a name="l22"><span class="ln">22   </span></a>        <span class="s0">try </span><span class="s1">{</span>
+<a name="l23"><span class="ln">23   </span></a>            <span class="s1">logger.info(</span><span class="s4">&quot;Starte positive Aktionen.&quot;</span><span class="s1">);</span>
+<a name="l24"><span class="ln">24   </span></a>            <span class="s2">// ... tatsächliche Logik ... (Platzhalter)</span>
+<a name="l25"><span class="ln">25   </span></a>
+<a name="l26"><span class="ln">26   </span></a>            <span class="s2">// Zufälliger Fehler basierend auf Aggressivität: je aggressiver, desto höher die Fehlerrate</span>
+<a name="l27"><span class="ln">27   </span></a>            <span class="s0">double </span><span class="s1">rnd = ThreadLocalRandom.current().nextDouble();</span>
+<a name="l28"><span class="ln">28   </span></a>            <span class="s0">if </span><span class="s1">(rnd &gt; (</span><span class="s3">1.0 </span><span class="s1">- aggressiveness)) {</span>
+<a name="l29"><span class="ln">29   </span></a>                <span class="s0">throw new </span><span class="s1">RuntimeException(</span><span class="s4">&quot;Fehler bei positiver Aktion!&quot;</span><span class="s1">);</span>
+<a name="l30"><span class="ln">30   </span></a>            <span class="s1">}</span>
+<a name="l31"><span class="ln">31   </span></a>
+<a name="l32"><span class="ln">32   </span></a>            <span class="s1">logger.info(</span><span class="s4">&quot;Positive Aktionen erfolgreich abgeschlossen.&quot;</span><span class="s1">);</span>
+<a name="l33"><span class="ln">33   </span></a>        <span class="s1">} </span><span class="s0">catch </span><span class="s1">(Exception e) {</span>
+<a name="l34"><span class="ln">34   </span></a>            <span class="s1">logger.log(Level.SEVERE, </span><span class="s4">&quot;Fehler bei positiven Aktionen: &quot;</span><span class="s1">, e);</span>
+<a name="l35"><span class="ln">35   </span></a>            <span class="s2">// ggf. weitere Fehlerbehandlung (Retry/Compensation)</span>
+<a name="l36"><span class="ln">36   </span></a>        <span class="s1">}</span>
+<a name="l37"><span class="ln">37   </span></a>    <span class="s1">}</span>
+<a name="l38"><span class="ln">38   </span></a>
+<a name="l39"><span class="ln">39   </span></a>    <span class="s2">/**</span>
+<a name="l40"><span class="ln">40   </span></a>     <span class="s2">* Neue Variante gemäß Spezifikation: führt genau eine Aktion aus, sofern sie nicht negativ ist.</span>
+<a name="l41"><span class="ln">41   </span></a>     <span class="s2">*/</span>
+<a name="l42"><span class="ln">42   </span></a>    <span class="s1">@Override</span>
+<a name="l43"><span class="ln">43   </span></a>    <span class="s0">public void </span><span class="s1">performPositiveActions(<a href="../../../com/june/autonomy/action/IAction.java.html">IAction</a> action) {</span>
+<a name="l44"><span class="ln">44   </span></a>        <span class="s0">try </span><span class="s1">{</span>
+<a name="l45"><span class="ln">45   </span></a>            <span class="s0">if </span><span class="s1">(action == </span><span class="s0">null</span><span class="s1">) {</span>
+<a name="l46"><span class="ln">46   </span></a>                <span class="s1">logger.warning(</span><span class="s4">&quot;Keine Aktion übergeben – überspringe.&quot;</span><span class="s1">);</span>
+<a name="l47"><span class="ln">47   </span></a>                <span class="s0">return</span><span class="s1">;</span>
+<a name="l48"><span class="ln">48   </span></a>            <span class="s1">}</span>
+<a name="l49"><span class="ln">49   </span></a>            <span class="s0">if </span><span class="s1">(action.isNegative()) {</span>
+<a name="l50"><span class="ln">50   </span></a>                <span class="s1">logger.warning(</span><span class="s4">&quot;Negative Aktion erkannt: &quot; </span><span class="s1">+ action.getDescription() + </span><span class="s4">&quot;. Aktion wird nicht ausgeführt.&quot;</span><span class="s1">);</span>
+<a name="l51"><span class="ln">51   </span></a>                <span class="s0">return</span><span class="s1">;</span>
+<a name="l52"><span class="ln">52   </span></a>            <span class="s1">}</span>
+<a name="l53"><span class="ln">53   </span></a>            <span class="s1">logger.info(</span><span class="s4">&quot;Führe positive Aktion aus: &quot; </span><span class="s1">+ action.getDescription());</span>
+<a name="l54"><span class="ln">54   </span></a>            <span class="s2">// Beispiel: spezielle Logik für MoveAction</span>
+<a name="l55"><span class="ln">55   </span></a>            <span class="s0">if </span><span class="s1">(action </span><span class="s0">instanceof <a href="../../../com/june/autonomy/action/MoveAction.java.html">MoveAction</a> </span><span class="s1">move) {</span>
+<a name="l56"><span class="ln">56   </span></a>                <span class="s2">// Platzhalter: Hier könnte Bewegung ausgeführt werden</span>
+<a name="l57"><span class="ln">57   </span></a>                <span class="s1">logger.info(</span><span class="s4">&quot;Spezifische MoveAction-Logik: Distanz=&quot; </span><span class="s1">+ move.getDistance());</span>
+<a name="l58"><span class="ln">58   </span></a>            <span class="s1">}</span>
+<a name="l59"><span class="ln">59   </span></a>
+<a name="l60"><span class="ln">60   </span></a>            <span class="s2">// Fehlerwahrscheinlichkeit wie in der Alt-API</span>
+<a name="l61"><span class="ln">61   </span></a>            <span class="s0">double </span><span class="s1">rnd = ThreadLocalRandom.current().nextDouble();</span>
+<a name="l62"><span class="ln">62   </span></a>            <span class="s0">if </span><span class="s1">(rnd &gt; (</span><span class="s3">1.0 </span><span class="s1">- aggressiveness)) {</span>
+<a name="l63"><span class="ln">63   </span></a>                <span class="s0">throw new </span><span class="s1">RuntimeException(</span><span class="s4">&quot;Fehler bei Aktion: &quot; </span><span class="s1">+ action.getDescription());</span>
+<a name="l64"><span class="ln">64   </span></a>            <span class="s1">}</span>
+<a name="l65"><span class="ln">65   </span></a>            <span class="s1">logger.info(</span><span class="s4">&quot;Aktion erfolgreich abgeschlossen: &quot; </span><span class="s1">+ action.getDescription());</span>
+<a name="l66"><span class="ln">66   </span></a>        <span class="s1">} </span><span class="s0">catch </span><span class="s1">(Exception e) {</span>
+<a name="l67"><span class="ln">67   </span></a>            <span class="s1">logger.log(Level.SEVERE, </span><span class="s4">&quot;Fehler bei der Ausführung der Aktion: &quot; </span><span class="s1">+ (action != </span><span class="s0">null </span><span class="s1">? action.getDescription() : </span><span class="s4">&quot;&lt;null&gt;&quot;</span><span class="s1">), e);</span>
+<a name="l68"><span class="ln">68   </span></a>        <span class="s1">}</span>
+<a name="l69"><span class="ln">69   </span></a>    <span class="s1">}</span>
+<a name="l70"><span class="ln">70   </span></a>
+<a name="l71"><span class="ln">71   </span></a>    <span class="s1">@Override</span>
+<a name="l72"><span class="ln">72   </span></a>    <span class="s0">public void </span><span class="s1">preventNegativeActions() {</span>
+<a name="l73"><span class="ln">73   </span></a>        <span class="s0">try </span><span class="s1">{</span>
+<a name="l74"><span class="ln">74   </span></a>            <span class="s1">logger.info(</span><span class="s4">&quot;Starte Verhinderung negativer Aktionen.&quot;</span><span class="s1">);</span>
+<a name="l75"><span class="ln">75   </span></a>            <span class="s2">// ... tatsächliche Logik ... (Platzhalter)</span>
+<a name="l76"><span class="ln">76   </span></a>
+<a name="l77"><span class="ln">77   </span></a>            <span class="s2">// Zufälliger Fehler basierend auf Aggressivität: je aggressiver, desto höher die Fehlerrate</span>
+<a name="l78"><span class="ln">78   </span></a>            <span class="s0">double </span><span class="s1">rnd = ThreadLocalRandom.current().nextDouble();</span>
+<a name="l79"><span class="ln">79   </span></a>            <span class="s0">if </span><span class="s1">(rnd &lt; aggressiveness) {</span>
+<a name="l80"><span class="ln">80   </span></a>                <span class="s0">throw new </span><span class="s1">RuntimeException(</span><span class="s4">&quot;Fehler bei der Verhinderung negatiger Aktionen!&quot;</span><span class="s1">);</span>
+<a name="l81"><span class="ln">81   </span></a>            <span class="s1">}</span>
+<a name="l82"><span class="ln">82   </span></a>
+<a name="l83"><span class="ln">83   </span></a>            <span class="s1">logger.info(</span><span class="s4">&quot;Verhinderung negativer Aktionen erfolgreich abgeschlossen.&quot;</span><span class="s1">);</span>
+<a name="l84"><span class="ln">84   </span></a>        <span class="s1">} </span><span class="s0">catch </span><span class="s1">(Exception e) {</span>
+<a name="l85"><span class="ln">85   </span></a>            <span class="s1">logger.log(Level.SEVERE, </span><span class="s4">&quot;Fehler bei der Verhinderung negativer Aktionen: &quot;</span><span class="s1">, e);</span>
+<a name="l86"><span class="ln">86   </span></a>            <span class="s2">// ggf. weitere Fehlerbehandlung</span>
+<a name="l87"><span class="ln">87   </span></a>        <span class="s1">}</span>
+<a name="l88"><span class="ln">88   </span></a>    <span class="s1">}</span>
+<a name="l89"><span class="ln">89   </span></a>
+<a name="l90"><span class="ln">90   </span></a>    <span class="s1">@Override</span>
+<a name="l91"><span class="ln">91   </span></a>    <span class="s0">public void </span><span class="s1">setAggressiveness(</span><span class="s0">double </span><span class="s1">aggressiveness) {</span>
+<a name="l92"><span class="ln">92   </span></a>        <span class="s0">if </span><span class="s1">(aggressiveness &lt; </span><span class="s3">0.0 </span><span class="s1">|| aggressiveness &gt; </span><span class="s3">1.0</span><span class="s1">) {</span>
+<a name="l93"><span class="ln">93   </span></a>            <span class="s0">throw new </span><span class="s1">IllegalArgumentException(</span><span class="s4">&quot;Aggressivität muss zwischen 0 und 1 liegen.&quot;</span><span class="s1">);</span>
+<a name="l94"><span class="ln">94   </span></a>        <span class="s1">}</span>
+<a name="l95"><span class="ln">95   </span></a>        <span class="s0">this</span><span class="s1">.aggressiveness = aggressiveness;</span>
+<a name="l96"><span class="ln">96   </span></a>        <span class="s1">logger.info(</span><span class="s4">&quot;Aggressivität gesetzt auf: &quot; </span><span class="s1">+ aggressiveness);</span>
+<a name="l97"><span class="ln">97   </span></a>    <span class="s1">}</span>
+<a name="l98"><span class="ln">98   </span></a><span class="s1">}</span>
+<a name="l99"><span class="ln">99   </span></a></pre>
+</body>
