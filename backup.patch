+    ['input','change'].forEach(ev=>{
+      [els.nodes,els.storage,els.net,els.drones,els.robots].forEach(x=> x.addEventListener(ev, ()=>{ updateLabels(); save(); }));
+    });
+
+    load(); utilization(); setInterval(utilization, 4000);
+  }
+
+  // 3) Visual Pack (Glow/Bloom Light) – sanfter Effekt ohne externe Abhängigkeit
+  function mountVisualPack(){
+    const inner = [
+      '<div class="small muted">Ein/Aus: sanfter Leuchteffekt der 3D‑Elemente (emissive/opacity). Vorsicht bei schwachen Geräten.</div>',
+      '<div style="display:flex;gap:8px;align-items:center;margin-top:6px">',
+      '  <label><input type="checkbox" id="vpGlow"> Glow/Bloom</label>',
+      '  <button class="btn" id="vpApply">Anwenden</button>',
+      '</div>',
+      '<div id="vpOut" class="small muted" style="margin-top:6px">Bereit.</div>'
+    ].join('');
+    const c = card('✨ Visual Pack', inner); addCard(c);
+    const cb = c.querySelector('#vpGlow');
+    const out = c.querySelector('#vpOut');
+    cb.checked = localStorage.getItem('visual.glow') === '1';
+
+    function apply(){
+      localStorage.setItem('visual.glow', cb.checked ? '1':'0');
+      try{
+        const mats = window.__materials || {};
+        if (mats.particles && mats.particles.color){
+          mats.particles.color.set(cb.checked? 0x66ffee : 0x00ffcc);
+          mats.particles.opacity = cb.checked? 0.95 : 0.85;
+          mats.particles.size = cb.checked? 2.8 : 2.0;
+        }
+        if (mats.globe){ mats.globe.opacity = cb.checked? 0.28 : 0.18; }
+        if (mats.ring){ mats.ring.opacity = cb.checked? 0.45 : 0.30; }
