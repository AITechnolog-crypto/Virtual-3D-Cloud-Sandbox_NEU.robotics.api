+  <button class="btn" onclick="airpods.gesture('inschallah')">🎧 Long-Press (Inschallah)</button>
+  <button class="btn" onclick="airpods.gesture('openGlobe')">🎧 Triple-Tap (Globus)</button>
+  <button class="btn" onclick="airpods.gesture('openStart')">🎧 Triple-Tap (Start)</button>
+</div>
+
+<!-- Panels -->
+<div class="panel" id="biopanel" style="display:none">
+  <h3>Biometrie (offline, hash-basiert)</h3>
+  <div class="small">Speichere deinen Marker/Key-Hash nur lokal (localStorage). Kein Internet, keine echte DNA.</div>
+  <div class="row" style="margin-top:8px">
+    <input id="enrollHash" placeholder="Marker-SHA-256" style="width:360px">
+    <button class="btn" onclick="bio.enroll()">Enroll</button>
