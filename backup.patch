+  // Events
+  document.getElementById('btnHardReload').addEventListener('click', async ()=>{
+    try{
+      if (navigator.serviceWorker){ const regs = await navigator.serviceWorker.getRegistrations(); for(const r of regs){ try{ await r.unregister(); }catch(_){} } }
+      if (window.caches && caches.keys){ const ks = await caches.keys(); for(const k of ks){ try{ await caches.delete(k); }catch(_){} } }
+    }catch(_){}
+    const u = new URL(location.href); u.searchParams.set('v', Date.now()); location.replace(u.toString());
+  });
+  // Start
+  animateSwarm(); loadJavaCounts(); tick(); setInterval(tick, 6000);
+})();
