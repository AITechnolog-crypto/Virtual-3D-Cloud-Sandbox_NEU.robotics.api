+  }catch(e){ out.innerHTML='❌ Fehler: '+(e.message||e); }
+}
+function serpPrevBlock(){ const chat=!!(document.getElementById('serpChatMode')||{}).checked; const lex=!!(document.getElementById('serpLex')||{}).checked; if(chat||!lex) return; const el=document.getElementById('serpBlock'); el.value=Math.max(0, parseInt((el&&el.value)||0)-1); searchSerp(); }
+function serpNextBlock(){ const chat=!!(document.getElementById('serpChatMode')||{}).checked; const lex=!!(document.getElementById('serpLex')||{}).checked; if(chat||!lex) return; const el=document.getElementById('serpBlock'); el.value=Math.max(0, parseInt((el&&el.value)||0)+1); searchSerp(); }
