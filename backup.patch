+<a name="l17"><span class="ln">17   </span></a>    
+<a name="l18"><span class="ln">18   </span></a>    <span class="s1">@Query(</span><span class="s2">&quot;SELECT b FROM Blueprint b WHERE b.name = :name &quot; </span><span class="s1">+</span>
