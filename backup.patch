+<!-- Zusatz: KI‑Verbund Diagnose & Ziel‑/Schlüssel‑Handling -->
+<script>
+(function(){
+  const API = window.location.origin + '/api';
+  const LS = {
+    goal: 'cloud_goal_v1', horizon: 'cloud_goal_horizon_v1',
+    ds: 'DEEPSEEK_API_KEY_UI', serp: 'SERPAPI_KEY_UI'
+  };
+
+  function byId(id){ return document.getElementById(id); }
+  function setText(id, txt){ const el = byId(id); if (el) el.innerHTML = txt; }
+  function badge(txt, color){
+    const c = color||'#98a2c6';
+    return '<span style="display:inline-block;padding:4px 8px;border-radius:999px;border:1px solid rgba(255,255,255,.12);background:rgba(255,255,255,.06);margin:2px;color:'+c+'">'+txt+'</span>';
+  }
+  function fmt(ms){ try{ return (ms>=1000? (ms/1000).toFixed(1)+'s' : ms+'ms'); }catch(_){ return ms+'ms'; } }
+
+  async function fetchJson(url, opts){
+    const ctl = new AbortController();
+    const t = setTimeout(()=> ctl.abort(), (opts && opts.timeout) || 8000);
+    try {
+      const r = await fetch(url, { ...(opts||{}), signal: ctl.signal });
+      clearTimeout(t);
+      const ct = (r.headers.get('content-type')||'').toLowerCase();
+      const isJson = ct.includes('application/json');
+      const data = isJson ? await r.json().catch(()=>({})) : await r.text();
+      return { ok:r.ok, status:r.status, data };
+    } catch(e){ clearTimeout(t); return { ok:false, status:0, data:{ error: String(e&&e.message||e) } }; }
+  }
+
+  async function diagnose(kind){
+    const out = byId('meshDiagOut'); if (!out) return;
+    out.innerHTML = '<div class="small muted">Starte Diagnose…</div>';
+    const start = Date.now();
+    const tasks = [
+      { name:'Health', url: API+'/health' },
+      { name:'Telemetry', url: API+'/telemetry/status' },
+      { name:'ML Status', url: API+'/ml/status' },
+      { name:'Federation', url: API+'/federation/aggregate' },
+      { name:'Chat Verify', url: API+'/chat/verify?channel=customer' },
+      { name:'SERP Ping', url: API+'/serp/ping' }
+    ];
+    if (kind === 'quick') {
+      // Smaller subset
+      tasks.splice(2,2); // remove ML Status + Federation for quick
+    }
+    const results = [];
+    for (const t of tasks){
+      const t0 = Date.now();
+      const r = await fetchJson(t.url);
+      const dt = Date.now()-t0;
+      let statusTxt = r.ok ? 'OK' : ('ERR '+r.status);
+      let color = r.ok ? '#00ff88' : (r.status===503||r.status===502? '#ffaa00' : '#ff4d6d');
+      let extra = '';
+      try {
+        if (t.name==='SERP Ping'){ extra = (r.data && (r.data.hasKey===true || r.data.hasKey==='true')) ? 'Key auf Server: gesetzt' : 'Key auf Server: fehlt'; }
+        if (t.name==='Chat Verify'){ extra = (r.data && r.data.valid===true)? 'Chain ok' : 'Chain n/v'; }
+      } catch(_){ }
+      results.push({ name:t.name, ms:dt, ok:r.ok, color, statusTxt, extra });
+    }
+    const okCount = results.filter(x=>x.ok).length;
+    const total = results.length;
+    let html = '<div class="small">Ergebnis: '+badge(okCount+'/'+total+' OK', okCount===total?'#00ff88':(okCount? '#ffaa00':'#ff4d6d'))+'</div>';
+    html += '<div style="margin-top:6px">';
+    results.forEach(r=>{
+      html += '<div style="margin:4px 0;display:flex;align-items:center;justify-content:space-between;gap:8px">'
+           + '<div>'+badge(r.name, r.color)+' '+(r.extra? '<span class="small muted">'+r.extra+'</span>':'')+'</div>'
+           + '<div class="small muted">'+r.statusTxt+' • '+fmt(r.ms)+'</div>'
+           + '</div>';
+    });
+    html += '</div>';
+    out.innerHTML = html;
+  }
+
+  function loadLocal(){
+    try{ const g = localStorage.getItem(LS.goal)||''; const h = localStorage.getItem(LS.horizon)||''; if (byId('goalText')) byId('goalText').value=g; if (byId('goalHorizon')) byId('goalHorizon').value=h||30; }catch(_){ }
+    try{ if (byId('keyDeepseek')) byId('keyDeepseek').value = localStorage.getItem(LS.ds)||''; if (byId('keySerp')) byId('keySerp').value = localStorage.getItem(LS.serp)||''; }catch(_){ }
+  }
+
+  async function saveGoal(){
+    const goal = (byId('goalText')&&byId('goalText').value||'').trim();
+    const horizon = parseInt((byId('goalHorizon')&&byId('goalHorizon').value)||'30');
+    if (!goal){ setText('goalOut','Bitte ein Ziel eingeben.'); return; }
+    try{ localStorage.setItem(LS.goal, goal); localStorage.setItem(LS.horizon, String(horizon)); }catch(_){ }
+    setText('goalOut', '📌 Ziel gespeichert (lokal): '+goal+' • Horizont '+horizon+' Tage – verbinde…');
+    // Try POST to ML Plan (if available)
+    try{
+      const r = await fetch(API + '/ml/plan', { method:'POST', headers:{'Content-Type':'application/json'}, body: JSON.stringify({ goal, horizon, source:'cloud-architecture' }) });
+      const ok = r.ok; const j = await r.json().catch(()=>({}));
+      if (ok) setText('goalOut', '✅ Server übernommen: '+(j && (j.ok||'OK')));
+      else setText('goalOut', '⚠️ Server antwortete mit '+r.status+' – Ziel bleibt lokal gespeichert.');
+    } catch(e){ setText('goalOut', 'ℹ️ Offline: Ziel lokal gespeichert.'); }
+  }
+  function clearGoal(){ try{ localStorage.removeItem(LS.goal); localStorage.removeItem(LS.horizon); }catch(_){ } setText('goalOut','♻️ Ziel gelöscht (lokal).'); if (byId('goalText')) byId('goalText').value=''; }
+
+  function saveKeys(){
+    try{ const ds = (byId('keyDeepseek')&&byId('keyDeepseek').value||'').trim(); const sp = (byId('keySerp')&&byId('keySerp').value||'').trim(); localStorage.setItem(LS.ds, ds); localStorage.setItem(LS.serp, sp); setText('keysOut','🔏 Gespeichert (nur lokal).'); }catch(_){ }
+  }
+  async function testKeys(){
+    setText('keysOut','Teste Schnittstellen…');
+    const c1 = await fetchJson(API + '/deepseek/chat', { method:'POST', headers:{'Content-Type':'application/json'}, body: JSON.stringify({ prompt:'PING' }) });
+    const c2 = await fetchJson(API + '/serp/ping');
+    const ok1 = c1.ok; const ok2 = c2.ok;
+    const hasSerp = c2.ok && c2.data && (c2.data.hasKey===true || c2.data.hasKey==='true');
+    let msg = (ok1? '✅ Chatbot ':'❌ Chatbot ')+ (ok1? 'OK':'Fehler') + ' • ';
+    msg += (ok2? 'SERP ':'SERP ') + (ok2? (hasSerp? 'OK (Key gesetzt)':'OK (Key fehlt)') : 'Fehler');
+    setText('keysOut', msg);
+  }
+
+  window.addEventListener('DOMContentLoaded', function(){
+    loadLocal();
+    const b1 = byId('meshDiagBtn'); if (b1) b1.addEventListener('click', ()=> diagnose('full'));
+    const b2 = byId('meshDiagQuick'); if (b2) b2.addEventListener('click', ()=> diagnose('quick'));
+    const s1 = byId('goalSave'); if (s1) s1.addEventListener('click', saveGoal);
+    const s2 = byId('goalClear'); if (s2) s2.addEventListener('click', clearGoal);
+    const k1 = byId('saveKeys'); if (k1) k1.addEventListener('click', saveKeys);
+    const k2 = byId('testKeys'); if (k2) k2.addEventListener('click', testKeys);
+  });
+})();
+</script>
