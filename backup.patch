@@ -0,0 +1,66 @@
+<html>
+<head>
+<title>saas-client.js</title>
+<meta http-equiv="Content-Type" content="text/html; charset=utf-8">
+<style type="text/css">
+.s0 { color: #808080;}
+.s1 { color: #afb9c3;}
+.s2 { color: #c88cdc;}
+.s3 { color: #96be78;}
+.ln { color: #555555; font-weight: normal; font-style: normal; }
+</style>
+</head>
+<body bgcolor="#1a2426">
+<table CELLSPACING=0 CELLPADDING=5 COLS=1 WIDTH="100%" BGCOLOR="#606060" >
+<tr><td><center>
+<font face="Arial, Helvetica" color="#000000">
+saas-client.js</font>
+</center></td></tr></table>
+<pre><a name="l1"><span class="ln">1    </span></a><span class="s0">// saas-client.js — minimal client for Azure Functions or similar SaaS endpoints</span>
+<a name="l2"><span class="ln">2    </span></a><span class="s0">// Persisted config (localStorage): saas.base, saas.token</span>
+<a name="l3"><span class="ln">3    </span></a><span class="s1">(</span><span class="s2">function</span><span class="s1">(){</span>
+<a name="l4"><span class="ln">4    </span></a>  <span class="s2">const </span><span class="s1">LS_BASE = </span><span class="s3">'saas.base'</span><span class="s1">;</span>
+<a name="l5"><span class="ln">5    </span></a>  <span class="s2">const </span><span class="s1">LS_TOKEN = </span><span class="s3">'saas.token'</span><span class="s1">;</span>
+<a name="l6"><span class="ln">6    </span></a>
+<a name="l7"><span class="ln">7    </span></a>  <span class="s2">function </span><span class="s1">getBase(){ </span><span class="s2">return </span><span class="s1">(localStorage.getItem(LS_BASE)||</span><span class="s3">''</span><span class="s1">).trim(); }</span>
+<a name="l8"><span class="ln">8    </span></a>  <span class="s2">function </span><span class="s1">getToken(){ </span><span class="s2">return </span><span class="s1">(localStorage.getItem(LS_TOKEN)||</span><span class="s3">''</span><span class="s1">).trim(); }</span>
+<a name="l9"><span class="ln">9    </span></a>  <span class="s2">function </span><span class="s1">setBase(v){ </span><span class="s2">try</span><span class="s1">{ localStorage.setItem(LS_BASE, String(v||</span><span class="s3">''</span><span class="s1">).trim()); }</span><span class="s2">catch</span><span class="s1">(_){} SaaS.base = getBase(); </span><span class="s2">return </span><span class="s1">SaaS.base; }</span>
+<a name="l10"><span class="ln">10   </span></a>  <span class="s2">function </span><span class="s1">setToken(v){ </span><span class="s2">try</span><span class="s1">{ localStorage.setItem(LS_TOKEN, String(v||</span><span class="s3">''</span><span class="s1">).trim()); }</span><span class="s2">catch</span><span class="s1">(_){} SaaS.token = getToken(); </span><span class="s2">return </span><span class="s1">SaaS.token; }</span>
+<a name="l11"><span class="ln">11   </span></a>  <span class="s2">function </span><span class="s1">head(){ </span><span class="s2">const </span><span class="s1">h = { </span><span class="s3">'Content-Type'</span><span class="s1">:</span><span class="s3">'application/json' </span><span class="s1">}; </span><span class="s2">const </span><span class="s1">t = getToken(); </span><span class="s2">if </span><span class="s1">(t) h[</span><span class="s3">'Authorization'</span><span class="s1">] = </span><span class="s3">'Bearer ' </span><span class="s1">+ t; </span><span class="s2">return </span><span class="s1">h; }</span>
+<a name="l12"><span class="ln">12   </span></a>
+<a name="l13"><span class="ln">13   </span></a>  <span class="s1">async </span><span class="s2">function </span><span class="s1">health(){ </span><span class="s2">const </span><span class="s1">r = </span><span class="s2">await </span><span class="s1">fetch(getBase() + </span><span class="s3">'/health'</span><span class="s1">); </span><span class="s2">return </span><span class="s1">r.json(); }</span>
+<a name="l14"><span class="ln">14   </span></a>  <span class="s1">async </span><span class="s2">function </span><span class="s1">config(){ </span><span class="s2">const </span><span class="s1">r = </span><span class="s2">await </span><span class="s1">fetch(getBase() + </span><span class="s3">'/config'</span><span class="s1">, { headers: head() }); </span><span class="s2">return </span><span class="s1">r.json(); }</span>
+<a name="l15"><span class="ln">15   </span></a>  <span class="s1">async </span><span class="s2">function </span><span class="s1">skills(){ </span><span class="s2">const </span><span class="s1">r = </span><span class="s2">await </span><span class="s1">fetch(getBase() + </span><span class="s3">'/skillpack'</span><span class="s1">, { headers: head() }); </span><span class="s2">return </span><span class="s1">r.json(); }</span>
+<a name="l16"><span class="ln">16   </span></a>  <span class="s1">async </span><span class="s2">function </span><span class="s1">events(ev){ </span><span class="s2">try</span><span class="s1">{ </span><span class="s2">await </span><span class="s1">fetch(getBase() + </span><span class="s3">'/events'</span><span class="s1">, { method:</span><span class="s3">'POST'</span><span class="s1">, headers: head(), body: JSON.stringify(ev||{}) }); }</span><span class="s2">catch</span><span class="s1">(_){ </span><span class="s0">/* no-op */ </span><span class="s1">} }</span>
+<a name="l17"><span class="ln">17   </span></a>  <span class="s1">async </span><span class="s2">function </span><span class="s1">infer(state){ </span><span class="s2">const </span><span class="s1">r = </span><span class="s2">await </span><span class="s1">fetch(getBase() + </span><span class="s3">'/infer'</span><span class="s1">, { method:</span><span class="s3">'POST'</span><span class="s1">, headers: head(), body: JSON.stringify(state||{}) }); </span><span class="s2">return </span><span class="s1">r.json(); }</span>
+<a name="l18"><span class="ln">18   </span></a>
+<a name="l19"><span class="ln">19   </span></a>  <span class="s0">// Public API</span>
+<a name="l20"><span class="ln">20   </span></a>  <span class="s2">const </span><span class="s1">SaaS = window.SaaS = {</span>
+<a name="l21"><span class="ln">21   </span></a>    <span class="s1">base: getBase(),</span>
+<a name="l22"><span class="ln">22   </span></a>    <span class="s1">token: getToken(),</span>
+<a name="l23"><span class="ln">23   </span></a>    <span class="s1">setBase, setToken,</span>
+<a name="l24"><span class="ln">24   </span></a>    <span class="s1">head,</span>
+<a name="l25"><span class="ln">25   </span></a>    <span class="s1">health, config, skills, events, infer,</span>
+<a name="l26"><span class="ln">26   </span></a>    <span class="s0">// aliases matching the issue description</span>
+<a name="l27"><span class="ln">27   </span></a>    <span class="s1">async inferAssist(state){ </span><span class="s2">return </span><span class="s1">infer(state); },</span>
+<a name="l28"><span class="ln">28   </span></a>    <span class="s1">async sendEvent(ev){ </span><span class="s2">return </span><span class="s1">events(ev); }</span>
+<a name="l29"><span class="ln">29   </span></a>  <span class="s1">};</span>
+<a name="l30"><span class="ln">30   </span></a>
+<a name="l31"><span class="ln">31   </span></a>  <span class="s0">// Helper to wire Remote/Skills once base is configured</span>
+<a name="l32"><span class="ln">32   </span></a>  <span class="s1">SaaS.applyRemote = async </span><span class="s2">function</span><span class="s1">(){</span>
+<a name="l33"><span class="ln">33   </span></a>    <span class="s2">try</span><span class="s1">{</span>
+<a name="l34"><span class="ln">34   </span></a>      <span class="s2">if </span><span class="s1">(</span><span class="s2">typeof </span><span class="s1">window.Remote === </span><span class="s3">'object' </span><span class="s1">&amp;&amp; </span><span class="s2">typeof </span><span class="s1">window.Remote.setSource === </span><span class="s3">'function'</span><span class="s1">){</span>
+<a name="l35"><span class="ln">35   </span></a>        <span class="s1">window.Remote.setSource(getBase() + </span><span class="s3">'/config'</span><span class="s1">);</span>
+<a name="l36"><span class="ln">36   </span></a>      <span class="s1">}</span>
+<a name="l37"><span class="ln">37   </span></a>      <span class="s2">if </span><span class="s1">(</span><span class="s2">typeof </span><span class="s1">window.Skills === </span><span class="s3">'object' </span><span class="s1">&amp;&amp; </span><span class="s2">typeof </span><span class="s1">window.Skills.sync === </span><span class="s3">'function'</span><span class="s1">){</span>
+<a name="l38"><span class="ln">38   </span></a>        <span class="s2">await </span><span class="s1">window.Skills.sync(getBase() + </span><span class="s3">'/skillpack'</span><span class="s1">);</span>
+<a name="l39"><span class="ln">39   </span></a>      <span class="s1">}</span>
+<a name="l40"><span class="ln">40   </span></a>    <span class="s1">}</span><span class="s2">catch</span><span class="s1">(_){ }</span>
+<a name="l41"><span class="ln">41   </span></a>  <span class="s1">};</span>
+<a name="l42"><span class="ln">42   </span></a>
+<a name="l43"><span class="ln">43   </span></a>  <span class="s0">// If base already set, try to preload Remote/Skills non-blocking</span>
+<a name="l44"><span class="ln">44   </span></a>  <span class="s2">if </span><span class="s1">(getBase()) { SaaS.applyRemote().catch(()=&gt;{}); }</span>
+<a name="l45"><span class="ln">45   </span></a><span class="s1">})();</span>
+<a name="l46"><span class="ln">46   </span></a></pre>
+</body>
+</html>
