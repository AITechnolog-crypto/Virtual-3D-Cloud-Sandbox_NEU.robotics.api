+<a name="l46"><span class="ln">46   </span></a>        <span class="s0">for </span><span class="s1">(T produkt : lagerMap.values()) {</span>
+<a name="l47"><span class="ln">47   </span></a>            <span class="s1">sb.append(produkt).append(</span><span class="s3">&quot;</span><span class="s4">\n</span><span class="s3">&quot;</span><span class="s1">);</span>
