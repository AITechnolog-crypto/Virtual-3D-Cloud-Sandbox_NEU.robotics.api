+      '  <input id="fxBase" placeholder="https://<deine-function>.azurewebsites.net" style="flex:1;min-width:260px;padding:10px;border-radius:8px;border:1px solid rgba(255,255,255,.15);background:rgba(255,255,255,.06);color:#fff"/>',
+      '  <input id="fxTok"  placeholder="X-Functions-Key (optional)" style="flex:1;min-width:220px;padding:10px;border-radius:8px;border:1px solid rgba(255,255,255,.15);background:rgba(255,255,255,.06);color:#fff"/>',
+      '</div>',
+      '<div class="toolbar">',
+      '  <button id="fxSave">💾 Speichern & Verbinden</button>',
+      '  <button id="fxHealth" class="secondary">🩺 Health</button>',
+      '  <button id="fxInfer"  class="secondary">🤖 Infer‑Demo</button>',
