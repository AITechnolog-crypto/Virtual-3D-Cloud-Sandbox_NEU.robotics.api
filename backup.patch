+      </div>
+    </div>
+    <div class="row" style="margin-top:8px;gap:8px;flex-wrap:wrap">
+      <input id="dsKey" placeholder="DeepSeek API‑Key (optional, lokal gespeichert)" style="flex:1;min-width:260px">
+      <button id="btnSaveKey" class="btn ghost">🔐 Key speichern</button>
