+<a name="l11"><span class="ln">11   </span></a><span class="s0">public class </span><span class="s1">WebSocketConfig </span><span class="s0">implements </span><span class="s1">WebSocketMessageBrokerConfigurer {</span>
+<a name="l12"><span class="ln">12   </span></a>    <span class="s1">@Override</span>
+<a name="l13"><span class="ln">13   </span></a>    <span class="s0">public void </span><span class="s1">configureMessageBroker(MessageBrokerRegistry registry) {</span>
+<a name="l14"><span class="ln">14   </span></a>        <span class="s1">registry.enableSimpleBroker(</span><span class="s2">&quot;/topic&quot;</span><span class="s1">);</span>
+<a name="l15"><span class="ln">15   </span></a>        <span class="s1">registry.setApplicationDestinationPrefixes(</span><span class="s2">&quot;/app&quot;</span><span class="s1">);</span>
+<a name="l16"><span class="ln">16   </span></a>    <span class="s1">}</span>
+<a name="l17"><span class="ln">17   </span></a>
+<a name="l18"><span class="ln">18   </span></a>    <span class="s1">@Override</span>
+<a name="l19"><span class="ln">19   </span></a>    <span class="s0">public void </span><span class="s1">registerStompEndpoints(StompEndpointRegistry registry) {</span>
+<a name="l20"><span class="ln">20   </span></a>        <span class="s1">registry.addEndpoint(</span><span class="s2">&quot;/ws&quot;</span><span class="s1">).setAllowedOriginPatterns(</span><span class="s2">&quot;*&quot;</span><span class="s1">);</span>
+<a name="l21"><span class="ln">21   </span></a>    <span class="s1">}</span>
+<a name="l22"><span class="ln">22   </span></a><span class="s1">}</span></pre>
+</body>
+</html>
