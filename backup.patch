@@ -0,0 +1,90 @@
+<html>
+<head>
+<title>DroneProductionSystem.java</title>
+<meta http-equiv="Content-Type" content="text/html; charset=utf-8">
+<style type="text/css">
+.s0 { color: #c88cdc;}
+.s1 { color: #afb9c3;}
+.s2 { color: #808080;}
+.s3 { color: #36beff;}
+.s4 { color: #96be78;}
+.ln { color: #555555; font-weight: normal; font-style: normal; }
+</style>
+</head>
+<body bgcolor="#1a2426">
+<table CELLSPACING=0 CELLPADDING=5 COLS=1 WIDTH="100%" BGCOLOR="#606060" >
+<tr><td><center>
+<font face="Arial, Helvetica" color="#000000">
+DroneProductionSystem.java</font>
+</center></td></tr></table>
+<pre><a name="l1"><span class="ln">1    </span></a><span class="s0">package </span><span class="s1">com.june.simulation;</span>
+<a name="l2"><span class="ln">2    </span></a>
+<a name="l3"><span class="ln">3    </span></a><span class="s0">import </span><span class="s1">java.util.concurrent.ExecutorService;</span>
+<a name="l4"><span class="ln">4    </span></a><span class="s0">import </span><span class="s1">java.util.concurrent.Executors;</span>
+<a name="l5"><span class="ln">5    </span></a><span class="s0">import </span><span class="s1">java.util.concurrent.TimeUnit;</span>
+<a name="l6"><span class="ln">6    </span></a><span class="s0">import </span><span class="s1">java.util.concurrent.atomic.AtomicLong;</span>
+<a name="l7"><span class="ln">7    </span></a><span class="s0">import </span><span class="s1">java.util.logging.Level;</span>
+<a name="l8"><span class="ln">8    </span></a><span class="s0">import </span><span class="s1">java.util.logging.Logger;</span>
+<a name="l9"><span class="ln">9    </span></a>
+<a name="l10"><span class="ln">10   </span></a><span class="s2">/**</span>
+<a name="l11"><span class="ln">11   </span></a> <span class="s2">* Multithreaded Drone Production demo.</span>
+<a name="l12"><span class="ln">12   </span></a> <span class="s2">*</span>
+<a name="l13"><span class="ln">13   </span></a> <span class="s2">* Behavior mirrors the provided issue description: uses a fixed thread pool sized to available</span>
+<a name="l14"><span class="ln">14   </span></a> <span class="s2">* processors, increments a global AtomicLong counter, simulates production latency (10ms),</span>
+<a name="l15"><span class="ln">15   </span></a> <span class="s2">* logs progress per production line, and shuts down gracefully.</span>
+<a name="l16"><span class="ln">16   </span></a> <span class="s2">*</span>
+<a name="l17"><span class="ln">17   </span></a> <span class="s2">* This class is self-contained and does not depend on Spring components.</span>
+<a name="l18"><span class="ln">18   </span></a> <span class="s2">*/</span>
+<a name="l19"><span class="ln">19   </span></a><span class="s0">public class </span><span class="s1">DroneProductionSystem {</span>
+<a name="l20"><span class="ln">20   </span></a>    <span class="s0">private final </span><span class="s1">Logger logger = Logger.getLogger(DroneProductionSystem.</span><span class="s0">class</span><span class="s1">.getName());</span>
+<a name="l21"><span class="ln">21   </span></a>    <span class="s0">private final </span><span class="s1">ExecutorService productionService;</span>
+<a name="l22"><span class="ln">22   </span></a>    <span class="s0">private final </span><span class="s1">AtomicLong droneCount;</span>
+<a name="l23"><span class="ln">23   </span></a>    <span class="s0">private final int </span><span class="s1">numberOfCores;</span>
+<a name="l24"><span class="ln">24   </span></a>
+<a name="l25"><span class="ln">25   </span></a>    <span class="s0">public </span><span class="s1">DroneProductionSystem() {</span>
+<a name="l26"><span class="ln">26   </span></a>        <span class="s0">this</span><span class="s1">.numberOfCores = Runtime.getRuntime().availableProcessors();</span>
+<a name="l27"><span class="ln">27   </span></a>        <span class="s0">this</span><span class="s1">.productionService = Executors.newFixedThreadPool(numberOfCores);</span>
+<a name="l28"><span class="ln">28   </span></a>        <span class="s0">this</span><span class="s1">.droneCount = </span><span class="s0">new </span><span class="s1">AtomicLong(</span><span class="s3">0</span><span class="s1">);</span>
+<a name="l29"><span class="ln">29   </span></a>        <span class="s1">logger.info(</span><span class="s4">&quot;Starte Drohnenproduktion mit &quot; </span><span class="s1">+ numberOfCores + </span><span class="s4">&quot; Produktionslinien.&quot;</span><span class="s1">);</span>
+<a name="l30"><span class="ln">30   </span></a>    <span class="s1">}</span>
+<a name="l31"><span class="ln">31   </span></a>
+<a name="l32"><span class="ln">32   </span></a>    <span class="s0">public void </span><span class="s1">startProduction(</span><span class="s0">long </span><span class="s1">targetDroneCount) {</span>
+<a name="l33"><span class="ln">33   </span></a>        <span class="s0">for </span><span class="s1">(</span><span class="s0">int </span><span class="s1">i = </span><span class="s3">0</span><span class="s1">; i &lt; numberOfCores; i++) {</span>
+<a name="l34"><span class="ln">34   </span></a>            <span class="s1">productionService.execute(() -&gt; {</span>
+<a name="l35"><span class="ln">35   </span></a>                <span class="s0">long </span><span class="s1">localCount = </span><span class="s3">0</span><span class="s1">;</span>
+<a name="l36"><span class="ln">36   </span></a>                <span class="s0">while </span><span class="s1">(droneCount.get() &lt; targetDroneCount) {</span>
+<a name="l37"><span class="ln">37   </span></a>                    <span class="s1">droneCount.incrementAndGet();</span>
+<a name="l38"><span class="ln">38   </span></a>                    <span class="s1">localCount++;</span>
+<a name="l39"><span class="ln">39   </span></a>                    <span class="s0">try </span><span class="s1">{</span>
+<a name="l40"><span class="ln">40   </span></a>                        <span class="s2">// Simuliere die Produktion einer Drohne (10ms Pause)</span>
+<a name="l41"><span class="ln">41   </span></a>                        <span class="s1">Thread.sleep(</span><span class="s3">10</span><span class="s1">);</span>
+<a name="l42"><span class="ln">42   </span></a>                    <span class="s1">} </span><span class="s0">catch </span><span class="s1">(InterruptedException e) {</span>
+<a name="l43"><span class="ln">43   </span></a>                        <span class="s1">logger.log(Level.WARNING, </span><span class="s4">&quot;Thread wurde unterbrochen&quot;</span><span class="s1">, e);</span>
+<a name="l44"><span class="ln">44   </span></a>                        <span class="s1">Thread.currentThread().interrupt();</span>
+<a name="l45"><span class="ln">45   </span></a>                        <span class="s0">break</span><span class="s1">;</span>
+<a name="l46"><span class="ln">46   </span></a>                    <span class="s1">}</span>
+<a name="l47"><span class="ln">47   </span></a>                    <span class="s0">if </span><span class="s1">(localCount % </span><span class="s3">10000 </span><span class="s1">== </span><span class="s3">0</span><span class="s1">) {</span>
+<a name="l48"><span class="ln">48   </span></a>                        <span class="s1">logger.info(</span><span class="s4">&quot;Produktionslinie hat &quot; </span><span class="s1">+ localCount + </span><span class="s4">&quot; Drohnen produziert.&quot;</span><span class="s1">);</span>
+<a name="l49"><span class="ln">49   </span></a>                    <span class="s1">}</span>
+<a name="l50"><span class="ln">50   </span></a>                <span class="s1">}</span>
+<a name="l51"><span class="ln">51   </span></a>                <span class="s1">logger.info(</span><span class="s4">&quot;Produktionslinie beendet. Insgesamt &quot; </span><span class="s1">+ localCount + </span><span class="s4">&quot; Drohnen produziert.&quot;</span><span class="s1">);</span>
+<a name="l52"><span class="ln">52   </span></a>            <span class="s1">});</span>
+<a name="l53"><span class="ln">53   </span></a>        <span class="s1">}</span>
+<a name="l54"><span class="ln">54   </span></a>        <span class="s0">try </span><span class="s1">{</span>
+<a name="l55"><span class="ln">55   </span></a>            <span class="s1">productionService.shutdown();</span>
+<a name="l56"><span class="ln">56   </span></a>            <span class="s1">productionService.awaitTermination(Long.MAX_VALUE, TimeUnit.NANOSECONDS);</span>
+<a name="l57"><span class="ln">57   </span></a>        <span class="s1">} </span><span class="s0">catch </span><span class="s1">(InterruptedException e) {</span>
+<a name="l58"><span class="ln">58   </span></a>            <span class="s1">logger.log(Level.SEVERE, </span><span class="s4">&quot;Das Herunterfahren des ExecutorService wurde unterbrochen&quot;</span><span class="s1">, e);</span>
+<a name="l59"><span class="ln">59   </span></a>            <span class="s1">Thread.currentThread().interrupt();</span>
+<a name="l60"><span class="ln">60   </span></a>        <span class="s1">}</span>
+<a name="l61"><span class="ln">61   </span></a>        <span class="s1">logger.info(</span><span class="s4">&quot;Produktion abgeschlossen. Insgesamt &quot; </span><span class="s1">+ droneCount.get() + </span><span class="s4">&quot; Drohnen produziert.&quot;</span><span class="s1">);</span>
+<a name="l62"><span class="ln">62   </span></a>    <span class="s1">}</span>
+<a name="l63"><span class="ln">63   </span></a>
+<a name="l64"><span class="ln">64   </span></a>    <span class="s0">public static void </span><span class="s1">main(String[] args) {</span>
+<a name="l65"><span class="ln">65   </span></a>        <span class="s1">DroneProductionSystem system = </span><span class="s0">new </span><span class="s1">DroneProductionSystem();</span>
+<a name="l66"><span class="ln">66   </span></a>        <span class="s1">system.startProduction(</span><span class="s3">1_000_000L</span><span class="s1">); </span><span class="s2">// Ziel von 1 Million Drohnen (angepasst für Testzwecke)</span>
+<a name="l67"><span class="ln">67   </span></a>    <span class="s1">}</span>
+<a name="l68"><span class="ln">68   </span></a><span class="s1">}</span>
+<a name="l69"><span class="ln">69   </span></a></pre>
+</body>
+</html>
