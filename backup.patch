+          return old.apply(this, arguments);
+        };
+        wrapped.__withAnomaly = true;
+        window.updateEnergyChart = wrapped;
+      }
+    }
+    // Try periodically until the chart updater exists
+    const iv = setInterval(wrap, 800);
+    setTimeout(()=>{ try{ clearInterval(iv); }catch(_){} }, 20000);
