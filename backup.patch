+<pre><a name="l1"><span class="ln">1    </span></a><span class="s0">package </span><span class="s1">com.june.cloud;</span>
+<a name="l2"><span class="ln">2    </span></a>
+<a name="l3"><span class="ln">3    </span></a><span class="s0">import </span><span class="s1">org.slf4j.Logger;</span>
+<a name="l4"><span class="ln">4    </span></a><span class="s0">import </span><span class="s1">org.slf4j.LoggerFactory;</span>
+<a name="l5"><span class="ln">5    </span></a><span class="s0">import </span><span class="s1">org.springframework.boot.CommandLineRunner;</span>
+<a name="l6"><span class="ln">6    </span></a><span class="s0">import </span><span class="s1">org.springframework.stereotype.Service;</span>
+<a name="l7"><span class="ln">7    </span></a>
+<a name="l8"><span class="ln">8    </span></a><span class="s0">import </span><span class="s1">java.util.List;</span>
+<a name="l9"><span class="ln">9    </span></a>
+<a name="l10"><span class="ln">10   </span></a><span class="s2">/**</span>
+<a name="l11"><span class="ln">11   </span></a> <span class="s2">* Kleine Cloud-Orchestrierung entsprechend der Vorgabe aus dem Issue.</span>
+<a name="l12"><span class="ln">12   </span></a> <span class="s2">*</span>
+<a name="l13"><span class="ln">13   </span></a> <span class="s2">* Hinweise zur Integration in dieses Projekt:</span>
+<a name="l14"><span class="ln">14   </span></a> <span class="s2">* - Die Klassen liegen unter dem Paket &quot;com.june.cloud&quot; und werden dadurch</span>
+<a name="l15"><span class="ln">15   </span></a> <span class="s2">*   automatisch von com.june.JuneApplication via Component-Scan gefunden.</span>
+<a name="l16"><span class="ln">16   </span></a> <span class="s2">* - Es wird KEIN weiterer @SpringBootApplication-Einstiegspunkt erzeugt,</span>
+<a name="l17"><span class="ln">17   </span></a> <span class="s2">*   damit die bestehende JuneApplication die alleinige Main bleibt.</span>
+<a name="l18"><span class="ln">18   </span></a> <span class="s2">*/</span>
+<a name="l19"><span class="ln">19   </span></a>
+<a name="l20"><span class="ln">20   </span></a><span class="s2">// Interface für die Dienste (für bessere Testbarkeit und Entkopplung)</span>
+<a name="l21"><span class="ln">21   </span></a><span class="s0">interface </span><span class="s1">CloudService {</span>
+<a name="l22"><span class="ln">22   </span></a>    <span class="s0">void </span><span class="s1">execute();</span>
+<a name="l23"><span class="ln">23   </span></a><span class="s1">}</span>
+<a name="l24"><span class="ln">24   </span></a>
+<a name="l25"><span class="ln">25   </span></a><span class="s2">// Beispielimplementierungen der Dienste (mit Logging)</span>
+<a name="l26"><span class="ln">26   </span></a><span class="s1">@Service</span>
+<a name="l27"><span class="ln">27   </span></a><span class="s0">class </span><span class="s1">UserExperienceService </span><span class="s0">implements </span><span class="s1">CloudService {</span>
+<a name="l28"><span class="ln">28   </span></a>    <span class="s0">private static final </span><span class="s1">Logger logger = LoggerFactory.getLogger(UserExperienceService.</span><span class="s0">class</span><span class="s1">);</span>
+<a name="l29"><span class="ln">29   </span></a>    <span class="s1">@Override</span>
+<a name="l30"><span class="ln">30   </span></a>    <span class="s0">public void </span><span class="s1">execute() {</span>
+<a name="l31"><span class="ln">31   </span></a>        <span class="s1">logger.info(</span><span class="s3">&quot;Implementiere UX-Verbesserungen.&quot;</span><span class="s1">);</span>
+<a name="l32"><span class="ln">32   </span></a>        <span class="s2">// TODO: Hier die eigentliche Implementierung (z. B. Telemetrie-gestützte UI-Tuning-Jobs)</span>
+<a name="l33"><span class="ln">33   </span></a>    <span class="s1">}</span>
+<a name="l34"><span class="ln">34   </span></a><span class="s1">}</span>
+<a name="l35"><span class="ln">35   </span></a>
+<a name="l36"><span class="ln">36   </span></a><span class="s1">@Service</span>
+<a name="l37"><span class="ln">37   </span></a><span class="s0">class </span><span class="s1">InteroperabilityService </span><span class="s0">implements </span><span class="s1">CloudService {</span>
+<a name="l38"><span class="ln">38   </span></a>    <span class="s0">private static final </span><span class="s1">Logger logger = LoggerFactory.getLogger(InteroperabilityService.</span><span class="s0">class</span><span class="s1">);</span>
+<a name="l39"><span class="ln">39   </span></a>    <span class="s1">@Override</span>
+<a name="l40"><span class="ln">40   </span></a>    <span class="s0">public void </span><span class="s1">execute() {</span>
+<a name="l41"><span class="ln">41   </span></a>        <span class="s1">logger.info(</span><span class="s3">&quot;Stelle Interoperabilität sicher.&quot;</span><span class="s1">);</span>
+<a name="l42"><span class="ln">42   </span></a>        <span class="s2">// TODO: Hier die eigentliche Implementierung (z. B. Format-/API-Kompatibilitätstests)</span>
+<a name="l43"><span class="ln">43   </span></a>    <span class="s1">}</span>
+<a name="l44"><span class="ln">44   </span></a><span class="s1">}</span>
+<a name="l45"><span class="ln">45   </span></a>
+<a name="l46"><span class="ln">46   </span></a><span class="s2">// Zentrale Orchestrierung, die beim Start alle CloudService-Beans ausführt</span>
+<a name="l47"><span class="ln">47   </span></a><span class="s1">@Service</span>
+<a name="l48"><span class="ln">48   </span></a><span class="s0">class </span><span class="s1">CloudSystem </span><span class="s0">implements </span><span class="s1">CommandLineRunner {</span>
+<a name="l49"><span class="ln">49   </span></a>
+<a name="l50"><span class="ln">50   </span></a>    <span class="s0">private static final </span><span class="s1">Logger logger = LoggerFactory.getLogger(CloudSystem.</span><span class="s0">class</span><span class="s1">);</span>
+<a name="l51"><span class="ln">51   </span></a>
+<a name="l52"><span class="ln">52   </span></a>    <span class="s0">private final </span><span class="s1">List&lt;CloudService&gt; cloudServices;</span>
+<a name="l53"><span class="ln">53   </span></a>
+<a name="l54"><span class="ln">54   </span></a>    <span class="s0">public </span><span class="s1">CloudSystem(List&lt;CloudService&gt; cloudServices) {</span>
+<a name="l55"><span class="ln">55   </span></a>        <span class="s0">this</span><span class="s1">.cloudServices = cloudServices;</span>
+<a name="l56"><span class="ln">56   </span></a>    <span class="s1">}</span>
+<a name="l57"><span class="ln">57   </span></a>
+<a name="l58"><span class="ln">58   </span></a>    <span class="s0">public void </span><span class="s1">deploy() {</span>
+<a name="l59"><span class="ln">59   </span></a>        <span class="s1">logger.info(</span><span class="s3">&quot;Starte Cloud-Deployment.&quot;</span><span class="s1">);</span>
+<a name="l60"><span class="ln">60   </span></a>        <span class="s0">if </span><span class="s1">(cloudServices == </span><span class="s0">null </span><span class="s1">|| cloudServices.isEmpty()) {</span>
+<a name="l61"><span class="ln">61   </span></a>            <span class="s1">logger.warn(</span><span class="s3">&quot;Keine CloudServices registriert – nichts zu tun.&quot;</span><span class="s1">);</span>
+<a name="l62"><span class="ln">62   </span></a>        <span class="s1">} </span><span class="s0">else </span><span class="s1">{</span>
+<a name="l63"><span class="ln">63   </span></a>            <span class="s0">for </span><span class="s1">(CloudService service : cloudServices) {</span>
+<a name="l64"><span class="ln">64   </span></a>                <span class="s1">String simpleName = service.getClass().getSimpleName();</span>
+<a name="l65"><span class="ln">65   </span></a>                <span class="s0">try </span><span class="s1">{</span>
+<a name="l66"><span class="ln">66   </span></a>                    <span class="s1">logger.info(</span><span class="s3">&quot;→ Führe Dienst aus: {}&quot;</span><span class="s1">, simpleName);</span>
+<a name="l67"><span class="ln">67   </span></a>                    <span class="s1">service.execute();</span>
+<a name="l68"><span class="ln">68   </span></a>                <span class="s1">} </span><span class="s0">catch </span><span class="s1">(Exception e) {</span>
+<a name="l69"><span class="ln">69   </span></a>                    <span class="s1">logger.error(</span><span class="s3">&quot;Fehler bei der Ausführung eines Dienstes (&quot; </span><span class="s1">+ simpleName + </span><span class="s3">&quot;):&quot;</span><span class="s1">, e);</span>
+<a name="l70"><span class="ln">70   </span></a>                    <span class="s2">// Hier könnte man spezifischere Fehlerbehandlungsstrategien implementieren</span>
