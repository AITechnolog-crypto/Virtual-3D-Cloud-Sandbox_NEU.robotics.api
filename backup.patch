+function collectEnergy(){ alert('⚡ Energie-Sammlung aktiv!'); const c=parseInt(document.getElementById('energy').textContent.replace(/[^0-9]/g,'')); document.getElementById('energy').textContent=(c+150).toLocaleString('de-DE')+' kWh'; }
+function simulateThreat(){ alert('⚠️ Bedrohung simuliert!'); const c=parseInt(document.getElementById('threats').textContent)||0; document.getElementById('threats').textContent=c+1; }
